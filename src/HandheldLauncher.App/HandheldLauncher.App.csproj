<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
       <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app-icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>HandheldLauncher.App</RootNamespace>
    <AssemblyName>HandheldLauncher</AssemblyName>
    <!-- Fonte única da versão: o arquivo VERSION na raiz do repo. CI e
         release.yml também leem desse arquivo (ver -p:Version), então ele
         nunca precisa ser editado em dois lugares. Um `-p:Version=X` passado
         na linha de comando (como o CI/release fazem) ainda sobrescreve isto
         normalmente — é só o valor padrão de build local. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../VERSION').Trim())</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  
   <ItemGroup>
    <None Update="Tools\ffmpeg.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
  <None Update="Tools\HidHide_1.5.230_x64.exe">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </None>
</ItemGroup>

    <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" />
    <PackageReference Include="AnimatedImage.Avalonia" />
    <PackageReference Include="AnimatedImage.Native" />
    <!-- Fixadas em 11.2.8 (v0.16): eram "11.2.*", que podia puxar um patch
         novo do Avalonia sem aviso a qualquer restore/build, inclusive numa
         release. Pra atualizar de propósito, suba os 5 números juntos. -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- v0.24: WebView embutido da aba Rede > Syncthing. Usa o motor nativo da
         plataforma (WebView2), então não soma peso ao instalador. -->
    <PackageReference Include="Avalonia.Controls.WebView" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
    <PackageReference Include="Nefarius.Drivers.HidHide" />
    <PackageReference Include="Nefarius.Utilities.DeviceManagement" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" />
    <PackageReference Include="System.Management" />
    <!-- v0.18: Guardião de suspensão (SystemEvents.PowerModeChanged). -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Tools\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HandheldLauncher.Core\HandheldLauncher.Core.csproj" />
  </ItemGroup>

  
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Tools\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

   
</Project>