<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-target: o Windows mantém a TFM específica (net8.0-windows...),
         o Linux/macOS usa net8.0 puro. O release.yml publica linux-x64 a partir
         da TFM net8.0. -->
    <TargetFrameworks>net8.0-windows10.0.19041.0;net8.0</TargetFrameworks>
    <!-- Permite restaurar/compilar a TFM Windows a partir de Linux/macOS (CI
         build-linux e builds locais no Linux). Sem isto o SDK falha com
         NETSDK1100 "set the EnableWindowsTargeting property to true". -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- WinExe só existe no Windows (executável GUI sem console). No Linux é Exe. -->
    <OutputType Condition="'$(TargetFramework)' == 'net8.0-windows10.0.19041.0'">WinExe</OutputType>
    <OutputType Condition="'$(TargetFramework)' == 'net8.0'">Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport Condition="'$(TargetFramework)' == 'net8.0-windows10.0.19041.0'">true</BuiltInComInteropSupport>
    <ApplicationManifest Condition="'$(TargetFramework)' == 'net8.0-windows10.0.19041.0'">app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="'$(TargetFramework)' == 'net8.0-windows10.0.19041.0'">Assets\app-icon.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>HandheldLauncher.App</RootNamespace>
    <AssemblyName>HandheldLauncher</AssemblyName>
    <!-- Fonte única da versão: o arquivo VERSION na raiz do repo. CI e
         release.yml também leem desse arquivo (ver -p:Version), então ele
         nunca precisa ser editado em dois lugares. Um `-p:Version=X` passado
         na linha de comando (como o CI/release fazem) ainda sobrescreve isto
         normalmente — é só o valor padrão de build local. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../VERSION').Trim())</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  
    <!-- Ferramentas Windows (ffmpeg.exe, HidHide, PawnIO): sem a condição de TFM
        o publish linux-x64 levava ~56 MB de .exe que não servem para nada e só
        engordavam o pacote Linux. -->
   <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows10.0.19041.0'">
    <None Update="Tools\ffmpeg.exe">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows10.0.19041.0'">
  <None Update="Tools\HidHide_1.5.230_x64.exe">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </None>
</ItemGroup>

    <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" />
    <PackageReference Include="AnimatedImage.Avalonia" />
    <PackageReference Include="AnimatedImage.Native" />
    <!-- Fixadas em 11.2.8 (v0.16): eram "11.2.*", que podia puxar um patch
         novo do Avalonia sem aviso a qualquer restore/build, inclusive numa
         release. Pra atualizar de propósito, suba os 5 números juntos. -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <!-- v0.24: WebView embutido da aba Rede > Syncthing. Usa o motor nativo da
         plataforma (WebView2), então não soma peso ao instalador. -->
    <PackageReference Include="Avalonia.Controls.WebView" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Avalonia.Diagnostics" Condition="'$(Configuration)' == 'Debug'" />
    <!-- Nefarius (HidHide) é só Windows: não tem TFM net8.0 puro, por isso fica
         condicionado à TFM do Windows. No Linux o código usa NullHidHideService. -->
    <PackageReference Include="Nefarius.Drivers.HidHide" Condition="'$(TargetFramework)' == 'net8.0-windows10.0.19041.0'" />
    <PackageReference Include="Nefarius.Utilities.DeviceManagement" Condition="'$(TargetFramework)' == 'net8.0-windows10.0.19041.0'" />
    <PackageReference Include="Velopack" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" />
    <PackageReference Include="System.Management" />
    <!-- v0.18: Guardião de suspensão (SystemEvents.PowerModeChanged). -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows10.0.19041.0'">
    <Content Include="Tools\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HandheldLauncher.Core\HandheldLauncher.Core.csproj" />
  </ItemGroup>

  
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows10.0.19041.0'">
    <None Update="Tools\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

   
</Project>