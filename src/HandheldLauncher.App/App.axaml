<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HandheldLauncher.App.App"
             RequestedThemeVariant="Dark">

  <Application.Styles>
    <FluentTheme />
    <!-- "HandheldLauncher" here is the *assembly* name (csproj sets
         AssemblyName=HandheldLauncher so the exe is HandheldLauncher.exe,
         not the project/namespace name HandheldLauncher.App). -->
    <StyleInclude Source="avares://HandheldLauncher/Styles/Theme.axaml" />
  </Application.Styles>

</Application>
