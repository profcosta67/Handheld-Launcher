<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HandheldLauncher.App.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- v0.25.3: ícones "chunky" partilhados pelos layouts Clássico,
             Clean/Switch e BigScreen (o Cartoon tem os seus Path à mão). -->
        <ResourceInclude Source="avares://HandheldLauncher/Styles/ChunkyIcons.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://HandheldLauncher/Styles/Theme.axaml" />
    <!-- v0.25.2: identidade do layout Cartoon (só ativa na janela com a classe
         "toon" — ver MainWindow.ApplyLayoutTheme). -->
    <StyleInclude Source="avares://HandheldLauncher/Styles/CartoonTheme.axaml" />
  </Application.Styles>

</Application>