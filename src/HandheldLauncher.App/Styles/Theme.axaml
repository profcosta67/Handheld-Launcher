<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ResourceDictionary>

      <!-- Palette — a neutral violet accent, deliberately not ROG red or
           Legion blue, since this launcher runs on both. Swap freely. -->
      <Color x:Key="BackgroundColor">#0C0D12</Color>
      <Color x:Key="SurfaceColor">#181A22</Color>
      <Color x:Key="SurfaceRaisedColor">#222531</Color>
      <Color x:Key="AccentColor">#7C5CFC</Color>
      <Color x:Key="AccentSoftColor">#5A41C4</Color>
      <Color x:Key="TextPrimaryColor">#F5F5F7</Color>
      <Color x:Key="TextSecondaryColor">#9A9CAB</Color>

      <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
      <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />

      <!-- Rounded-corner tokens — the look the reference screenshot is built on. -->
      <CornerRadius x:Key="HeroCornerRadius">24</CornerRadius>
      <CornerRadius x:Key="TileCornerRadius">16</CornerRadius>
      <CornerRadius x:Key="PillCornerRadius">999</CornerRadius>
      <CornerRadius x:Key="BarCornerRadius">18</CornerRadius>

    </ResourceDictionary>
  </Styles.Resources>

  <!-- Fonte do projeto inteiro = Comic Sans MS, a pedido do usuário.
       FontFamily é uma propriedade ATTACHED e INHERITS=true em Avalonia
       (definida em TextElement, reaproveitada por TextBlock/Button/etc via
       AddOwner — confirmado lendo o código-fonte real do Avalonia, já que
       não dá pra compilar aqui pra verificar), então um único Setter aqui
       em "Window" cobre toda a árvore visual de qualquer janela (MainWindow
       E AddGameWindow) sem precisar repetir em cada estilo de texto
       individual. "Comic Sans MS" é uma fonte do próprio Windows (vem
       instalada por padrão), não precisa ser empacotada — só funciona
       assim em Windows mesmo, que é a única plataforma que este launcher
       roda. -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="Comic Sans MS" />
  </Style>

  <!-- Row tile. Width/Height live here (not as local attributes in
       MainWindow.axaml) specifically so the .lastPlayed variant below can
       override them — a locally-set Width/Height on the element would win
       over any style setter and the landscape tile would never resize. -->
  <Style Selector="Border.gameTile">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource TileCornerRadius}" />
    <Setter Property="ClipToBounds" Value="True" />
    <!-- 170/230 até a leva anterior; aumentado um pouco a pedido do
         usuário ("pode aumentar um pouco mais o tamanho das capas em
         geral"), mesma proporção de antes. -->
    <Setter Property="Width" Value="190" />
    <Setter Property="Height" Value="255" />
    <!-- "Efeito quando passar pro lado entre os jogos" (pedido do
         usuário): um leve "zoom" na tile que ganha foco, animado em vez de
         trocar na hora — RenderTransform não é medido no layout, então um
         escala pequena (1.04) não empurra as tiles vizinhas, só cresce por
         cima. Transitions reage a QUALQUER troca de valor da propriedade
         (inclusive a troca de Setter pela classe .focused abaixo), que é a
         API documentada do Avalonia pra isso — não dá pra compilar aqui
         pra confirmar. -->
    <Setter Property="RenderTransform" Value="scale(1.0)" />
    <Style.Transitions>
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" Easing="CubicEaseOut" />
      </Transitions>
    </Style.Transitions>
  </Style>

  <Style Selector="Border.gameTile.focused">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="RenderTransform" Value="scale(1.04)" />
  </Style>

  <!-- WIDE CAPSULE ("último jogo aberto") — mesma arte de capa/grid da
       CAPSULE normal, só renderizada bem mais larga (nunca a arte hero,
       ver GameTileViewModel.TileImagePath). Height bate com a tile normal
       pra fileira continuar alinhada; só Width cresce. 460 até a leva
       anterior, aumentado junto com a CAPSULE normal. -->
  <Style Selector="Border.gameTile.lastPlayed">
    <Setter Property="Width" Value="510" />
    <Setter Property="Height" Value="255" />
  </Style>

  <!-- Context menu (Start button) — dim backdrop + a centered card listing
       actions for whichever tile was focused when it opened. -->
  <Style Selector="Border.contextMenuOverlay">
    <Setter Property="Background" Value="#CC000000" />
  </Style>

  <Style Selector="Border.contextMenuCard">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource BarCornerRadius}" />
  </Style>

  <Style Selector="Border.menuItem">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.menuItem.selected">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
  </Style>

  <!-- Cover/banner picker grid cells. Unlike Border.gameTile above, Width/
       Height are NOT set here — the XAML sets them locally per-cell, which
       is fine for this style (no size-varying class like .lastPlayed needs
       to override it). -->
  <Style Selector="Border.coverCandidate">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Border.coverCandidate.selected">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- Plain dark TextBox so the "Adicionar jogo" form doesn't show up as a
       jarring white box over the rest of the dark UI. -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Border.heroCard, Border.heroBanner">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource HeroCornerRadius}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.topBar, Border.bottomBar">
    <Setter Property="Background" Value="#CC12141C" />
    <Setter Property="CornerRadius" Value="{StaticResource BarCornerRadius}" />
  </Style>

  <Style Selector="TextBlock.gameTitle">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.heroTitle">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="30" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBlock.subtle">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="14" />
  </Style>

  <!-- Nome em cima das tiles pequenas da fileira (ver MainWindow.axaml) —
       fonte pequena a pedido do usuário, sempre visível (diferente de
       TextBlock.gameTitle, que só aparece como placeholder quando não tem
       nenhuma arte ainda). -->
  <Style Selector="TextBlock.tileCaption">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.pill">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.pill:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
  </Style>

  <!-- Abas de filtro (Todos/Favoritos/Steam/Não Steam/Xbox) — mesmo
       Button.pill por baixo, só troca de cor quando é a aba ativa. -->
  <Style Selector="Button.filterTab.active">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
  </Style>

  <Style Selector="Button.filterTab.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
  </Style>

</Styles>
