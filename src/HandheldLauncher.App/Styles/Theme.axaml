<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ResourceDictionary>
      <!-- Cores base (o ThemeManager sobrescreve essas) -->
      <Color x:Key="BackgroundColor">#0C0D12</Color>
      <Color x:Key="SurfaceColor">#181A22</Color>
      <Color x:Key="SurfaceRaisedColor">#222531</Color>
      <Color x:Key="AccentColor">#7C5CFC</Color>
      <Color x:Key="AccentSoftColor">#5A41C4</Color>
      <Color x:Key="TextPrimaryColor">#F5F5F7</Color>
      <Color x:Key="TextSecondaryColor">#9A9CAB</Color>

      <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
      <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
      <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="{StaticResource SurfaceRaisedColor}" />
      <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
      <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
      <SolidColorBrush x:Key="BarBrush" Color="#CC12141C" />
      <SolidColorBrush x:Key="AccentTranslucentBrush" Color="#407C5CFC" />
      <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BackdropDimBrush" Color="#CC0C0D12" />
      <SolidColorBrush x:Key="ArtBackdropDimBrush" Color="#CC0C0D12" />

      <!-- Central de Controle / Quick Settings (Windows 11 Fluent).
           Nomes pedidos pelo design (CardBackground/ButtonBackground/Border):
           são brushes derivados da paleta, por isso acompanham o tema ativo
           em vez de ficarem presos a um cinza fixo. -->
      <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource SurfaceColor}" />
      <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="{StaticResource SurfaceRaisedColor}" />
      <SolidColorBrush x:Key="BorderLineBrush" Color="#333333" />
      <SolidColorBrush x:Key="TileSeparatorBrush" Color="#26FFFFFF" />
      <SolidColorBrush x:Key="TileHoverBrush" Color="#26FFFFFF" />
      <!-- Véu dos painéis flutuantes (Quick Settings): 70% opaco / 30%
           translúcido sobre a COR DO TEMA (o ThemeManager re-tinta ao trocar). -->
      <SolidColorBrush x:Key="PanelTranslucentBrush" Color="#B30C0D12" />

      <!-- v0.25.2: véus do layout Cartoon (fundo da página e do ecrã de
           lançamento). O ThemeManager re-tinta com a cor de fundo da paleta,
           por isso acompanham o Cartoon escuro e o Cartoon claro. -->
      <SolidColorBrush x:Key="ToonVeilBrush" Color="#B31A0B2E" />
      <SolidColorBrush x:Key="ToonVeilStrongBrush" Color="#E61A0B2E" />

      <FontFamily x:Key="GlobalFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>

      <x:Double x:Key="FontSizeBase">14</x:Double>
      <x:Double x:Key="FontSizeBody">15</x:Double>
      <x:Double x:Key="FontSizeTitle">30</x:Double>
      <x:Double x:Key="FontSizeSubtle">14</x:Double>
      <x:Double x:Key="FontSizeCaption">11</x:Double>
      <x:Double x:Key="FontSizeMenuHeader">22</x:Double>

      <CornerRadius x:Key="HeroCornerRadius">24</CornerRadius>
      <CornerRadius x:Key="TileCornerRadius">16</CornerRadius>
      <CornerRadius x:Key="PillCornerRadius">999</CornerRadius>
      <CornerRadius x:Key="BarCornerRadius">18</CornerRadius>
      <!-- v0.26: escala única de cantos (antes havia 16 valores soltos nas telas).
           XSmall = selos e itens de lista · Small = campos e botões pequenos ·
           Medium = botões e itens de menu · Large = cartões e painéis · XLarge = popups. -->
      <CornerRadius x:Key="RadiusXSmall">6</CornerRadius>
      <CornerRadius x:Key="RadiusSmall">8</CornerRadius>
      <CornerRadius x:Key="RadiusMedium">12</CornerRadius>
      <CornerRadius x:Key="RadiusLarge">18</CornerRadius>
      <CornerRadius x:Key="RadiusXLarge">22</CornerRadius>

      <x:Double x:Key="TypeScale1">11</x:Double>
      <x:Double x:Key="TypeScale2">12</x:Double>
      <x:Double x:Key="TypeScale3">14</x:Double>
      <x:Double x:Key="TypeScale4">16</x:Double>
      <x:Double x:Key="TypeScale5">18</x:Double>
      <x:Double x:Key="TypeScale6">22</x:Double>
      <x:Double x:Key="TypeScale7">30</x:Double>
      <x:Double x:Key="TypeScale8">36</x:Double>

      <CornerRadius x:Key="RadiusScale1">4</CornerRadius>
      <CornerRadius x:Key="RadiusScale2">8</CornerRadius>
      <CornerRadius x:Key="RadiusScale3">12</CornerRadius>
      <CornerRadius x:Key="RadiusScale4">16</CornerRadius>
      <CornerRadius x:Key="RadiusScale5">24</CornerRadius>
    </ResourceDictionary>
  </Styles.Resources>

  <!-- Linux: sem blur de fundo, a janela principal usa o fundo sólido do tema. -->
  <Style Selector="Window.linuxSolid">
    <Setter Property="Background" Value="{DynamicResource BackgroundBrush}"/>
  </Style>

  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource GlobalFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBase}" />
  </Style>

  <!-- 🟢 INÍCIO DOS ESTILOS CARTOON (Bordas Grossas) -->
  <Style Selector=".cartoon Button.pill, .cartoon Button.filterTab, .cartoon Button.switchAction">
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="BorderBrush" Value="Black" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>
  
  <Style Selector=".cartoon Border.gameTile">
    <Setter Property="BorderThickness" Value="4" />
    <Setter Property="BorderBrush" Value="Black" />
    <Setter Property="BoxShadow" Value="4 4 0 0 Black" />
  </Style>

  <Style Selector=".cartoon Border.contextMenuCard, .cartoon Border.menuHeader">
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="BorderBrush" Value="Black" />
  </Style>

  <Style Selector=".cartoon TextBox">
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="BorderBrush" Value="Black" />
  </Style>
  <!-- 🟢 FIM DOS ESTILOS CARTOON -->

  <!-- Row tile -->
  <Style Selector="Border.gameTile">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource TileCornerRadius}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Width" Value="220" />
    <Setter Property="Height" Value="290" />
    <Setter Property="RenderTransform" Value="scale(1.0)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.gameTile.focused">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="RenderTransform" Value="scale(1.08)" />
  </Style>

  <Style Selector="Border.gameTile.lastPlayed">
    <Setter Property="Width" Value="580" />
    <Setter Property="Height" Value="290" />
  </Style>

  <Style Selector="Border.contextMenuOverlay">
    <Setter Property="Background" Value="#CC000000" />
  </Style>

  <Style Selector="Border.contextMenuCard">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource BarCornerRadius}" />
  </Style>

  <Style Selector="Border.menuItem">
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.menuItem.selected">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
  </Style>

  <Style Selector="Border.menuItem.danger TextBlock.gameTitle">
    <Setter Property="Foreground" Value="#FF5C5C" />
  </Style>
  <Style Selector="Border.menuItem.danger PathIcon">
    <Setter Property="Foreground" Value="#FF5C5C" />
  </Style>
  <Style Selector="Border.menuItem.danger.selected">
    <Setter Property="Background" Value="#332E2E" />
    <Setter Property="BorderBrush" Value="#FF5C5C" />
    <Setter Property="BorderThickness" Value="1.5" />
  </Style>

  <!-- v0.26: título do menu sem a caixa colorida (menos "caixa dentro de caixa"). -->
  <Style Selector="Border.menuHeader">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
    <Setter Property="Padding" Value="16,4" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="TextBlock.menuHeaderTitle">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeMenuHeader}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.coverCandidate">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="BorderThickness" Value="3" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Border.coverCandidate.selected">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>

  <Style Selector="TextBox">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Border.heroCard, Border.heroBanner">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource HeroCornerRadius}" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="Border.topBar, Border.bottomBar">
    <Setter Property="Background" Value="{StaticResource BarBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource BarCornerRadius}" />
  </Style>

  <Style Selector="TextBlock.gameTitle">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.heroTitle">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeTitle}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBlock.subtle">
    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeSubtle}" />
  </Style>

  <Style Selector="TextBlock.tileCaption">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.pill">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource PillCornerRadius}" />
    <Setter Property="Padding" Value="16,8" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.pill:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
  </Style>

  <Style Selector="Button.filterTab.active">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
  </Style>

  <Style Selector="Button.filterTab.active /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
  </Style>

  <Style Selector="Button.subFilter">
    <Setter Property="Padding" Value="12,5" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style Selector="Button.subFilter.cursor">
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.subFilter.cursor /template/ ContentPresenter">
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.pill.primary">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
  </Style>

  <Style Selector="Button.pill.primary /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
  </Style>

  <Style Selector="Button.iconGhost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.iconGhost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
  </Style>

  <Style Selector="Button.switchAction">
    <Setter Property="Background" Value="{StaticResource SurfaceRaisedBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource TileCornerRadius}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Width" Value="40" />
    <Setter Property="Height" Value="40" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FocusAdorner">
      <Template>
        <Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="13" Margin="1" />
      </Template>
    </Setter>
  </Style>

  <Style Selector="Button.switchAction:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
  </Style>

  <Style Selector="Border.gameTile:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.05)" />
  </Style>
  <Style Selector="Border.gameTile.focused:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.08)" />
  </Style>

  <Style Selector="Window:not(.noAnim) Panel.fadeIn[IsVisible=True]">
    <Style.Animations>
      <Animation Duration="0:0:0.18" Easing="CubicEaseOut">
        <KeyFrame Cue="0%">
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <Style Selector="Window.noAnim Border.gameTile">
    <Setter Property="Transitions">
      <Transitions />
    </Setter>
    <Setter Property="RenderTransform" Value="scale(1.0)" />
  </Style>
  <Style Selector="Window.noAnim Border.gameTile.focused">
    <Setter Property="RenderTransform" Value="scale(1.0)" />
  </Style>
  <Style Selector="Window.noAnim Border.gameTile:pointerover">
    <Setter Property="RenderTransform" Value="scale(1.0)" />
  </Style>

  <!-- =====================================================================
       Quick Settings (Central de Controle) — Windows 11 Fluent.
       Cartões com canto arredondado e sombra difusa; tiles de duas metades
       (esquerda liga/desliga, direita abre detalhes) com gradiente no
       estado LIGADO. Os gradientes semânticos (Wi-Fi ciano, Bluetooth azul,
       Luz Noturna âmbar) são fixos de propósito — servem de código de cor —
       e o gradiente genérico (.on sem variante) segue o AccentColor do tema.
       ===================================================================== -->

  <Style Selector="Border.qsCard">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
    <Setter Property="Padding" Value="14,12" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource TileSeparatorBrush}" />
  </Style>

  <Style Selector="TextBlock.qsSectionTitle">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Margin" Value="4,6,0,2" />
  </Style>

  <!-- Item de navegação das Configurações (mesmo padrão do tile: fundo
       arredondado, sombra suave, metade esquerda clicável + seta à direita). -->
  <Style Selector="Button.settingsTab">
    <Setter Property="Background" Value="{StaticResource ButtonBackgroundBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
    <Setter Property="Padding" Value="14,11" />
    <Setter Property="BorderBrush" Value="{StaticResource TileSeparatorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Button.settingsTab:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource TileHoverBrush}" />
  </Style>

  <Style Selector="Button.settingsTab.active /template/ ContentPresenter">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
  </Style>

  <Style Selector="Button.settingsTab.active">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
        <GradientStop Color="{StaticResource AccentSoftColor}" Offset="1" />
      </LinearGradientBrush>
    </Setter>
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Caixa do tile: é ela que recebe o gradiente (as duas metades ficam
       transparentes por cima, por isso o canto arredondado nunca é cortado). -->
  <Style Selector="Border.qsTile">
    <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource TileSeparatorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Margin" Value="5" />
  </Style>

  <!-- Metade esquerda (toggle) -->
  <Style Selector="Button.qsTileMain">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="MinHeight" Value="56" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="Button.qsTileMain:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource TileHoverBrush}" />
  </Style>

  <!-- Metade direita (seta → detalhes) -->
  <Style Selector="Button.qsTileArrow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    <Setter Property="Width" Value="42" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="Button.qsTileArrow:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{StaticResource TileHoverBrush}" />
  </Style>

  <!-- v0.26: sem o risco entre o botão e a seta (menos "caixa dentro de caixa"). -->
  <Style Selector="Border.qsTileDivider">
    <Setter Property="IsVisible" Value="False" />
    <Setter Property="Width" Value="1" />
    <Setter Property="Background" Value="{StaticResource TileSeparatorBrush}" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,10" />
  </Style>

  <!-- Destaque do cursor de navegação (controle/teclado) -->
  <Style Selector="Button.qsTileMain.focused">
    <Setter Property="BorderThickness" Value="2" />
    <Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
  </Style>

  <!-- Slider minimalista -->
  <Style Selector="Slider.qsSlider">
    <Setter Property="MinHeight" Value="22" />
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
  </Style>

  <!-- Contraste dos tiles: no estado DESLIGADO o texto segue o tema; no
       estado LIGADO o fundo passa a ser o gradiente de destaque, por isso o
       texto vai para o "on accent" (branco no escuro, e calculado pelo
       ThemeManager no tema Claro). Sem isto, texto escuro sobre o gradiente
       ficava ilegível no tema claro. -->
  <Style Selector="Border.qsTile TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Border.qsTile.on TextBlock">
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
  </Style>

  <!-- Estado LIGADO — gradiente genérico (AccentColor → AccentSoftColor) -->
  <Style Selector="Border.qsTile.on">
    <Setter Property="Background">
      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
        <GradientStop Color="{StaticResource AccentSoftColor}" Offset="1" />
      </LinearGradientBrush>
    </Setter>
  </Style>

  <!-- Variantes de cor por serviço: removidas de propósito. O dono pediu que a
       cor predominante seja a escolhida nas Configurações (vermelho, azul,
       verde...), por isso TODOS os tiles ativos usam o gradiente AccentColor →
       AccentSoftColor de cima. As classes semânticas (wifi, bluetooth, ...)
       continuam no XAML só como marcadores, sem estilo próprio. -->

</Styles>