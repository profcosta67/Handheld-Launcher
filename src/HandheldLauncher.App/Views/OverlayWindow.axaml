<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HandheldLauncher.App.Views.OverlayWindow"
        Title="Quick Settings"
        Width="440" Height="850"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        CanResize="False">

    <Window.Styles>
        <Style Selector="Button#BtnClose">
            <Setter Property="Background" Value="#33FFFFFF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button#BtnClose:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#55FFFFFF"/>
            <Setter Property="CornerRadius" Value="20"/>
        </Style>
    </Window.Styles>

    <Border Background="#E6121212" 
            CornerRadius="24,0,0,24" 
            BorderBrush="#333333" 
            BorderThickness="1,0,0,0"
            HorizontalAlignment="Right"
            Padding="20">
        <Grid RowDefinitions="Auto,*,Auto">
            
            <!-- Cabeçalho -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,15">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="⚙️ Quick Settings" Foreground="White" FontSize="22" FontWeight="Bold" />
                    <TextBlock x:Name="TxtScreenInfo" Text="Carregando..." Foreground="Gray" FontSize="12" />
                </StackPanel>
                <Button x:Name="BtnClose" Grid.Column="1" Content="✕" Width="40" Height="40" CornerRadius="20" Background="#33FFFFFF" Foreground="White" Click="OnCloseClick" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="16" FontWeight="Bold" />
            </Grid>

            <!-- Scroll Principal (Oculto e com largura fixa no conteúdo) -->
            <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                
                <!-- 🟢 AQUI ESTÁ A CORREÇÃO: Width fixo de 380 impede o alargamento/encolhimento -->
                <StackPanel Spacing="10" Width="380" HorizontalAlignment="Center">
                    
                    <!-- Seção: Resolução -->
                    <Border x:Name="ResolutionSection" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Padding="10" Background="#1AFFFFFF">
                        <StackPanel Spacing="6">
                            <TextBlock Text="🖥️ Resolução" Foreground="#7C5CFC" FontWeight="Bold" FontSize="14" />
                            <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,4">
                                <Button x:Name="BtnRes720" Grid.Column="0" Tag="1280x720" Content="720p" Click="OnResolutionClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="6" Margin="0,0,4,0" FontSize="12"/>
                                <Button x:Name="BtnRes900" Grid.Column="1" Tag="1600x900" Content="900p" Click="OnResolutionClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="6" Margin="2,0" FontSize="12"/>
                                <Button x:Name="BtnRes1080" Grid.Column="2" Tag="1920x1080" Content="1080p" Click="OnResolutionClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="6" Margin="4,0,0,0" FontSize="12"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,*,*">
                                <Button x:Name="BtnRes1200" Grid.Column="0" Tag="1920x1200" Content="1200p" Click="OnResolutionClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="6" Margin="0,0,4,0" FontSize="12"/>
                                <Button x:Name="BtnRes2K" Grid.Column="1" Tag="2560x1440" Content="2K" Click="OnResolutionClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="6" Margin="2,0" FontSize="12"/>
                                <Button x:Name="BtnResGo" Grid.Column="2" Tag="2560x1600" Content="2560" Click="OnResolutionClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="6" Margin="4,0,0,0" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Seção: Taxa de Atualização -->
                    <Border x:Name="RefreshSection" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Padding="10" Background="#1AFFFFFF">
                        <StackPanel Spacing="6">
                            <TextBlock Text="🔄 Taxa (Hz)" Foreground="#7C5CFC" FontWeight="Bold" FontSize="14" />
                            <Grid ColumnDefinitions="*,*,*,*">
                                <Button x:Name="BtnHz60" Grid.Column="0" Tag="60" Content="60" Click="OnRefreshClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="6" Margin="0,0,4,0" FontSize="12"/>
                                <Button x:Name="BtnHz120" Grid.Column="1" Tag="120" Content="120" Click="OnRefreshClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="6" Margin="2,0" FontSize="12"/>
                                <Button x:Name="BtnHz144" Grid.Column="2" Tag="144" Content="144" Click="OnRefreshClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="6" Margin="2,0" FontSize="12"/>
                                <Button x:Name="BtnHz240" Grid.Column="3" Tag="240" Content="240" Click="OnRefreshClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="6" Margin="4,0,0,0" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Seção: TDP -->
                    <Border x:Name="TdpSection" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Padding="10" Background="#1AFFFFFF">
                        <StackPanel Spacing="8">
                            <TextBlock Text="⚡ Desempenho (TDP)" Foreground="#7C5CFC" FontWeight="Bold" FontSize="14" />
                            <Grid RowDefinitions="Auto,Auto">
                                <Grid Grid.Row="0" ColumnDefinitions="*,*,*" Margin="0,0,0,6">
                                    <Button x:Name="BtnUltraEco" Grid.Column="0" Tag="UltraEco" ToolTip.Tip="UltraEco • 8 W" Click="OnTdpClick" Background="#252A36" Foreground="White" CornerRadius="8" Margin="0,0,4,0" Padding="4" Height="46" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                        <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="🪫" FontSize="16" HorizontalAlignment="Center"/>
                                            <TextBlock Text="U.Eco" FontSize="10" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnEco" Grid.Column="1" Tag="Eco" ToolTip.Tip="Eco • 15 W" Click="OnTdpClick" Background="#252A36" Foreground="White" CornerRadius="8" Margin="2,0" Padding="4" Height="46" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                        <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="🍃" FontSize="16" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Eco" FontSize="10" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnNormal" Grid.Column="2" Tag="Normal" ToolTip.Tip="Normal • 20 W" Click="OnTdpClick" Background="#252A36" Foreground="White" CornerRadius="8" Margin="4,0,0,0" Padding="4" Height="46" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                        <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="🎯" FontSize="16" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Normal" FontSize="10" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <Grid Grid.Row="1" ColumnDefinitions="*,*" Margin="40,0">
                                    <Button x:Name="BtnDesempenho" Grid.Column="0" Tag="Desempenho" ToolTip.Tip="Desempenho • 25 W" Click="OnTdpClick" Background="#252A36" Foreground="White" CornerRadius="8" Margin="0,0,4,0" Padding="4" Height="46" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                        <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="🚀" FontSize="16" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Desemp." FontSize="10" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnBoost" Grid.Column="1" Tag="Boost" ToolTip.Tip="Boost • 30 W" Click="OnTdpClick" Background="#252A36" Foreground="White" CornerRadius="8" Margin="4,0,0,0" Padding="4" Height="46" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                        <StackPanel Orientation="Vertical" Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="🔥" FontSize="16" HorizontalAlignment="Center"/>
                                            <TextBlock Text="Boost" FontSize="10" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Seção: Curva das ventoinhas -->
                    <Border x:Name="FanSection" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Padding="10" Background="#1AFFFFFF">
                        <StackPanel Spacing="8">
                            <TextBlock Text="❄️ Refrigeração (ventoinhas)" Foreground="#7C5CFC" FontWeight="Bold" FontSize="14" />
                            
                            <UniformGrid Columns="5" Margin="0,4">
                                <Button x:Name="BtnFanAuto" Tag="Automático" Click="OnFanClick" Background="#252A36" Foreground="White" CornerRadius="8" Margin="2" Padding="2" Height="60" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🤖" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Auto" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnFanSilent" Tag="Silencioso" Click="OnFanClick" Background="#252A36" Foreground="White" CornerRadius="8" Margin="2" Padding="2" Height="60" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="✣" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Silenc" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnFanNormal" Tag="Normal" Click="OnFanClick" Background="#252A36" Foreground="White" CornerRadius="8" Margin="2" Padding="2" Height="60" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="✣" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Normal" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnFanPerformance" Tag="Desempenho" Click="OnFanClick" Background="#252A36" Foreground="White" CornerRadius="8" Margin="2" Padding="2" Height="60" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="✣" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Desemp" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnFanBoost" Tag="Boost" Click="OnFanClick" Background="#252A36" Foreground="White" CornerRadius="8" Margin="2" Padding="2" Height="60" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                    <StackPanel Spacing="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="✣" FontSize="18" HorizontalAlignment="Center"/>
                                        <TextBlock Text="Boost" FontSize="9" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                            
                            <!-- 🟢 AQUI: Height fixo de 36px impede que o texto mude o layout -->
                            <TextBlock x:Name="TxtFanStatus" Text="Lendo tabela original..." Foreground="White" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" Height="36" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Seção: Cor -->
                    <Border x:Name="ColorSection" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Padding="10" Background="#1AFFFFFF">
                        <StackPanel Spacing="6">
                            <TextBlock Text="🎨 Modo de Cor" Foreground="#7C5CFC" FontWeight="Bold" FontSize="14" />
                            <Grid ColumnDefinitions="*,*,*,*">
                                <Button x:Name="BtnColorDefault" Grid.Column="0" Tag="0" Content="Padrão" Click="OnColorClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="5" Margin="0,0,4,0" FontSize="11"/>
                                <Button x:Name="BtnColorVivid" Grid.Column="1" Tag="1" Content="Vívido" Click="OnColorClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="5" Margin="2,0" FontSize="11"/>
                                <Button x:Name="BtnColorOled" Grid.Column="2" Tag="2" Content="OLED" Click="OnColorClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="5" Margin="2,0" FontSize="11"/>
                                <Button x:Name="BtnColorNight" Grid.Column="3" Tag="3" Content="Noturno" Click="OnColorClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="5" Margin="4,0,0,0" FontSize="11"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Seção: HUD -->
                    <Border x:Name="HudSection" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Padding="10" Background="#1AFFFFFF">
                        <StackPanel Spacing="6">
                            <TextBlock Text="📊 HUD de Desempenho" Foreground="#7C5CFC" FontWeight="Bold" FontSize="14" />
                            <Grid ColumnDefinitions="*,*,*,*">
                                <Button x:Name="BtnHudOff" Grid.Column="0" Tag="0" Content="Off" Click="OnHudClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="8" Margin="0,0,4,0" FontSize="12"/>
                                <Button x:Name="BtnHudMin" Grid.Column="1" Tag="1" Content="Min" Click="OnHudClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="8" Margin="2,0" FontSize="12"/>
                                <Button x:Name="BtnHudMed" Grid.Column="2" Tag="2" Content="Méd" Click="OnHudClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="8" Margin="2,0" FontSize="12"/>
                                <Button x:Name="BtnHudFull" Grid.Column="3" Tag="3" Content="Full" Click="OnHudClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="8" Margin="4,0,0,0" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Seção: Volume -->
                    <Border x:Name="VolumeSection" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Padding="10" Background="#1AFFFFFF">
                        <StackPanel Spacing="4">
                            <TextBlock Text="🔊 Volume" Foreground="#7C5CFC" FontWeight="Bold" FontSize="14" />
                            <Slider x:Name="VolumeSlider" ValueChanged="OnVolumeChanged" Minimum="0" Maximum="100" />
                        </StackPanel>
                    </Border>

                    <!-- Seção: Brilho -->
                    <Border x:Name="BrightnessSection" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Padding="10" Background="#1AFFFFFF">
                        <StackPanel Spacing="4">
                            <TextBlock Text="☀️ Brilho" Foreground="#7C5CFC" FontWeight="Bold" FontSize="14" />
                            <Slider x:Name="BrightnessSlider" ValueChanged="OnBrightnessChanged" Minimum="0" Maximum="100" />
                        </StackPanel>
                    </Border>

                    <!-- Seção: Captura -->
                    <Border x:Name="CaptureSection" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Padding="10" Background="#1AFFFFFF">
                        <StackPanel Spacing="8">
                            <TextBlock Text="📸 Captura" Foreground="#7C5CFC" FontWeight="Bold" FontSize="14" />
                            <Grid ColumnDefinitions="*,*">
                                <Button x:Name="BtnScreenshot" Grid.Column="0" Click="OnScreenshotClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="8" Margin="0,0,4,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="📷" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="Print" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnRecord" Grid.Column="1" Click="OnRecordClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="8" Margin="4,0,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="🎥" FontSize="14" VerticalAlignment="Center"/>
                                        <TextBlock Text="Gravar" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Rodapé Fixo -->
            <Button Grid.Row="2" Content="Fechar Menu" Click="OnCloseClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,15,0,0" Background="#7C5CFC" Foreground="White" CornerRadius="12" Padding="12" FontWeight="Bold" />
        </Grid>
    </Border>
</Window>