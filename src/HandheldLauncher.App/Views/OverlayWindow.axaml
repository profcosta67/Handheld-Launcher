<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HandheldLauncher.App.Views.OverlayWindow"
        Title="Quick Settings"
        Width="380" Height="700"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        CanResize="False">

    <Border Background="#CC121212" 
            CornerRadius="24,0,0,24" 
            BorderBrush="#333333" 
            BorderThickness="1,0,0,0"
            HorizontalAlignment="Right"
            Padding="20">
        <Grid RowDefinitions="Auto,*,Auto">
            
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Quick Settings" Foreground="White" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Controle Rápido" Foreground="Gray" FontSize="12" />
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="40" Height="40" CornerRadius="20" Background="#33FFFFFF" Foreground="White" Click="OnCloseClick" />
            </Grid>

            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="20">
                    <StackPanel Spacing="8">
                        <TextBlock Text="⚡ Desempenho (TDP)" Foreground="#7C5CFC" FontWeight="Bold" FontSize="14" />
                        <Grid ColumnDefinitions="*,*,*">
                            <Button x:Name="BtnEco" Grid.Column="0" Content="Eco" Click="OnTdpClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="10" Margin="0,0,4,0" />
                            <Button x:Name="BtnEquilibrado" Grid.Column="1" Content="Equilibrado" Click="OnTdpClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="10" Margin="4,0,4,0" />
                            <Button x:Name="BtnTurbo" Grid.Column="2" Content="Turbo" Click="OnTdpClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="10" Margin="4,0,0,0" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="🎨 Modo de Cor" Foreground="#7C5CFC" FontWeight="Bold" FontSize="14" />
                        <ComboBox x:Name="ColorModeCombo" SelectionChanged="OnColorModeChanged" HorizontalAlignment="Stretch" Background="#252A36">
                            <ComboBoxItem>Padrão</ComboBoxItem>
                            <ComboBoxItem>Vívido</ComboBoxItem>
                            <ComboBoxItem>OLED (Alto Contraste)</ComboBoxItem>
                            <ComboBoxItem>Noturno (Luz Quente)</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="🎮 HUD de Desempenho" Foreground="#7C5CFC" FontWeight="Bold" FontSize="14" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="Mostrar FPS (RTSS)" Foreground="White" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="HudToggle" IsCheckedChanged="OnHudToggled" Grid.Column="1" IsChecked="True" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="12">
                        <TextBlock Text="🔊 Sistema" Foreground="#7C5CFC" FontWeight="Bold" FontSize="14" />
                        <StackPanel Spacing="4">
                            <TextBlock Text="Volume" Foreground="White" FontSize="12" />
                            <Slider x:Name="VolumeSlider" ValueChanged="OnVolumeChanged" Minimum="0" Maximum="100" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Brilho" Foreground="White" FontSize="12" />
                            <Slider x:Name="BrightnessSlider" ValueChanged="OnBrightnessChanged" Minimum="0" Maximum="100" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2" Content="Fechar Menu" Click="OnCloseClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,20,0,0" Background="#252A36" Foreground="White" CornerRadius="8" Padding="12" />
        </Grid>
    </Border>
</Window>