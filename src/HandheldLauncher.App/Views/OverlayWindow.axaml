<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HandheldLauncher.App.Views.OverlayWindow"
        Title="Quick Settings"
        Width="380" Height="700"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        CanResize="False">

    <Border Background="#CC121212" 
            CornerRadius="24,0,0,24" 
            BorderBrush="#333333" 
            BorderThickness="1,0,0,0"
            HorizontalAlignment="Right"
            Padding="20">
        <Grid RowDefinitions="Auto,*,Auto">
            
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Quick Settings" Foreground="White" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Controle Rápido" Foreground="Gray" FontSize="12" />
                </StackPanel>
                <Button Grid.Column="1" 
                        Content="✕" 
                        Width="40" Height="40" 
                        CornerRadius="20" 
                        Background="#33FFFFFF" 
                        Foreground="White" 
                        Click="OnCloseClick" 
                        Padding="0" 
                        HorizontalContentAlignment="Center" 
                        VerticalContentAlignment="Center"
                        FontSize="16" 
                        FontWeight="Bold" />
            </Grid>

            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="20">
                    
                    <!-- TDP -->
                    <Border x:Name="TdpSection" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" Padding="4">
                        <StackPanel Spacing="8">
                            <TextBlock Text="⚡ Desempenho (TDP)" Foreground="#7C5CFC" FontWeight="Bold" FontSize="14" />
                            <Grid ColumnDefinitions="*,*,*,*">
                                <Button x:Name="BtnEco" Grid.Column="0" Content="Eco" Click="OnTdpClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="5" Margin="0,0,2,0" FontSize="11" />
                                <Button x:Name="BtnNormal" Grid.Column="1" Content="Norm" Click="OnTdpClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="5" Margin="2,0,2,0" FontSize="11" />
                                <Button x:Name="BtnDesempenho" Grid.Column="2" Content="Desemp" Click="OnTdpClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="5" Margin="2,0,2,0" FontSize="10" />
                                <Button x:Name="BtnBoost" Grid.Column="3" Content="Boost" Click="OnTdpClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="5" Margin="2,0,0,0" FontSize="11" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Cor -->
                    <Border x:Name="ColorSection" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" Padding="4">
                        <StackPanel Spacing="8">
                            <TextBlock Text="🎨 Modo de Cor" Foreground="#7C5CFC" FontWeight="Bold" FontSize="14" />
                            <ComboBox x:Name="ColorModeCombo" SelectionChanged="OnColorModeChanged" HorizontalAlignment="Stretch" Background="#252A36">
                                <ComboBoxItem>Padrão</ComboBoxItem>
                                <ComboBoxItem>Vívido</ComboBoxItem>
                                <ComboBoxItem>OLED (Alto Contraste)</ComboBoxItem>
                                <ComboBoxItem>Noturno (Luz Quente)</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- HUD -->
                    <Border x:Name="HudSection" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" Padding="4">
                        <StackPanel Spacing="8">
                            <TextBlock Text="🎮 HUD de Desempenho" Foreground="#7C5CFC" FontWeight="Bold" FontSize="14" />
                            <Grid ColumnDefinitions="*,*,*,*">
                                <Button x:Name="BtnHudOff" Grid.Column="0" Content="Off" Click="OnHudClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="5" Margin="0,0,2,0" FontSize="11" />
                                <Button x:Name="BtnHudMin" Grid.Column="1" Content="Min" Click="OnHudClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="5" Margin="2,0,2,0" FontSize="11" />
                                <Button x:Name="BtnHudMed" Grid.Column="2" Content="Méd" Click="OnHudClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="5" Margin="2,0,2,0" FontSize="11" />
                                <Button x:Name="BtnHudFull" Grid.Column="3" Content="Full" Click="OnHudClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="5" Margin="2,0,0,0" FontSize="11" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Volume -->
                    <Border x:Name="VolumeSection" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" Padding="4">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Volume" Foreground="#7C5CFC" FontWeight="Bold" FontSize="14" />
                            <Slider x:Name="VolumeSlider" ValueChanged="OnVolumeChanged" Minimum="0" Maximum="100" />
                        </StackPanel>
                    </Border>

                    <!-- Brilho -->
                    <Border x:Name="BrightnessSection" CornerRadius="8" BorderThickness="2" BorderBrush="Transparent" Padding="4">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Brilho" Foreground="#7C5CFC" FontWeight="Bold" FontSize="14" />
                            <Slider x:Name="BrightnessSlider" ValueChanged="OnBrightnessChanged" Minimum="0" Maximum="100" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2" Content="Fechar Menu" Click="OnCloseClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,20,0,0" Background="#252A36" Foreground="White" CornerRadius="8" Padding="12" />
        </Grid>
    </Border>
</Window>