<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HandheldLauncher.App.Views.OverlayWindow"
        Title="Quick Settings"
        Width="380" Height="700"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        CanResize="False">

    <Border Background="#E6121212" 
            CornerRadius="24,0,0,24" 
            BorderBrush="#333333" 
            BorderThickness="1,0,0,0"
            HorizontalAlignment="Right"
            Padding="20">
        <Grid RowDefinitions="Auto,*,Auto">
            
            <!-- Cabeçalho -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="⚙️ Quick Settings" Foreground="White" FontSize="22" FontWeight="Bold" />
                    <TextBlock Text="Controle Rápido" Foreground="Gray" FontSize="12" />
                </StackPanel>
                <Button Grid.Column="1" 
                        Content="✕" 
                        Width="40" Height="40" 
                        CornerRadius="20" 
                        Background="#33FFFFFF" 
                        Foreground="White" 
                        Click="OnCloseClick" 
                        Padding="0" 
                        HorizontalContentAlignment="Center" 
                        VerticalContentAlignment="Center"
                        FontSize="16" 
                        FontWeight="Bold" />
            </Grid>

            <ScrollViewer Grid.Row="1">
                <StackPanel Spacing="16">
                    
                    <!-- Seção: TDP -->
                    <Border x:Name="TdpSection" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Padding="12" Background="#1AFFFFFF">
                        <StackPanel Spacing="10">
                            <TextBlock Text="⚡ Desempenho (TDP)" Foreground="#7C5CFC" FontWeight="Bold" FontSize="14" />
                            <Grid ColumnDefinitions="*,*,*,*">
                                <Button x:Name="BtnEco" Grid.Column="0" Content="🍃" ToolTip.Tip="Eco (8W)" Click="OnTdpClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="10" Margin="0,0,4,0" FontSize="18" />
                                <Button x:Name="BtnNormal" Grid.Column="1" Content="🎯" ToolTip.Tip="Normal (15W)" Click="OnTdpClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="10" Margin="4,0,4,0" FontSize="18" />
                                <Button x:Name="BtnDesempenho" Grid.Column="2" Content="🚀" ToolTip.Tip="Desempenho (25W)" Click="OnTdpClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="10" Margin="4,0,4,0" FontSize="18" />
                                <Button x:Name="BtnBoost" Grid.Column="3" Content="🔥" ToolTip.Tip="Boost (30W)" Click="OnTdpClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="10" Margin="4,0,0,0" FontSize="18" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Seção: Cor -->
                    <Border x:Name="ColorSection" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Padding="12" Background="#1AFFFFFF">
                        <StackPanel Spacing="10">
                            <TextBlock Text="🎨 Modo de Cor" Foreground="#7C5CFC" FontWeight="Bold" FontSize="14" />
                            <ComboBox x:Name="ColorModeCombo" SelectionChanged="OnColorModeChanged" HorizontalAlignment="Stretch" Background="#252A36">
                                <ComboBoxItem>Padrão</ComboBoxItem>
                                <ComboBoxItem>Vívido</ComboBoxItem>
                                <ComboBoxItem>OLED (Alto Contraste)</ComboBoxItem>
                                <ComboBoxItem>Noturno (Luz Quente)</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <!-- Seção: HUD -->
                    <Border x:Name="HudSection" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Padding="12" Background="#1AFFFFFF">
                        <StackPanel Spacing="10">
                            <TextBlock Text="📊 HUD de Desempenho" Foreground="#7C5CFC" FontWeight="Bold" FontSize="14" />
                            <Grid ColumnDefinitions="*,*,*,*">
                                <Button x:Name="BtnHudOff" Grid.Column="0" Content="🚫" ToolTip.Tip="Desligado" Click="OnHudClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="8" Margin="0,0,4,0" FontSize="16" />
                                <Button x:Name="BtnHudMin" Grid.Column="1" Content="📉" ToolTip.Tip="Resumido" Click="OnHudClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="8" Margin="4,0,4,0" FontSize="16" />
                                <Button x:Name="BtnHudMed" Grid.Column="2" Content="📈" ToolTip.Tip="Médio" Click="OnHudClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="8" Margin="4,0,4,0" FontSize="16" />
                                <Button x:Name="BtnHudFull" Grid.Column="3" Content="📊" ToolTip.Tip="Completo" Click="OnHudClick" Background="#252A36" Foreground="White" CornerRadius="8" Padding="8" Margin="4,0,0,0" FontSize="16" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Seção: Volume -->
                    <Border x:Name="VolumeSection" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Padding="12" Background="#1AFFFFFF">
                        <StackPanel Spacing="8">
                            <TextBlock Text="🔊 Volume" Foreground="#7C5CFC" FontWeight="Bold" FontSize="14" />
                            <Slider x:Name="VolumeSlider" ValueChanged="OnVolumeChanged" Minimum="0" Maximum="100" />
                        </StackPanel>
                    </Border>

                    <!-- Seção: Brilho -->
                    <Border x:Name="BrightnessSection" CornerRadius="12" BorderThickness="2" BorderBrush="Transparent" Padding="12" Background="#1AFFFFFF">
                        <StackPanel Spacing="8">
                            <TextBlock Text="☀️ Brilho" Foreground="#7C5CFC" FontWeight="Bold" FontSize="14" />
                            <Slider x:Name="BrightnessSlider" ValueChanged="OnBrightnessChanged" Minimum="0" Maximum="100" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Rodapé -->
            <Button Grid.Row="2" Content="Fechar Menu" Click="OnCloseClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,20,0,0" Background="#7C5CFC" Foreground="White" CornerRadius="12" Padding="14" FontWeight="Bold" />
        </Grid>
    </Border>
</Window>