<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HandheldLauncher.App.Views.WifiPasswordWindow"
        Title="Senha do Wi-Fi"
        Width="480" Height="300"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

  <!-- Sem isto não há como ligar a uma rede protegida que ainda não tem perfil
       salvo: o WinRT devolve InvalidCredential (ver [WIFI] no debug.log). -->
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24">
    <TextBlock Grid.Row="0" x:Name="TitleText" Text="Conectar à rede"
               FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />

    <TextBlock Grid.Row="1" x:Name="HintText" Text="Digite a senha do Wi-Fi. O teclado virtual abre junto."
               Classes="subtle" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,12" />

    <TextBox Grid.Row="2" x:Name="PasswordBox" PasswordChar="●" Watermark="Senha"
             FontSize="16" VerticalAlignment="Top" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
      <Button Classes="pill" Content="Cancelar" Click="OnCancelClick" />
      <Button Classes="pill primary" Content="Conectar" Click="OnConnectClick" IsDefault="True" />
    </StackPanel>
  </Grid>
</Window>
