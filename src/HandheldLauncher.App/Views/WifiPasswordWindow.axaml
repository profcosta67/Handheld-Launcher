<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:HandheldLauncher.App.Views"
        x:Class="HandheldLauncher.App.Views.WifiPasswordWindow"
        Title="Senha do Wi-Fi"
        Width="480" Height="580"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

  <!-- Sem isto não há como ligar a uma rede protegida que ainda não tem perfil
       salvo: o WinRT devolve InvalidCredential (ver [WIFI] no debug.log).
       v0.24.2: o teclado é o NOSSO (última linha), não o TabTip do Windows —
       o TabTip é uma janela do sistema, fora da árvore do Avalonia, e o
       controle não chegava lá. -->
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="24">
    <TextBlock Grid.Row="0" x:Name="TitleText" Text="Conectar à rede"
               FontSize="{DynamicResource TextTitle}" FontWeight="Bold" TextWrapping="Wrap" />

    <TextBlock Grid.Row="1" x:Name="HintText" Text="Digite a senha do Wi-Fi. O teclado abaixo responde ao controle: D-Pad move, A escreve, B esconde."
               Classes="subtle" FontSize="{DynamicResource TextCaption}" TextWrapping="Wrap" Margin="0,6,0,12" />

    <TextBox Grid.Row="2" x:Name="PasswordBox" PasswordChar="●" Watermark="Senha"
             FontSize="{DynamicResource TextSubtitle}" VerticalAlignment="Top" />

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0">
      <Button Classes="pill" Content="Cancelar" Click="OnCancelClick" />
      <Button Classes="pill primary" Content="Conectar" Click="OnConnectClick" IsDefault="True" />
    </StackPanel>

    <views:OnScreenKeyboardView Grid.Row="4" x:Name="Keyboard" Margin="-24,-8,-24,-24" />
  </Grid>
</Window>
