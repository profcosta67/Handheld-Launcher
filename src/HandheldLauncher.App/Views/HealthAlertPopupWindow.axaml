<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HandheldLauncher.App.Views.HealthAlertPopupWindow"
        Title="Aviso"
        Width="420" SizeToContent="Height"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        CanResize="False">

  <!--
    v0.18 — aviso da Saúde do aparelho. ShowActivated=False: aparece sem
    tirar o foco do launcher (e o MainWindow nunca mostra isto com jogo
    aberto). Fecha sozinho em ~7s ou com um toque.
  -->
  <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="{DynamicResource RadiusLarge}"
          BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" Padding="18"
          PointerPressed="OnPressed">
    <StackPanel Spacing="6">
      <TextBlock x:Name="TxtTitle" FontSize="{DynamicResource TextSubtitle}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" />
      <TextBlock x:Name="TxtMessage" FontSize="{DynamicResource TextBody}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
      <TextBlock Text="Detalhes em 🌡 Saúde do Aparelho, no menu." FontSize="{DynamicResource TextCaption}" Foreground="{DynamicResource TextSecondaryBrush}" />
    </StackPanel>
  </Border>
</Window>
