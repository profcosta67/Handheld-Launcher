<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HandheldLauncher.App.ViewModels"
        xmlns:views="using:HandheldLauncher.App.Views"
        x:Class="HandheldLauncher.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Configurações"
        Width="820" Height="860"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

  <Window.Styles>
    <Style Selector="ComboBox"><Setter Property="FocusAdorner"><Template><Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="9" Margin="1"/></Template></Setter></Style>
    <Style Selector="TextBox"><Setter Property="FocusAdorner"><Template><Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="9" Margin="1"/></Template></Setter></Style>
    <Style Selector="ToggleSwitch"><Setter Property="FocusAdorner"><Template><Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="9" Margin="1"/></Template></Setter></Style>
    <Style Selector="RadioButton"><Setter Property="FocusAdorner"><Template><Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="9" Margin="1"/></Template></Setter></Style>
    <Style Selector="Slider"><Setter Property="FocusAdorner"><Template><Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="15" Margin="1"/></Template></Setter></Style>
    <Style Selector="Button.categoryTab"><Setter Property="FocusAdorner"><Template><Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="11" Margin="1"/></Template></Setter></Style>
    
    <Style Selector="Border.settingsCard">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
      <Setter Property="CornerRadius" Value="20"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="{DynamicResource TileSeparatorBrush}"/>
    </Style>
    <Style Selector="Button.categoryTab">
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.16"/>
          <BrushTransition Property="BorderBrush" Duration="0:0:0.16"/>
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.categoryTab:pointerover /template/ ContentPresenter, Button.categoryTab:focus /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource TileHoverBrush}"/>
    </Style>
    <Style Selector="Button.categoryTab.active">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
  </Window.Styles>

  <Panel>
  <Grid RowDefinitions="*,Auto" Margin="24" IsEnabled="{Binding FormEnabled}">
    <Grid Grid.Row="0" ColumnDefinitions="190,*">
        
      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="6" Margin="0,0,16,8">
          <TextBlock Text="Configurações" Classes="qsSectionTitle" Margin="8,0,0,8" />
          <Button Classes="settingsTab categoryTab" Classes.active="{Binding IsCategoryModeActive}" Tag="0" Click="OnCategoryTabClick">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Geral" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="›" Opacity="0.65" VerticalAlignment="Center" /></Grid>
          </Button>
          <Button Classes="settingsTab categoryTab" Classes.active="{Binding IsCategoryAppearanceActive}" Tag="1" Click="OnCategoryTabClick">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Aparência" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="›" Opacity="0.65" VerticalAlignment="Center" /></Grid>
          </Button>
          <Button Classes="settingsTab categoryTab" Classes.active="{Binding IsCategorySoundsActive}" Tag="2" Click="OnCategoryTabClick">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Sons" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="›" Opacity="0.65" VerticalAlignment="Center" /></Grid>
          </Button>
          <Button Classes="settingsTab categoryTab" Classes.active="{Binding IsCategoryLibraryActive}" Tag="3" Click="OnCategoryTabClick">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Biblioteca" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="›" Opacity="0.65" VerticalAlignment="Center" /></Grid>
          </Button>
          <Button Classes="settingsTab categoryTab" Classes.active="{Binding IsCategoryShortcutsActive}" Tag="4" Click="OnCategoryTabClick">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Controles" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="›" Opacity="0.65" VerticalAlignment="Center" /></Grid>
          </Button>
          <Button Classes="settingsTab categoryTab" Classes.active="{Binding IsCategoryLosslessActive}" Tag="5" Click="OnCategoryTabClick">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Lossless" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="›" Opacity="0.65" VerticalAlignment="Center" /></Grid>
          </Button>
          <Button Classes="settingsTab categoryTab" Classes.active="{Binding IsCategoryAccountsActive}" Tag="6" Click="OnCategoryTabClick">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Contas" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="›" Opacity="0.65" VerticalAlignment="Center" /></Grid>
          </Button>
          <Button Classes="settingsTab categoryTab" Classes.active="{Binding IsCategoryConnectivityActive}" Tag="7" Click="OnCategoryTabClick">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Rede" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="›" Opacity="0.65" VerticalAlignment="Center" /></Grid>
          </Button>
          <Button Classes="settingsTab categoryTab" Classes.active="{Binding IsCategorySaveCenterActive}" Tag="8" Click="OnCategoryTabClick">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Central de Saves" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="›" Opacity="0.65" VerticalAlignment="Center" /></Grid>
          </Button>
          <Button Classes="settingsTab categoryTab" Classes.active="{Binding IsCategoryNewsActive}" Tag="9" Click="OnCategoryTabClick">
            <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Atualizações" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="›" Opacity="0.65" VerticalAlignment="Center" /></Grid>
          </Button>
        </StackPanel>
      </ScrollViewer>
      
      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="4">

          <!-- Aparência -->
          <StackPanel Spacing="0" IsVisible="{Binding IsCategoryAppearanceActive}">
            <Border Classes="settingsCard">
              <StackPanel Spacing="8">
                <TextBlock Text="Cores e Fontes" Classes="sectionTitle" />
                <TextBlock Text="Tema do Launcher" Classes="label"/>
                <ComboBox SelectedIndex="{Binding ThemeIndex}" IsEnabled="{Binding !IsCartoonThemeActive}" HorizontalAlignment="Stretch" Height="36">
                  <ComboBoxItem Content="Escuro" /><ComboBoxItem Content="Claro" /><ComboBoxItem Content="Azul" />
                  <ComboBoxItem Content="Vermelho" /><ComboBoxItem Content="Verde" /><ComboBoxItem Content="Laranja" />
                  <ComboBoxItem Content="Rosa" /><ComboBoxItem Content="Ciano" /><ComboBoxItem Content="Preto (OLED)" />
                  <ComboBoxItem Content="Dourado" /><ComboBoxItem Content="Grafite" /><ComboBoxItem Content="Meia-noite" />
                  <ComboBoxItem Content="Crepúsculo" /><ComboBoxItem Content="Musgo" /><ComboBoxItem Content="Névoa" />
                  <ComboBoxItem Content="Alto Contraste" /><ComboBoxItem Content="Cartoon" /><ComboBoxItem Content="Cartoon Claro" />
                </ComboBox>

                <!-- v0.25.2: identidade fechada do layout Cartoon -->
                <TextBlock Text="O layout Cartoon usa cores, fonte (Fredoka) e som (Bolha) exclusivos — a personalização fica bloqueada enquanto ele estiver ativo."
                           IsVisible="{Binding IsCartoonThemeActive}"
                           Classes="subtle" FontSize="11" TextWrapping="Wrap" />

                <!-- v0.25.2: única escolha do Cartoon: versão escura ou clara -->
                <TextBlock Text="Versão do Cartoon" Classes="label" Margin="0,8,0,4" IsVisible="{Binding IsCartoonThemeActive}" />
                <ComboBox SelectedIndex="{Binding CartoonVariantIndex}" IsVisible="{Binding IsCartoonThemeActive}" HorizontalAlignment="Stretch" Height="36">
                  <ComboBoxItem Content="Escuro (roxo de estúdio)" />
                  <ComboBoxItem Content="Claro (papel de desenho)" />
                </ComboBox>

                <TextBlock Text="Fonte do Sistema" Classes="label" Margin="0,8,0,4"/>
                <ComboBox SelectedIndex="{Binding FontIndex}" IsEnabled="{Binding !IsCartoonThemeActive}" HorizontalAlignment="Stretch" Height="36">
                  <ComboBoxItem Content="Moderna (Segoe UI)" /><ComboBoxItem Content="Divertida (Comic Sans)" />
                  <ComboBoxItem Content="Formal (Georgia)" /><ComboBoxItem Content="Gamer (Bahnschrift)" />
                  <ComboBoxItem Content="Terminal (Consolas)" /><ComboBoxItem Content="Simples (Arial)" />
                  <ComboBoxItem Content="Clássica (Times New Roman)" /><ComboBoxItem Content="Legível (Verdana)" />
                  <ComboBoxItem Content="Elegante (Trebuchet)" /><ComboBoxItem Content="Limpa (Inter)" />
                  <ComboBoxItem Content="Manuscrita (Ink Free)" /><ComboBoxItem Content="Amigável (Manrope)" />
                  <ComboBoxItem Content="Moderninha (Outfit)" /><ComboBoxItem Content="Técnica (Space Grotesk)" />
                  <ComboBoxItem Content="Neutra (DM Sans)" /><ComboBoxItem Content="Equilibrada (Plus Jakarta Sans)" />
                  <ComboBoxItem Content="Gamer 2 (Chakra Petch)" /><ComboBoxItem Content="Angulosa (Rajdhani)" />
                  <ComboBoxItem Content="Arredondada (Nunito)" /><ComboBoxItem Content="Bolha (Fredoka)" />
                </ComboBox>
                
                <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                  <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Text="Tamanho do Texto" Classes="label"/>
                    <ComboBox SelectedIndex="{Binding FontSizeIndex}" HorizontalAlignment="Stretch" Height="36">
                      <ComboBoxItem Content="Pequeno" /><ComboBoxItem Content="Médio" /><ComboBoxItem Content="Grande" />
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBlock Text="Tamanho das Capas" Classes="label"/>
                    <ComboBox SelectedIndex="{Binding TileSizeIndex}" HorizontalAlignment="Stretch" Height="36">
                      <ComboBoxItem Content="Pequeno" /><ComboBoxItem Content="Médio" /><ComboBoxItem Content="Grande" />
                    </ComboBox>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Classes="settingsCard">
              <StackPanel Spacing="8">
                <TextBlock Text="Layout e Comportamento" Classes="sectionTitle" />
                <TextBlock Text="Layout da Biblioteca" Classes="label"/>
                <ComboBox SelectedIndex="{Binding LayoutIndex}" IsEnabled="{Binding !IsCartoonThemeActive}" HorizontalAlignment="Stretch" Height="36">
                  <ComboBoxItem Content="Fileira horizontal (rola pros lados)" />
                  <ComboBoxItem Content="Grade vertical (rola pra cima e pra baixo)" />
                </ComboBox>
                <!-- 🟢 AVISO DO TEMA CLEAN -->
                <TextBlock Text="O tema Clean usa o carrossel (fileira) por padrão e ignora a grade vertical." 
                           IsVisible="{Binding IsCleanThemeActive}" 
                           Classes="subtle" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <!-- v0.25.2: o Cartoon é sempre grade vertical (blocos) -->
                <TextBlock Text="O tema Cartoon usa sempre a grade vertical (blocos) — a opção fica bloqueada."
                           IsVisible="{Binding IsCartoonThemeActive}"
                           Classes="subtle" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                           
                <ToggleSwitch IsChecked="{Binding Animations}" Content="Animações (zoom e rolagem suave)" Margin="0,8,0,0" />
                
                <TextBlock Text="Cor da Tela (Experimental)" Classes="label" Margin="0,8,0,4"/>
                <ComboBox SelectedIndex="{Binding ColorModeIndex}" HorizontalAlignment="Stretch" Height="36">
                  <ComboBoxItem Content="Padrão" /><ComboBoxItem Content="Vívido" /><ComboBoxItem Content="OLED (contraste alto)" />
                  <ComboBoxItem Content="Noturno (luz quente)" /><ComboBoxItem Content="Confortável" />
                </ComboBox>
                <TextBlock Text="Ajusta a cor da tela inteira (fora do launcher também) enquanto ele estiver aberto." Classes="subtle" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Sons -->
          <StackPanel Spacing="0" IsVisible="{Binding IsCategorySoundsActive}">
            <Border Classes="settingsCard">
              <StackPanel Spacing="8">
                <TextBlock Text="Efeitos Sonoros" Classes="sectionTitle" />
                <ToggleSwitch IsChecked="{Binding SoundEffects}" Content="Sons ao navegar pelo controle" />
                
                <TextBlock Text="Estilo do Som" Classes="label" Margin="0,8,0,4"/>
                <ComboBox SelectedIndex="{Binding SoundThemeIndex}" HorizontalAlignment="Stretch" IsEnabled="{Binding IsSoundStyleEnabled}" Height="36">
                  <ComboBoxItem Content="Console" /><ComboBoxItem Content="Toque" /><ComboBoxItem Content="Bolha" />
                  <ComboBoxItem Content="Mecânico" /><ComboBoxItem Content="Marimba" /><ComboBoxItem Content="Botão" /><ComboBoxItem Content="Digital" />
                </ComboBox>
                <!-- v0.25.2: o layout Cartoon fixa o pacote Bolha -->
                <TextBlock Text="O layout Cartoon usa o som Bolha — o estilo fica bloqueado enquanto ele estiver ativo."
                           IsVisible="{Binding IsCartoonThemeActive}"
                           Classes="subtle" FontSize="11" TextWrapping="Wrap" />
                
                <TextBlock Text="{Binding SoundVolume, StringFormat='Volume dos Efeitos ({0}%)'}" Classes="label" Margin="0,8,0,4"/>
                <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding SoundVolume}" IsEnabled="{Binding SoundEffects}" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Biblioteca -->
          <StackPanel Spacing="0" IsVisible="{Binding IsCategoryLibraryActive}">
            <Border Classes="settingsCard">
              <StackPanel Spacing="8">
                <TextBlock Text="Xbox App" Classes="sectionTitle" />
                <TextBlock Text="Pastas extras com jogos (uma por linha)" Classes="label" />
                <TextBox Text="{Binding XboxScanFoldersText}" Watermark="C:\Xbox&#10;D:\Xbox" AcceptsReturn="True" Height="80" TextWrapping="Wrap" />
              </StackPanel>
            </Border>

            <Border Classes="settingsCard">
              <StackPanel Spacing="8">
                <TextBlock Text="Eden (Emulador de Switch)" Classes="sectionTitle" />
                <TextBlock Text="Caminho do eden.exe" Classes="label" />
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0" Text="{Binding EdenExecutablePath}" Watermark="C:\Eden Emu\eden.exe" Height="36" />
                  <Button Grid.Column="1" Classes="pill" Content="Procurar…" Click="OnBrowseEdenClick" Margin="8,0,0,0" />
                </Grid>
                <TextBlock Text="{Binding EdenStatusText}" Classes="subtle" FontSize="11" TextWrapping="Wrap" />
                
                <TextBlock Text="Pastas de ROMs (uma por linha)" Classes="label" Margin="0,8,0,4" />
                <TextBox Text="{Binding EdenRomFoldersText}" Watermark="D:\Roms\Switch" AcceptsReturn="True" Height="60" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,4">
                  <Button Classes="pill" Content="+ Adicionar pasta…" Click="OnAddRomFolderClick" />
                  <Button Classes="pill" Content="Testar agora" Click="OnTestEdenScanClick" />
                </StackPanel>
                <TextBlock Text="{Binding EdenScanResultText}" IsVisible="{Binding HasEdenScanResult}" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="Formatos: .nsp, .xci, .nsz, .xcz. DLCs são ignorados. Mudanças só valem após reiniciar o launcher." Classes="subtle" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Geral -->
          <StackPanel Spacing="0" IsVisible="{Binding IsCategoryModeActive}">
            <Border Classes="settingsCard">
              <StackPanel Spacing="8">
                <TextBlock Text="Modo de Uso" Classes="sectionTitle" />
                <RadioButton GroupName="Modo" IsChecked="{Binding IsHandheldMode}" Content="Handheld (Tela Cheia)" Margin="0,4,0,0"/>
                <TextBlock Text="Recomendado no aparelho. Abre sozinho e reabre se fechar." Classes="subtle" FontSize="11" Margin="28,0,0,8" />
                
                <RadioButton GroupName="Modo" IsChecked="{Binding IsDesktopMode}" Content="Uso em PC (Janela)" />
                <TextBlock Text="Janela normal. Não abre sozinho, e 'Sair' fecha de verdade." Classes="subtle" FontSize="11" Margin="28,0,0,8" />
              </StackPanel>
            </Border>

            <!-- 🟢 NOVO BLOCO DO OVERLAY (LIVRE DE FREEZE) -->
            <Border Classes="settingsCard">
              <StackPanel Spacing="8">
                <TextBlock Text="Overlay (Quick Settings)" Classes="sectionTitle" />
                
                <ToggleSwitch IsChecked="{Binding IsolateControllerOnOverlay}">
                    <ToggleSwitch.Content>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Isolar controle no Overlay (HidHide)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Esconde o controle físico do jogo enquanto o Quick Settings está aberto. O jogo continua rodando no fundo, mas não recebe comandos duplicados. Recomendado para evitar banimentos em anti-cheat." 
                                       TextWrapping="Wrap" Foreground="Gray" FontSize="11" MaxWidth="450"/>
                        </StackPanel>
                    </ToggleSwitch.Content>
                </ToggleSwitch>

                <!-- v0.24.1: o driver do HidHide só aceita a configuração com
                     administrador. Em vez de falhar em silêncio, o cartão diz em
                     que modo está e oferece o reinício elevado. -->
                <TextBlock Text="{Binding HidHideModeText}" Classes="subtle"
                           TextWrapping="Wrap" FontSize="11" MaxWidth="450" />

                <Button Content="Reiniciar como administrador" Classes="pill"
                        IsVisible="{Binding CanRestartAsAdmin}" Click="OnRestartAsAdminClick"
                        HorizontalAlignment="Left" />

                <!-- v0.24.1: congelamento OPT-IN. O HidHide decide quem vê o
                     controle no momento em que a aplicação o abre, por isso não
                     consegue tirá-lo a um jogo que já esteja a correr. Suspender
                     o processo consegue — mas tem risco em jogos competitivos,
                     daí o aviso e o "Aceito" antes de ligar. -->
                <!-- v0.25.10: uma escolha só, com a recomendação de cada modo. -->
                <TextBlock Text="Quando o Quick Settings abre dentro do jogo"
                           FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,10,0,0"/>

                <RadioButton GroupName="QsInGameMode" IsChecked="{Binding IsQsModeFocus}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Pegar o foco do jogo (recomendado)" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="O jogo para de receber o controle enquanto o painel está aberto. Alguns jogos escurecem ou minimizam ao perder o foco; em tela cheia exclusiva o Windows mostra um fundo preto atrás do painel."
                               TextWrapping="Wrap" Foreground="Gray" FontSize="11" MaxWidth="430"/>
                  </StackPanel>
                </RadioButton>

                <RadioButton GroupName="QsInGameMode" IsChecked="{Binding IsQsModeNoFocus}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="Não pegar o foco" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="A imagem do jogo continua normal atrás do painel, mas o jogo também recebe os botões que você aperta no Quick Settings. Use em jogos que escurecem com o modo recomendado."
                               TextWrapping="Wrap" Foreground="Gray" FontSize="11" MaxWidth="430"/>
                  </StackPanel>
                </RadioButton>

                <RadioButton GroupName="QsInGameMode" IsChecked="{Binding IsQsModeFreeze}">
                  <StackPanel Spacing="2">
                    <TextBlock Text="⚠ Congelar o jogo" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Suspende o jogo enquanto o painel está aberto. Pode causar banimento em jogos com anti-cheat — não use em jogos competitivos. Pede confirmação."
                               TextWrapping="Wrap" Foreground="Gray" FontSize="11" MaxWidth="430"/>
                  </StackPanel>
                </RadioButton>

                <TextBlock Text="{Binding FreezeStatusText}" Classes="subtle" FontSize="11"
                           TextWrapping="Wrap" MaxWidth="450"/>

                <!-- 11/11: "Pedir permissão para isolar (UAC por overlay)" saiu do
                     menu — desde a 0.25.7 o launcher abre sempre como
                     administrador. A opção continua no settings.json
                     (HidHideElevateOnDemand) para quem precisar. -->

              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Contas -->
          <StackPanel Spacing="0" IsVisible="{Binding IsCategoryAccountsActive}">
            <Border Classes="settingsCard">
              <StackPanel Spacing="6">
                <TextBlock Text="Status das Contas" Classes="sectionTitle" />
                <TextBlock FontSize="12"><Run Text="SteamGridDB (capas): " /><Run Text="{Binding SteamGridDbStatusText}" /></TextBlock>
                <TextBlock FontSize="12"><Run Text="Steam Web API (downloads): " /><Run Text="{Binding SteamWebApiStatusText}" /></TextBlock>
                <TextBlock FontSize="12"><Run Text="Conta Steam (SteamID64): " /><Run Text="{Binding SteamIdStatusText}" /></TextBlock>
                <TextBlock FontSize="12"><Run Text="RAWG API (metadados): " /><Run Text="{Binding RawgApiStatusText}" /></TextBlock>
                <TextBlock FontSize="12"><Run Text="IGDB (Twitch): " /><Run Text="{Binding IgdbApiStatusText}" /></TextBlock>
                
                <Button Classes="pill primary" Content="🔒 Gerenciar contas e chaves de API" Click="OnManageAccountsClick" HorizontalAlignment="Left" Margin="0,12,0,0" />
                <TextBlock Text="As chaves ficam criptografadas neste PC." Classes="subtle" FontSize="11" Margin="0,8,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Atalhos -->
          <StackPanel Spacing="0" IsVisible="{Binding IsCategoryShortcutsActive}">
            <Border Background="#14251D" BorderBrush="#347A50" BorderThickness="1.5" CornerRadius="12" Padding="16" Margin="0,0,0,12">
              <StackPanel Spacing="10">
                <TextBlock Text="🎮 CONTROLE" FontSize="13" FontWeight="Bold" Foreground="#75D99A" />
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Navegar na biblioteca" Foreground="#D6F5E0"/><TextBlock Grid.Column="1" Text="D-Pad" FontWeight="Bold" Foreground="#8FE3AC"/></Grid>
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Confirmar / Abrir jogo" Foreground="#D6F5E0"/><TextBlock Grid.Column="1" Text="A" FontWeight="Bold" Foreground="#8FE3AC"/></Grid>
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Voltar / Fechar" Foreground="#D6F5E0"/><TextBlock Grid.Column="1" Text="B" FontWeight="Bold" Foreground="#8FE3AC"/></Grid>
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Opções do jogo" Foreground="#D6F5E0"/><TextBlock Grid.Column="1" Text="Select" FontWeight="Bold" Foreground="#8FE3AC"/></Grid>
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Menu global" Foreground="#D6F5E0"/><TextBlock Grid.Column="1" Text="Start" FontWeight="Bold" Foreground="#8FE3AC"/></Grid>
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Filtros (Anterior/Próximo)" Foreground="#D6F5E0"/><TextBlock Grid.Column="1" Text="LB / RB" FontWeight="Bold" Foreground="#8FE3AC"/></Grid>
              </StackPanel>
            </Border>
            <Border Background="#1D1B30" BorderBrush="#7054C7" BorderThickness="1.5" CornerRadius="12" Padding="16">
              <StackPanel Spacing="10">
                <TextBlock Text="⌨ TECLADO" FontSize="13" FontWeight="Bold" Foreground="#B9A5FF" />
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Navegar na biblioteca" Foreground="#E6E0FF"/><TextBlock Grid.Column="1" Text="← ↑ ↓ →" FontWeight="Bold" Foreground="#C6B5FF"/></Grid>
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Abrir jogo selecionado" Foreground="#E6E0FF"/><TextBlock Grid.Column="1" Text="Enter" FontWeight="Bold" Foreground="#C6B5FF"/></Grid>
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Menu de opções do jogo" Foreground="#E6E0FF"/><TextBlock Grid.Column="1" Text="Space" FontWeight="Bold" Foreground="#C6B5FF"/></Grid>
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Menu global" Foreground="#E6E0FF"/><TextBlock Grid.Column="1" Text="Escape" FontWeight="Bold" Foreground="#C6B5FF"/></Grid>
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Conectividade -->
          <StackPanel Spacing="0" IsVisible="{Binding IsCategoryConnectivityActive}">
            
            <!-- v0.24: o card de sincronização saiu da aba Rede — ele agora vive
                 na aba "Central de Saves", que já abre o painel embutido. -->

            <Border Classes="settingsCard">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Text="Wi-Fi" FontSize="16" FontWeight="Bold" />
                  <TextBlock Text="Conectar a uma rede ou esquecer redes salvas." Classes="subtle" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="pill primary" Content="Abrir Wi-Fi" Click="OnOpenWifiSettingsClick" VerticalAlignment="Center" />
              </Grid>
            </Border>
            <Border Classes="settingsCard">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                  <TextBlock Text="Bluetooth" FontSize="16" FontWeight="Bold" />
                  <TextBlock Text="Parear controles, fones e outros acessórios." Classes="subtle" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="pill primary" Content="Abrir Bluetooth" Click="OnOpenBluetoothSettingsClick" VerticalAlignment="Center" />
              </Grid>
            </Border>
          </StackPanel>

          <!-- Central de Saves -->
          <StackPanel Spacing="0" IsVisible="{Binding IsCategorySaveCenterActive}">
            <Border Classes="settingsCard">
              <StackPanel Spacing="8">
                <TextBlock Text="Sincronização (Syncthing)" Classes="sectionTitle" />
                <ToggleSwitch IsChecked="{Binding SyncthingEnabled}" Content="Ativar sincronização em segundo plano" />
                <TextBlock Text="Mantém seus saves e configurações sincronizados entre o handheld e o PC. Ao entrar nesta aba a central abre sozinha, com o painel do Syncthing embutido." Classes="subtle" FontSize="11" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                  <Button Classes="pill primary" Content="🔄 Abrir Central de Saves" Command="{Binding OpenSyncthingCommand}" />
                  <Button Classes="pill" Content="Abrir no navegador" Click="OnOpenSyncthingWebUiClick" />
                </StackPanel>
                <TextBlock Text="{Binding SyncthingStatusText}" IsVisible="{Binding HasSyncthingStatus}" Classes="subtle" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>

          <!-- Atualizações -->
          <StackPanel Spacing="0" IsVisible="{Binding IsCategoryNewsActive}">
            <Border Classes="settingsCard">
              <StackPanel Spacing="8">
                <ToggleSwitch IsChecked="{Binding BetaChannelOptIn}" Content="Receber atualizações beta" />
                <TextBlock Text="Versões de teste, antes de virarem lançamento oficial. Pode desativar quando quiser." Classes="subtle" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoadingReleases}" Height="4" Margin="0,10" />
            <ItemsControl ItemsSource="{Binding ReleaseHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GitHubRelease">
                  <Border Classes="settingsCard">
                    <StackPanel Spacing="8">
                      <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding TagName}" FontSize="17" FontWeight="Bold" Foreground="#75D99A"/>
                        <TextBlock Text="{Binding Name}" Foreground="#BFA9FF" VerticalAlignment="Center" FontWeight="SemiBold"/>
                      </StackPanel>
                      <TextBlock Text="{Binding Body}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>

          <!-- Lossless Scaling -->
          <StackPanel Spacing="0" IsVisible="{Binding IsCategoryLosslessActive}">
            <Border Classes="settingsCard">
              <StackPanel Spacing="8">
                <TextBlock Text="🖼 Lossless Scaling" Classes="sectionTitle" />
                <TextBlock Text="Caminho do LosslessScaling.exe" Classes="label"/>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBox Grid.Column="0" Text="{Binding LosslessScalingPath}" Watermark="C:\Steam\...\LosslessScaling.exe" Height="36" />
                  <Button Grid.Column="1" Classes="pill" Content="Procurar…" Click="OnBrowseLosslessClick" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock Text="Se o app estiver na Steam, ele é detectado automaticamente." Classes="subtle" FontSize="11" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
          </StackPanel>

        </StackPanel>
      </ScrollViewer>
    </Grid>

    <StackPanel Grid.Row="1" Spacing="10" Margin="0,16,0,0">
      <TextBlock Text="{Binding UpdateResultText}" IsVisible="{Binding HasUpdateResult}" TextWrapping="Wrap" />
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="🎮 Start: Salvar | X: Salvar e Fechar" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
          <Button Classes="pill" Content="⌨ Teclado" Click="OnKeyboardClick" />
          <Button Classes="pill primary" Content="{Binding SaveButtonText}" Click="OnSaveAndCloseClick" Height="40" Width="160" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid>

  <Panel Classes="fadeIn" IsVisible="{Binding HasSavedMessage}">
    <Border Classes="contextMenuOverlay" />
    <Border Classes="contextMenuCard" Width="440" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="16" HorizontalAlignment="Center">
        <TextBlock Text="✓ Configurações salvas" Classes="menuHeaderTitle" FontSize="20" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding SavedMessage}" Classes="subtle" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" />
        <Button x:Name="SavedOkButton" Classes="pill primary" Content="OK" Click="OnSavedOkClick" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Panel>

  <!-- v0.24.2: teclado do launcher, sobreposto no fundo. É filho do Panel raiz
       e vem DEPOIS do conteúdo (para desenhar por cima) e ANTES da tela do
       Syncthing (que tem de cobrir tudo). -->
  <views:OnScreenKeyboardView x:Name="Keyboard" VerticalAlignment="Bottom" />


  <!-- v0.24.1: aviso de risco do congelamento (só liga depois do "Aceito"). -->
  <Panel Classes="fadeIn" IsVisible="{Binding IsFreezeConfirmOpen}">
    <Border Classes="contextMenuOverlay" />
    <Border Classes="contextMenuCard" Width="540" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="14">
        <TextBlock Text="⚠ Congelar o jogo no Quick Settings" Classes="menuHeaderTitle" FontSize="18" TextWrapping="Wrap" />
        <TextBlock TextWrapping="Wrap" Classes="subtle" MaxWidth="480"
                   Text="Ligado, o launcher SUSPENDE o processo do jogo enquanto o Quick Settings está aberto. É a única forma de o jogo parar de receber comandos quando já está a correr — o isolamento por HidHide não consegue revogar um controle que o jogo já abriu." />
        <TextBlock TextWrapping="Wrap" Classes="subtle" MaxWidth="480"
                   Text="Risco: alguns anti-cheats de jogos competitivos podem interpretar um processo suspenso como manipulação e banir a conta. Usa por tua conta e risco — em jogos com anti-cheat, deixa desligado." />
        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
          <Button Classes="pill" Content="Cancelar" Click="OnFreezeCancelClick" />
          <Button Classes="pill primary" Content="Aceito o risco, ativar" Click="OnFreezeAcceptClick" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Panel>


  <!-- v0.24: tela cheia do Syncthing (WebView nativo). É o último filho do
       Panel raiz porque controle nativo não respeita z-order do Avalonia.
       Só é criado quando IsSyncthingOpen vira true. -->
  <views:SyncthingSettingsView x:Name="SyncthingView" IsVisible="{Binding IsSyncthingOpen}" />
  </Panel>
</Window>