<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HandheldLauncher.App.ViewModels"
        x:Class="HandheldLauncher.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Configurações"
        Width="560" Height="860"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

  <Window.Styles>
    <Style Selector="ComboBox">
      <Setter Property="FocusAdorner">
        <Template>
          <Border BorderBrush="#7C5CFC" BorderThickness="3" CornerRadius="10" Margin="-4"/>
        </Template>
      </Setter>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FocusAdorner">
        <Template>
          <Border BorderBrush="#7C5CFC" BorderThickness="3" CornerRadius="10" Margin="-4"/>
        </Template>
      </Setter>
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="FocusAdorner">
        <Template>
          <Border BorderBrush="#7C5CFC" BorderThickness="3" CornerRadius="10" Margin="-4"/>
        </Template>
      </Setter>
    </Style>
    <Style Selector="RadioButton">
      <Setter Property="FocusAdorner">
        <Template>
          <Border BorderBrush="#7C5CFC" BorderThickness="3" CornerRadius="10" Margin="-4"/>
        </Template>
      </Setter>
    </Style>
    <Style Selector="Slider">
      <Setter Property="FocusAdorner">
        <Template>
          <Border BorderBrush="#7C5CFC" BorderThickness="3" CornerRadius="16" Margin="-4"/>
        </Template>
      </Setter>
    </Style>
    <Style Selector="Button.categoryTab">
      <Setter Property="FocusAdorner">
        <Template>
          <Border BorderBrush="#7C5CFC" BorderThickness="3" CornerRadius="16" Margin="-3"/>
        </Template>
      </Setter>
    </Style>
  </Window.Styles>

  <Panel>
  <Grid RowDefinitions="*,Auto" Margin="24" IsEnabled="{Binding FormEnabled}">
    <Grid Grid.Row="0" ColumnDefinitions="142,*" ColumnSpacing="14">
        
      <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,0,8">
        <TextBlock Text="CONFIGURAÇÕES" FontSize="10" FontWeight="Bold" Opacity="0.55" Margin="8,0,0,6" />
        <Button Classes="pill filterTab categoryTab" Classes.active="{Binding IsCategoryAppearanceActive}" Content="Aparência" Tag="0" Click="OnCategoryTabClick" HorizontalContentAlignment="Left" Padding="12,12" />
        <Button Classes="pill filterTab categoryTab" Classes.active="{Binding IsCategoryFoldersActive}" Content="Diretórios" Tag="1" Click="OnCategoryTabClick" HorizontalContentAlignment="Left" Padding="12,12" />
        <Button Classes="pill filterTab categoryTab" Classes.active="{Binding IsCategoryEmulatorsActive}" Content="Emuladores" Tag="2" Click="OnCategoryTabClick" HorizontalContentAlignment="Left" Padding="12,12" />
        <Button Classes="pill filterTab categoryTab" Classes.active="{Binding IsCategoryModeActive}" Content="Modo de uso" Tag="3" Click="OnCategoryTabClick" HorizontalContentAlignment="Left" Padding="12,12" />
        <Button Classes="pill filterTab categoryTab" Classes.active="{Binding IsCategoryAccountsActive}" Content="Contas" Tag="4" Click="OnCategoryTabClick" HorizontalContentAlignment="Left" Padding="12,12" />
        <Button Classes="pill filterTab categoryTab" Classes.active="{Binding IsCategoryShortcutsActive}" Content="Atalhos" Tag="5" Click="OnCategoryTabClick" HorizontalContentAlignment="Left" Padding="12,12" />
        <Button Classes="pill filterTab categoryTab" Classes.active="{Binding IsCategoryLosslessActive}" Content="Lossless Scaling" Tag="6" Click="OnCategoryTabClick" HorizontalContentAlignment="Left" Padding="12,12" />
      </StackPanel>
      <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="12">
        <!-- ===== Aparência ===== -->
        <StackPanel Spacing="12" IsVisible="{Binding IsCategoryAppearanceActive}">
          <TextBlock Text="Cores" FontSize="12" HorizontalAlignment="Center" />
          <ComboBox SelectedIndex="{Binding ThemeIndex}" Width="440" HorizontalAlignment="Center">
            <ComboBoxItem Content="Escuro" />
            <ComboBoxItem Content="Claro" />
            <ComboBoxItem Content="Azul" />
            <ComboBoxItem Content="Vermelho" />
            <ComboBoxItem Content="Verde" />
            <ComboBoxItem Content="Laranja" />
            <ComboBoxItem Content="Rosa" />
            <ComboBoxItem Content="Ciano" />
            <ComboBoxItem Content="Preto (OLED)" />
            <ComboBoxItem Content="Dourado" />
            <ComboBoxItem Content="Grafite" />
          </ComboBox>
          <TextBlock Text="Fonte" FontSize="12" HorizontalAlignment="Center" />
          <ComboBox SelectedIndex="{Binding FontIndex}" Width="440" HorizontalAlignment="Center">
            <ComboBoxItem Content="Moderna (Segoe UI)" />
            <ComboBoxItem Content="Divertida (Comic Sans)" />
            <ComboBoxItem Content="Formal (Georgia)" />
            <ComboBoxItem Content="Gamer (Bahnschrift)" />
            <ComboBoxItem Content="Terminal (Consolas)" />
            <ComboBoxItem Content="Simples (Arial)" />
            <ComboBoxItem Content="Clássica (Times New Roman)" />
            <ComboBoxItem Content="Legível (Verdana)" />
            <ComboBoxItem Content="Elegante (Trebuchet)" />
          </ComboBox>
          <TextBlock Text="Tamanho do texto" FontSize="12" HorizontalAlignment="Center" />
          <ComboBox SelectedIndex="{Binding FontSizeIndex}" Width="440" HorizontalAlignment="Center">
            <ComboBoxItem Content="Pequeno" />
            <ComboBoxItem Content="Médio" />
            <ComboBoxItem Content="Grande" />
          </ComboBox>
          <TextBlock Text="Tamanho das capas" FontSize="12" HorizontalAlignment="Center" />
          <ComboBox SelectedIndex="{Binding TileSizeIndex}" Width="440" HorizontalAlignment="Center">
            <ComboBoxItem Content="Pequeno" />
            <ComboBoxItem Content="Médio" />
            <ComboBoxItem Content="Grande" />
          </ComboBox>
          <TextBlock Text="Biblioteca" FontSize="12" HorizontalAlignment="Center" />
          <ComboBox SelectedIndex="{Binding LayoutIndex}" Width="440" HorizontalAlignment="Center">
            <ComboBoxItem Content="Fileira horizontal (rola pros lados)" />
            <ComboBoxItem Content="Grade vertical (rola pra cima e pra baixo)" />
          </ComboBox>
          <CheckBox IsChecked="{Binding Animations}" Content="Animações (zoom no jogo selecionado e ao passar o mouse, rolagem suave)" HorizontalAlignment="Center" />
          <CheckBox IsChecked="{Binding SoundEffects}" Content="Sons de interação (navegar/confirmar/voltar pelo controle)" HorizontalAlignment="Center" />
          <TextBlock Text="Estilo do som" FontSize="12" HorizontalAlignment="Center" />
          <ComboBox SelectedIndex="{Binding SoundThemeIndex}" Width="440" HorizontalAlignment="Center" IsEnabled="{Binding SoundEffects}">
            <ComboBoxItem Content="Clássico" />
            <ComboBoxItem Content="Suave" />
            <ComboBoxItem Content="Retro" />
            <ComboBoxItem Content="Future" />
          </ComboBox>
          <TextBlock Text="{Binding SoundVolume, StringFormat='Volume dos sons ({0}%)'}" FontSize="12" HorizontalAlignment="Center" />
          <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding SoundVolume}" IsEnabled="{Binding SoundEffects}" Width="440" HorizontalAlignment="Center" />
          <TextBlock Text="Modo de imagem/cor (experimental)" FontSize="12" HorizontalAlignment="Center" />
          <ComboBox SelectedIndex="{Binding ColorModeIndex}" Width="440" HorizontalAlignment="Center">
            <ComboBoxItem Content="Padrão" />
            <ComboBoxItem Content="Vívido" />
            <ComboBoxItem Content="OLED (contraste alto)" />
            <ComboBoxItem Content="Noturno (luz quente)" />
            <ComboBoxItem Content="Confortável" />
          </ComboBox>
          <TextBlock Text="Ajusta a cor da tela inteira (fora do launcher também) enquanto ele estiver aberto. Se a tela ficar estranha depois de trocar, feche e abra o launcher de novo." Classes="subtle" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Width="440" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- ===== Diretórios ===== -->
        <StackPanel Spacing="12" IsVisible="{Binding IsCategoryFoldersActive}">
          <TextBlock Text="Pastas extras pra procurar jogos do Xbox app (uma por linha)" Classes="subtle" />
          <TextBox Text="{Binding XboxScanFoldersText}" Watermark="C:\Xbox&#10;D:\Xbox" AcceptsReturn="True" Height="80" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ===== Emuladores ===== -->
        <StackPanel Spacing="12" IsVisible="{Binding IsCategoryEmulatorsActive}">
          <TextBlock Text="Eden — emulador de Nintendo Switch" FontSize="13" FontWeight="SemiBold" />
          <TextBlock Text="Onde está o eden.exe" Classes="subtle" FontSize="12" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding EdenExecutablePath}" Watermark="C:\Eden Emu\eden.exe" Margin="0,0,8,0" />
            <Button Grid.Column="1" Classes="pill" Content="Procurar…" Click="OnBrowseEdenClick" />
          </Grid>
          <TextBlock Text="{Binding EdenStatusText}" Classes="subtle" FontSize="11" TextWrapping="Wrap" />
          <TextBlock Text="Pastas com as ROMs (uma por linha)" Classes="subtle" FontSize="12" Margin="0,8,0,0" />
          <TextBox Text="{Binding EdenRomFoldersText}" Watermark="D:\Roms\Switch" AcceptsReturn="True" Height="80" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Classes="pill" Content="+ Adicionar pasta…" Click="OnAddRomFolderClick" />
            <Button Classes="pill" Content="Testar agora" Click="OnTestEdenScanClick" />
          </StackPanel>
          <TextBlock Text="{Binding EdenScanResultText}" IsVisible="{Binding HasEdenScanResult}" FontSize="11" TextWrapping="Wrap" />
          <TextBlock Text="As subpastas também são procuradas. Formatos reconhecidos: .nsp, .xci, .nsz, .xcz. DLC e arquivos de atualização são ignorados — eles não abrem como jogo. Os jogos aparecem na biblioteca junto dos outros e abrem direto no Eden em tela cheia." Classes="subtle" FontSize="11" TextWrapping="Wrap" />
          <TextBlock Text="Mudanças aqui só valem na biblioteca depois de fechar e abrir o launcher. O 'Testar agora' escaneia com o que está nas caixas acima, sem precisar salvar nem reiniciar." Classes="subtle" FontSize="11" TextWrapping="Wrap" />
          <TextBlock Text="O launcher não instala nem distribui o Eden — ele só abre o que já estiver instalado neste PC. Firmware e chaves continuam sendo responsabilidade sua." Classes="subtle" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ===== Modo de uso ===== -->
        <StackPanel Spacing="12" IsVisible="{Binding IsCategoryModeActive}">
          <RadioButton GroupName="Modo" IsChecked="{Binding IsDesktopMode}" Content="Desktop (PC) — janela normal, não abre sozinho, 'Sair' fecha de verdade" />
          <RadioButton GroupName="Modo" IsChecked="{Binding IsHandheldMode}" Content="Handheld (modo jogo) — tela cheia, abre no login, reabre se fechar" />
          <TextBlock Text="No modo Handheld, 'Sair' (menu Energia) segura a reabertura até reiniciar o aparelho. Abrir pelo atalho sempre funciona." Classes="subtle" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ===== Contas ===== -->
        <StackPanel Spacing="12" IsVisible="{Binding IsCategoryAccountsActive}">
          <StackPanel Spacing="2">
            <TextBlock FontSize="12"><Run Text="SteamGridDB (capas): " /><Run Text="{Binding SteamGridDbStatusText}" /></TextBlock>
            <TextBlock FontSize="12"><Run Text="Steam Web API (downloads): " /><Run Text="{Binding SteamWebApiStatusText}" /></TextBlock>
            <TextBlock FontSize="12"><Run Text="Conta Steam (SteamID64): " /><Run Text="{Binding SteamIdStatusText}" /></TextBlock>
            <TextBlock FontSize="12"><Run Text="RAWG API (metadados extras): " /><Run Text="{Binding RawgApiStatusText}" /></TextBlock>
          </StackPanel>
          <Button Classes="pill" Content="🔒 Gerenciar contas e chaves de API" Click="OnManageAccountsClick" HorizontalAlignment="Left" />
          <TextBlock Text="O launcher nunca pede nem guarda a senha da Steam. As chaves ficam criptografadas neste PC (só o seu usuário do Windows consegue ler)." Classes="subtle" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>

        <!-- ===== Atalhos de Teclado ===== -->
        <StackPanel Spacing="12" IsVisible="{Binding IsCategoryShortcutsActive}">
          <TextBlock Text="Atalhos de Teclado (teclado físico)" FontSize="13" FontWeight="SemiBold" />
          <Grid ColumnDefinitions="*, 200">
            <TextBlock Text="Filtro Anterior" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding KeyPrevFilter}" Watermark="Ex: Q" />
          </Grid>
          <Grid ColumnDefinitions="*, 200">
            <TextBlock Text="Próximo Filtro" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding KeyNextFilter}" Watermark="Ex: E" />
          </Grid>
          <Grid ColumnDefinitions="*, 200">
            <TextBlock Text="Downloads" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding KeyDownloads}" Watermark="Ex: D" />
          </Grid>
          <Grid ColumnDefinitions="*, 200">
            <TextBlock Text="Menu de Contexto (Opções do Jogo)" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding KeyContextMenu}" Watermark="Ex: Space" />
          </Grid>
          <Grid ColumnDefinitions="*, 200">
            <TextBlock Text="Menu Global (Sistema)" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding KeyGlobalMenu}" Watermark="Ex: Escape" />
          </Grid>
          <Grid ColumnDefinitions="*, 200">
            <TextBlock Text="Fechar Jogo" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding KeyCloseGame}" Watermark="Ex: Ctrl+W" />
          </Grid>
          <Grid ColumnDefinitions="*, 200">
            <TextBlock Text="Abrir Jogo Selecionado" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding KeyLaunchGame}" Watermark="Ex: Enter" />
          </Grid>
          <TextBlock Text="Aceita combinações como 'Ctrl+W', 'Alt+F4', 'Escape', 'Space', 'F1'. Setas e navegação ficam fixas. Deixe em branco para restaurar o padrão ao salvar." Classes="subtle" FontSize="11" TextWrapping="Wrap" />
          <TextBlock Text="💡 Dica: pressione F1 no launcher a qualquer momento para ver esta lista formatada." Classes="subtle" FontSize="11" TextWrapping="Wrap" FontStyle="Italic" />
        </StackPanel>

        <!-- ===== 🦆 Lossless Scaling ===== -->
        <StackPanel Spacing="12" IsVisible="{Binding IsCategoryLosslessActive}">
          <TextBlock Text="🦆 Lossless Scaling (Patinho)" FontSize="13" FontWeight="SemiBold" />
          <TextBlock Text="O launcher usa o atalho global (Ctrl+Alt+S) para ativar o Frame Gen na janela do jogo." Classes="subtle" FontSize="11" TextWrapping="Wrap" />
          
          <TextBlock Text="Caminho do LosslessScaling.exe" Classes="subtle" FontSize="12" Margin="0,8,0,0"/>
          <Grid ColumnDefinitions="*,Auto">
            <TextBox Grid.Column="0" Text="{Binding LosslessScalingPath}" 
                     Watermark="Ex: C:\Steam\steamapps\common\Lossless Scaling\LosslessScaling.exe" 
                     Margin="0,0,8,0" />
            <Button Grid.Column="1" Classes="pill" Content="Procurar…" Click="OnBrowseLosslessClick" />
          </Grid>
          <TextBlock Text="Se o app estiver na Steam, ele é detectado automaticamente. Se você moveu ou comprou em outro lugar, aponte o caminho aqui." Classes="subtle" FontSize="11" TextWrapping="Wrap" />
        </StackPanel>

      </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <StackPanel Grid.Row="1" Spacing="10" Margin="0,16,0,0">
      <TextBlock Text="{Binding UpdateResultText}" IsVisible="{Binding HasUpdateResult}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Classes="pill" Content="⌨ Teclado" Click="OnKeyboardClick" />
        <Button Classes="pill primary" Content="✕ Salvar e fechar" Click="OnSaveAndCloseClick" />
      </StackPanel>
    </StackPanel>
  </Grid>

  <Panel Classes="fadeIn" IsVisible="{Binding HasSavedMessage}">
    <Border Classes="contextMenuOverlay" />
    <Border Classes="contextMenuCard" Width="440" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
      <StackPanel Spacing="16" HorizontalAlignment="Center">
        <TextBlock Text="✓ Configurações salvas" Classes="menuHeaderTitle" FontSize="20" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding SavedMessage}" Classes="subtle" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" />
        <Button x:Name="SavedOkButton" Classes="pill primary" Content="OK" Click="OnSavedOkClick" HorizontalAlignment="Center" />
      </StackPanel>
    </Border>
  </Panel>
  </Panel>
</Window>