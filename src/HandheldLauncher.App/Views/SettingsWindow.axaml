<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HandheldLauncher.App.ViewModels"
        x:Class="HandheldLauncher.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Configurações"
        Width="560" Height="860"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

  <!--
    Mesmo padrão do AddGameWindow: diálogo mouse/teclado-only de
    propósito, não pensado pro gamepad ainda (ver code-behind) — quem
    está colando uma API key já está num PC com teclado.
  -->

  <Grid RowDefinitions="*,Auto" Margin="24">
    <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <TextBlock Text="SteamGridDB API key (capas)" Classes="subtle" />
        <TextBox Text="{Binding SteamGridDbApiKey}" Watermark="Cole aqui — steamgriddb.com/profile/preferences/api" />

        <TextBlock Text="Steam Web API key (lista 'na conta, não instalado')" Classes="subtle" Margin="0,8,0,0" />
        <TextBox Text="{Binding SteamWebApiKey}" Watermark="Cole aqui — steamcommunity.com/dev/apikey" />

        <TextBlock Text="SteamID64" Classes="subtle" Margin="0,8,0,0" />
        <TextBox Text="{Binding SteamId64}" Watermark="Ex: 76561198012345678 — ache o seu em steamid.io" />

        <TextBlock Text="Pastas extras pra procurar jogos do Xbox app (uma por linha)" Classes="subtle" Margin="0,8,0,0" />
        <TextBox Text="{Binding XboxScanFoldersText}"
                 Watermark="C:\Xbox&#10;D:\Xbox"
                 AcceptsReturn="True"
                 Height="80"
                 TextWrapping="Wrap" />

        <TextBlock Text="Modo de uso" Classes="subtle" Margin="0,8,0,0" />
        <RadioButton GroupName="Modo"
                     IsChecked="{Binding IsDesktopMode}"
                     Content="Desktop (PC) — janela normal, não abre sozinho, 'Sair' fecha de verdade" />
        <RadioButton GroupName="Modo"
                     IsChecked="{Binding IsHandheldMode}"
                     Content="Handheld (modo jogo) — tela cheia, abre no login, reabre se fechar" />
        <TextBlock Text="No modo Handheld, 'Sair' (menu Power) segura a reabertura até reiniciar o aparelho. Abrir pelo atalho sempre funciona."
                   Classes="subtle"
                   FontSize="11"
                   TextWrapping="Wrap" />

        <TextBlock Text="Aparência" Classes="subtle" Margin="0,12,0,0" />
        <TextBlock Text="Tema" FontSize="12" />
        <ComboBox SelectedIndex="{Binding ThemeIndex}" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="Escuro" />
          <ComboBoxItem Content="Claro" />
          <ComboBoxItem Content="Azul" />
          <ComboBoxItem Content="Vermelho" />
        </ComboBox>
        <TextBlock Text="Tamanho das capas" FontSize="12" />
        <ComboBox SelectedIndex="{Binding TileSizeIndex}" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="Pequeno" />
          <ComboBoxItem Content="Médio" />
          <ComboBoxItem Content="Grande" />
        </ComboBox>
        <TextBlock Text="Biblioteca" FontSize="12" />
        <ComboBox SelectedIndex="{Binding LayoutIndex}" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="Fileira horizontal (rola pros lados)" />
          <ComboBoxItem Content="Grade vertical (rola pra cima e pra baixo)" />
        </ComboBox>
        <CheckBox IsChecked="{Binding Animations}"
                  Content="Animações (zoom no jogo selecionado e ao passar o mouse, rolagem suave)" />

        <TextBlock Text="Overlay de desempenho (estilo MangoHud, desenhado pelo RTSS)" Classes="subtle" Margin="0,12,0,0" />
        <ComboBox SelectedIndex="{Binding OverlayPresetIndex}" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="Desligado" />
          <ComboBoxItem Content="Resumido — FPS, bateria e hora" />
          <ComboBoxItem Content="Médio — GPU, CPU, RAM, bateria e FPS" />
          <ComboBoxItem Content="Completo — + VRAM, clock da CPU e consumo (W)" />
        </ComboBox>
        <TextBlock Text="{Binding OverlayStatusText, StringFormat='Agora: {0}'}" Classes="subtle" FontSize="11" />
        <TextBlock Text="No jogo: aperte L3+R3 (os dois analógicos) pra trocar. Precisa do RTSS aberto; desmarque 'Show own statistics' no RTSS pra não aparecer o FPS duplicado. Tamanho da letra: 'On-Screen Display zoom' no RTSS. Faixa preta atrás do texto: desmarque 'On-Screen Display fill' no RTSS (sem fundo)."
                   Classes="subtle"
                   FontSize="11"
                   TextWrapping="Wrap" />

        <TextBlock Text="{Binding VersionText}" Classes="subtle" Margin="0,12,0,0" />
        <Button Classes="pill"
                Content="Verificar atualizações"
                Click="OnCheckUpdatesClick"
                HorizontalAlignment="Left"
                IsVisible="{Binding UpdatesAvailable}" />
        <TextBlock Text="{Binding UpdateResultText}"
                   IsVisible="{Binding HasUpdateResult}"
                   TextWrapping="Wrap" />

        <TextBlock Text="{Binding SavedMessage}"
                   IsVisible="{Binding HasSavedMessage}"
                   TextWrapping="Wrap"
                   Foreground="#7FD88A"
                   Margin="0,8,0,0" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,20,0,0">
      <Button Classes="pill" Content="⌨ Teclado" Click="OnKeyboardClick" />
      <Button Classes="pill" Content="Fechar" Click="OnCloseClick" />
      <Button Classes="pill" Content="Salvar" Click="OnSaveClick" />
    </StackPanel>
  </Grid>
</Window>
