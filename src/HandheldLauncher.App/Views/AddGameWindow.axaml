<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HandheldLauncher.App.ViewModels"
        xmlns:views="using:HandheldLauncher.App.Views"
        x:Class="HandheldLauncher.App.Views.AddGameWindow"
        x:DataType="vm:AddGameViewModel"
        Title="Adicionar Jogo ou Programa"
        Width="600" Height="680"
        Topmost="True"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

  <Window.Styles>
    <Style Selector="TextBlock.header">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Margin" Value="0,16,0,8"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="*,Auto,Auto" Margin="24">
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="4">

        <!-- Card: Informações Básicas -->
        <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
          <StackPanel Spacing="12">
            <TextBlock Text="Nome do Jogo" Classes="header" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Title}" Watermark="Ex: Hollow Knight" Height="40" FontSize="14"/>
            <CheckBox Content="É um jogo do Xbox app / Game Pass" IsChecked="{Binding IsXboxSource}" Margin="0,4,0,0"/>
            <CheckBox Content="Adicionar como Programa (não aparece na biblioteca de jogos)" IsChecked="{Binding IsApplication}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <!-- Card: Execução -->
        <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,12">
          <StackPanel Spacing="12">
            <TextBlock Text="Arquivo Executável" Classes="header" Margin="0,0,0,4"/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Text="{Binding ExecutablePath}" Watermark="C:\Jogos\jogo.exe" Height="40" FontSize="14"/>
              <Button Grid.Column="1" Classes="pill" Content="Procurar..." Click="OnBrowseClick" Margin="8,0,0,0" Height="40"/>
            </Grid>
            
            <TextBlock Text="Argumentos (opcional)" Classes="header" Margin="0,8,0,4"/>
            <TextBox Text="{Binding LaunchArguments}" Watermark="Ex: --fullscreen" Height="40" FontSize="14"/>

            <TextBlock Text="Pasta de trabalho (opcional)" Classes="header" Margin="0,8,0,4"/>
            <TextBox Text="{Binding WorkingDirectory}" Watermark="Em branco = pasta do executável" Height="40" FontSize="14"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,20,0,0">
      <Button Classes="pill" Content="Cancelar" Click="OnCancelClick" Width="120" Height="44" FontSize="14"/>
      <Button Classes="pill primary" Content="Salvar Jogo" Click="OnAddClick" IsEnabled="{Binding CanSave}" Width="160" Height="44" FontSize="14" FontWeight="Bold"/>
    </StackPanel>

    <!-- v0.24.2: teclado do launcher (o TabTip do Windows não recebia o controle). -->
    <views:OnScreenKeyboardView Grid.Row="2" x:Name="Keyboard" Margin="-24,0,-24,-24" />

  </Grid>
</Window>