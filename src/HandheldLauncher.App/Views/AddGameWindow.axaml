<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HandheldLauncher.App.ViewModels"
        xmlns:models="using:HandheldLauncher.Core.Models"
        xmlns:views="using:HandheldLauncher.App.Views"
        x:Class="HandheldLauncher.App.Views.AddGameWindow"
        x:DataType="vm:AddGameViewModel"
        Title="{Binding WindowTitle}"
        Width="640" Height="760"
        Topmost="True"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

  <Window.Styles>
    <Style Selector="TextBlock.header">
      <Setter Property="FontSize" Value="{DynamicResource TextSubtitle}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="Margin" Value="0,16,0,8"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="{DynamicResource TextSmall}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="*,Auto,Auto" Margin="24">
    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="4">

        <!-- Card: Programas instalados (v0.25.3). 18/11: só em "Adicionar programa". -->
        <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="{DynamicResource RadiusMedium}" Padding="16" Margin="0,0,0,12"
                IsVisible="{Binding IsApplication}">
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Programas instalados" Classes="header" Margin="0"/>
              <Button Grid.Column="1" Classes="pill" Content="Atualizar" Click="OnRefreshProgramsClick" Height="32" FontSize="{DynamicResource TextSmall}" Padding="14,0"/>
            </Grid>
            <TextBlock Text="Escolhe um programa da lista ou preenche os campos abaixo à mão." Classes="label" TextWrapping="Wrap"/>
            <TextBox Text="{Binding ProgramSearch, Mode=TwoWay}" Watermark="Buscar programa instalado..." Height="38" FontSize="{DynamicResource TextBody}"/>
            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsScanningPrograms}" Height="3"/>
            <TextBlock Text="{Binding ProgramStatusText}" Classes="label" IsVisible="{Binding !IsScanningPrograms}"/>
            <ListBox x:Name="ProgramsList"
                     ItemsSource="{Binding FilteredPrograms}"
                     SelectedItem="{Binding SelectedProgram, Mode=TwoWay}"
                     Height="190" IsVisible="{Binding HasPrograms}"
                     AutoScrollToSelectedItem="True"
                     Focusable="True"
                     ScrollViewer.VerticalScrollBarVisibility="Visible"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.AllowAutoHide="False"
                     Background="Transparent" BorderThickness="0" Padding="0">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="models:InstalledProgramOption">
                  <Grid ColumnDefinitions="Auto,*" Margin="4,5">
                    <PathIcon Grid.Column="0" Width="22" Height="22"
                              Data="{StaticResource IconAppWindow}"
                              Foreground="{DynamicResource AccentBrush}" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" Spacing="1">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="{DynamicResource TextBody}" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding ExecutablePath}" FontSize="{DynamicResource TextMicro}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Text="Nenhum programa encontrado. Usa a procura ou adiciona à mão."
                       Classes="label" TextWrapping="Wrap" IsVisible="{Binding NoProgramsFound}"/>
          </StackPanel>
        </Border>

        <!-- Card: Informações Básicas -->
        <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="{DynamicResource RadiusMedium}" Padding="16" Margin="0,0,0,12">
          <StackPanel Spacing="12">
            <TextBlock Text="{Binding NameHeader}" Classes="header" Margin="0,0,0,4"/>
            <TextBox Text="{Binding Title}" Watermark="{Binding NameWatermark}" Height="40" FontSize="{DynamicResource TextBodyLarge}"/>
            <CheckBox Content="É um jogo do Xbox app / Game Pass" IsChecked="{Binding IsXboxSource}" IsVisible="{Binding IsGameMode}" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <!-- Card: Execução -->
        <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="{DynamicResource RadiusMedium}" Padding="16" Margin="0,0,0,12">
          <StackPanel Spacing="12">
            <TextBlock Text="Executável ou atalho" Classes="header" Margin="0,0,0,4"/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Text="{Binding ExecutablePath}" Watermark="C:\Jogos\jogo.exe ou um atalho (.lnk, .url)" Height="40" FontSize="{DynamicResource TextBodyLarge}"/>
              <Button Grid.Column="1" Classes="pill" Content="Procurar..." Click="OnBrowseClick" Margin="8,0,0,0" Height="40"/>
            </Grid>
            <TextBlock Text="{Binding ShortcutNote}" Classes="label" TextWrapping="Wrap" IsVisible="{Binding HasShortcutNote}"/>
            <TextBlock Text="Atalho ou endereço: abre pelo Windows. Argumentos, pasta e arquivo do jogo não são usados."
                       Classes="label" TextWrapping="Wrap" IsVisible="{Binding OpensThroughWindows}"/>

            <!-- 18/11: jogo de emulador (ex.: Ryujinx.exe acima + arquivo do jogo aqui). -->
            <StackPanel Spacing="4" IsVisible="{Binding IsGameMode}">
              <TextBlock Text="Arquivo do jogo (emulador, opcional)" Classes="header" Margin="0,8,0,4"/>
              <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding !OpensThroughWindows}">
                <TextBox Grid.Column="0" Text="{Binding GameFilePath}" Watermark="Ex: E:\Switch\jogo.nsp" Height="40" FontSize="{DynamicResource TextBodyLarge}"/>
                <Button Grid.Column="1" Classes="pill" Content="Procurar..." Click="OnBrowseGameFileClick" Margin="8,0,0,0" Height="40"/>
              </Grid>
              <TextBlock Text="Escolha o emulador acima e o arquivo do jogo aqui. Ele vai no fim dos argumentos." Classes="label" TextWrapping="Wrap"/>
            </StackPanel>
            
            <TextBlock Text="Argumentos (opcional)" Classes="header" Margin="0,8,0,4"/>
            <TextBox Text="{Binding LaunchArguments}" Watermark="Ex: --fullscreen" Height="40" FontSize="{DynamicResource TextBodyLarge}"/>

            <TextBlock Text="Pasta de trabalho (opcional)" Classes="header" Margin="0,8,0,4"/>
            <TextBox Text="{Binding WorkingDirectory}" Watermark="Em branco = pasta do executável" Height="40" FontSize="{DynamicResource TextBodyLarge}"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,20,0,0">
      <Button Classes="pill" Content="Cancelar" Click="OnCancelClick" Width="120" Height="44" FontSize="{DynamicResource TextBodyLarge}"/>
      <Button Classes="pill primary" Content="{Binding SaveLabel}" Click="OnAddClick" IsEnabled="{Binding CanSave}" Width="160" Height="44" FontSize="{DynamicResource TextBodyLarge}" FontWeight="Bold"/>
    </StackPanel>

    <!-- v0.24.2: teclado do launcher (o TabTip do Windows não recebia o controle). -->
    <views:OnScreenKeyboardView Grid.Row="2" x:Name="Keyboard" Margin="-24,0,-24,-24" />

  </Grid>
</Window>