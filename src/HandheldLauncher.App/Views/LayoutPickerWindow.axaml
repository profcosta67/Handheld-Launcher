<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HandheldLauncher.App.Views.LayoutPickerWindow"
        Title="Layout da tela"
        Width="560" Height="620"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

  <!--
    v0.9.21, pedido do usuário: "acho que ficou complicado a mudança, acho
    que deveria vir em configurações / layout aí abrir uma tela popup com
    as duas opções selecionar uma delas e pedir pra confirmar, confirmando
    já reinicia o Launcher".

    Antes era um ComboBox perdido no meio da aba Aparência, e o usuário
    tinha que descobrir sozinho que precisava fechar e abrir o launcher pra
    ver efeito. Aqui a escolha é explícita, a consequência está escrita no
    botão ("Aplicar e reiniciar") e o reinício acontece sozinho (ver
    Platform/LauncherRestart).

    Sem ViewModel própria: opções simples de layout.
  -->

  <Grid RowDefinitions="Auto,*,Auto" Margin="24">
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="Escolha o layout da tela principal"
                 Classes="subtle"
                 TextWrapping="Wrap" />
      <TextBlock Text="Cada tema muda o visual, os ícones e a disposição da biblioteca. O Cartoon também tem versão clara em Configurações → Aparência."
                 Classes="subtle" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="16">
      <RadioButton x:Name="ClassicOption" GroupName="Layout" IsChecked="True">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Width="18" Height="18" Data="{StaticResource IconGamepad}" VerticalAlignment="Center" />
            <TextBlock Text="Clássico" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="Banner grande em cima, abas de filtro no meio e as capas embaixo. Permite grade vertical."
                     Classes="subtle" FontSize="11" TextWrapping="Wrap" MaxWidth="400" />
        </StackPanel>
      </RadioButton>

      <RadioButton x:Name="SwitchOption" GroupName="Layout">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Width="18" Height="18" Data="{StaticResource IconGrid}" VerticalAlignment="Center" />
            <TextBlock Text="Clean" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="Visual clean com arte do jogo em foco, carrossel horizontal centralizado e filtros na parte inferior."
                     Classes="subtle" FontSize="11" TextWrapping="Wrap" MaxWidth="400" />
        </StackPanel>
      </RadioButton>

      <RadioButton x:Name="BigScreenOption" GroupName="Layout">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Width="18" Height="18" Data="{StaticResource IconMonitor}" VerticalAlignment="Center" />
            <TextBlock Text="BigScreen" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="Experiência imersiva para controle: jogo em destaque, carrossel de capas ampliado e navegação inspirada em consoles." Classes="subtle" FontSize="11" TextWrapping="Wrap" MaxWidth="440" />
        </StackPanel>
      </RadioButton>

      <!-- v0.25.2: identidade fechada — cores, fonte, som e fileira são do tema -->
      <RadioButton x:Name="CartoonOption" GroupName="Layout">
        <StackPanel Spacing="4">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Width="18" Height="18" Data="{StaticResource IconStar}" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
            <TextBlock Text="Cartoon" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="Estúdio de desenho animado dos anos 90/00: moldura de tinta, capas tortas, splats, onomatopeias e ícones desenhados à mão. Cores, fonte (Fredoka), som (Bolha) e a fileira horizontal são exclusivos do tema." Classes="subtle" FontSize="11" TextWrapping="Wrap" MaxWidth="440" />
        </StackPanel>
      </RadioButton>
    </StackPanel>

    <StackPanel Grid.Row="2" Spacing="10" Margin="0,16,0,0">
      <TextBlock Text="O launcher vai fechar e abrir sozinho para aplicar. Nenhum jogo aberto é fechado por isso, mas evite trocar com um jogo rodando."
                 Classes="subtle" FontSize="11" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Classes="pill" Content="Cancelar" Click="OnCancelClick" />
        <Button Classes="pill primary" Content="Aplicar e reiniciar" Click="OnApplyClick" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
