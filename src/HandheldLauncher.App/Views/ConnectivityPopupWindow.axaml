<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HandheldLauncher.App.Views.ConnectivityPopupWindow"
        Title="Conectividade"
        Width="480" Height="520"
        MinWidth="460" MinHeight="500"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="#10131C"
        Topmost="True">
  <Border Padding="28" Background="#10131C" BorderBrush="#394257" BorderThickness="1" CornerRadius="18">
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
      
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
        <StackPanel Spacing="4">
          <TextBlock Text="Conectividade" FontSize="24" FontWeight="Bold" Foreground="#F5F7FF"/>
          <TextBlock Text="Controles rápidos do Handheld Launcher" FontSize="12" Foreground="#9BA8C4"/>
        </StackPanel>
        <Button x:Name="BtnClose" Grid.Column="1" Content="✕" Width="38" Height="38"/>
      </Grid>

      <Border Grid.Row="1" Background="#202638" CornerRadius="12" Padding="16" Margin="0,0,0,16">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="Wi-Fi" FontSize="18" FontWeight="Bold" Foreground="#F5F7FF"/>
            <TextBlock x:Name="WifiStatusText" Text="Verificando..." Foreground="#9BA8C4" FontSize="12"/>
          </StackPanel>
          <Button x:Name="BtnOpenWifi" Grid.Column="1" Classes="pill primary" Content="Abrir Wi-Fi do Windows" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <Border Grid.Row="2" Background="#202638" CornerRadius="12" Padding="16" Margin="0,0,0,16">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Spacing="4" VerticalAlignment="Center">
            <TextBlock Text="Bluetooth" FontSize="18" FontWeight="Bold" Foreground="#F5F7FF"/>
            <TextBlock x:Name="BluetoothStatusText" Text="Verificando..." Foreground="#9BA8C4" FontSize="12"/>
          </StackPanel>
          <Button x:Name="BtnOpenBluetooth" Grid.Column="1" Classes="pill primary" Content="Abrir Bluetooth do Windows" VerticalAlignment="Center"/>
        </Grid>
      </Border>

      <Border Grid.Row="3" Background="#202638" CornerRadius="12" Padding="16">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="Dispositivos Bluetooth" FontSize="15" FontWeight="SemiBold" Foreground="#F5F7FF" VerticalAlignment="Center"/>
            <Button x:Name="BtnRefreshBluetooth" Grid.Column="1" Classes="pill" Content="Atualizar" Padding="8,4"/>
          </Grid>
          <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="BluetoothDevicesText" Text="Nenhum dispositivo encontrado." Foreground="#D1D8E8" FontSize="12" TextWrapping="Wrap"/>
          </ScrollViewer>
        </StackPanel>
      </Border>

      <Button x:Name="BtnDownloads" Grid.Row="4" Content="⇩  Downloads" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,14,0,0" Classes="pill"/>
      <TextBlock x:Name="FeedbackText" Grid.Row="4" Margin="0,52,0,0" Text="" Foreground="#9BA8C4" FontSize="11" VerticalAlignment="Bottom" Margin="0,16,0,0" TextWrapping="Wrap"/>
    </Grid>
  </Border>
</Window>