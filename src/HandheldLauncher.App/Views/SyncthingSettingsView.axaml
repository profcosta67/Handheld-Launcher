<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HandheldLauncher.App.ViewModels"
             x:Class="HandheldLauncher.App.Views.SyncthingSettingsView"
             x:DataType="vm:SettingsViewModel">

  <!-- WebView nativo ocupando 100% da área. Fica por cima do resto das
       Configurações (controle nativo não respeita z-order do Avalonia) e só
       é criado quando a tela abre — ver IsSyncthingOpen no SettingsViewModel. -->
  <Grid RowDefinitions="Auto,*" Background="{DynamicResource BackgroundBrush}">

    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" Margin="16,12,16,8">
      <Button Grid.Column="0" Classes="pill" Content="← Voltar" Click="OnBackClick" />
      <TextBlock Grid.Column="1" Text="Central de Saves · Syncthing"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="13" FontWeight="Bold" Opacity="0.75" />
      <ToggleSwitch Grid.Column="2" x:Name="SyncToggle"
                    IsChecked="{Binding SyncthingEnabled}"
                    OnContent="Sincronização ativa" OffContent="Sincronização desligada"
                    VerticalAlignment="Center" Margin="0,0,16,0"
                    IsCheckedChanged="OnSyncToggleChanged" />
      <TextBlock Grid.Column="3" Text="127.0.0.1:8384"
                 VerticalAlignment="Center" FontSize="11" Opacity="0.45" />
    </Grid>

    <NativeWebView Grid.Row="1" x:Name="Browser"
                   HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
  </Grid>
</UserControl>
