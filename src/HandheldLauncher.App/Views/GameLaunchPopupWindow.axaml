<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HandheldLauncher.App.Views.GameLaunchPopupWindow"
        Title="Abrindo"
        Width="380" Height="120"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        CanResize="False">

    <Border Background="#F01A1A1A"
            CornerRadius="16"
            BorderBrush="#444444"
            BorderThickness="1"
            Padding="20">
        <Grid ColumnDefinitions="64,*,40">
            <Border Grid.Column="0"
                    Width="56" Height="56"
                    CornerRadius="12"
                    Background="#252A36"
                    VerticalAlignment="Center">
                <Grid>
                    <Image x:Name="GameIcon" Stretch="UniformToFill"/>
                    <TextBlock x:Name="TxtIconFallback"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="#7C5CFC"
                               IsVisible="False"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="4" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtGameTitle"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"/>
                <TextBlock Text="Abrindo..." Foreground="#AAAAAA" FontSize="12"/>
            </StackPanel>

            <TextBlock Grid.Column="2"
                       Text="⚡"
                       FontSize="22"
                       Foreground="#7C5CFC"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>