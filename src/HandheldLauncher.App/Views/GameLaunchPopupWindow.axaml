<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HandheldLauncher.App.Views.GameLaunchPopupWindow"
        Title="Abrindo"
        Width="380" Height="120"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        CanResize="False">

    <Border Background="#F01A1A1A"
            CornerRadius="{DynamicResource RadiusLarge}"
            BorderBrush="#444444"
            BorderThickness="1"
            Padding="20">
        <Grid ColumnDefinitions="64,*,40">
            <Border Grid.Column="0"
                    Width="56" Height="56"
                    CornerRadius="{DynamicResource RadiusMedium}"
                    Background="{DynamicResource PanelSurfaceAltBrush}"
                    VerticalAlignment="Center">
                <Grid>
                    <Image x:Name="GameIcon" Stretch="UniformToFill"/>
                    <TextBlock x:Name="TxtIconFallback"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="{DynamicResource TextDisplay}"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               IsVisible="False"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="4" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtGameTitle"
                           Foreground="White"
                           FontSize="{DynamicResource TextSubtitle}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="1"/>
                <TextBlock Text="Abrindo..." Foreground="#AAAAAA" FontSize="{DynamicResource TextSmall}"/>
            </StackPanel>

            <TextBlock Grid.Column="2"
                       x:Name="TxtLoadingSpinner" Text="◐"
                       FontSize="{DynamicResource TextHeadingLarge}"
                       Foreground="{DynamicResource AccentBrush}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>