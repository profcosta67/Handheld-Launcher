<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HandheldLauncher.App.ViewModels"
        xmlns:conv="using:HandheldLauncher.App.Converters"
        xmlns:dataConv="using:Avalonia.Data.Converters"
        x:Class="HandheldLauncher.App.Views.GameDetailsWindow"
        x:DataType="vm:GameDetailsViewModel"
        Title="Detalhes do jogo"
        Width="1100" Height="700"
        CanResize="False"
        SystemDecorations="None"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BackgroundBrush}">

  <Window.Resources>
    <DataTemplate x:Key="AchievementRowTemplate" x:DataType="vm:AchievementItemViewModel">
      <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="12" Padding="12" Margin="0,0,0,8" Opacity="{Binding RowOpacity}">
        <Grid ColumnDefinitions="56,*">
          <Border Width="48" Height="48" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Top">
            <Image Source="{Binding IconLocalPath, Converter={x:Static conv:FileToBitmapConverter.Instance}}" Stretch="UniformToFill" />
          </Border>
          <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding DescriptionText}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource AccentBrush}" FontSize="12" FontWeight="SemiBold" />
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Border.infoChip">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="Margin" Value="0,0,8,6" />
    </Style>
    <Style Selector="Border.infoChip TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Border.buttonGlyph">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Padding" Value="6,0" />
    </Style>
    <Style Selector="Border.buttonGlyph TextBlock">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto">

    <!-- ===== Cabeçalho: banner + capa + logo + faixa de informações ===== -->
    <Panel Grid.Row="0" Height="220" ClipToBounds="True">
      <Image Source="{Binding BannerImagePath, Converter={x:Static conv:FileToBitmapConverter.Instance}}"
             Stretch="UniformToFill" VerticalAlignment="Center"
             IsVisible="{Binding BannerImagePath, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}" />
      <Border Background="{DynamicResource BackgroundBrush}">
        <Border.OpacityMask>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#33000000" Offset="0" />
            <GradientStop Color="#AA000000" Offset="0.55" />
            <GradientStop Color="#FF000000" Offset="1" />
          </LinearGradientBrush>
        </Border.OpacityMask>
      </Border>

      <Grid ColumnDefinitions="Auto,*,Auto" Margin="28,0,28,14" VerticalAlignment="Bottom">
        <Border Grid.Column="0" Width="104" Height="156" CornerRadius="10" ClipToBounds="True"
                Background="{DynamicResource SurfaceRaisedBrush}" VerticalAlignment="Bottom">
          <Image Source="{Binding CoverImagePath, Converter={x:Static conv:FileToBitmapConverter.Instance}}" Stretch="UniformToFill" />
        </Border>

        <StackPanel Grid.Column="1" Margin="20,0,0,0" Spacing="8" VerticalAlignment="Bottom">
          <Panel HorizontalAlignment="Left">
            <Image Source="{Binding LogoImagePath, Converter={x:Static conv:FileToBitmapConverter.Instance}}"
                   Stretch="Uniform" MaxHeight="72" MaxWidth="420" HorizontalAlignment="Left"
                   IsVisible="{Binding LogoImagePath, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}" />
            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeTitle}" FontWeight="Bold" TextWrapping="Wrap" MaxLines="2"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       IsVisible="{Binding LogoImagePath, Converter={x:Static dataConv:ObjectConverters.IsNull}}" />
          </Panel>

          <WrapPanel Orientation="Horizontal">
            <Border Classes="infoChip"><TextBlock Text="{Binding PlatformText}" /></Border>
            <Border Classes="infoChip"><TextBlock><Run Text="Tamanho: " /><Run Text="{Binding SizeText}" /></TextBlock></Border>
            <Border Classes="infoChip"><TextBlock><Run Text="Última vez: " /><Run Text="{Binding LastPlayedText}" /></TextBlock></Border>
            <Border Classes="infoChip"><TextBlock><Run Text="Tempo total: " /><Run Text="{Binding TotalPlaytimeText}" /></TextBlock></Border>
          </WrapPanel>
        </StackPanel>

        <TextBlock Grid.Column="2" Text="{Binding FavoriteBadge}" Foreground="{DynamicResource AccentBrush}"
                   FontWeight="Bold" FontSize="16" VerticalAlignment="Top" Margin="12,0,0,0" />
      </Grid>
    </Panel>

    <!-- ===== Abas das seções (LB/RB) ===== -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="28,10,28,10">
      <Border Classes="buttonGlyph" VerticalAlignment="Center"><TextBlock Text="LB" /></Border>
      <Button Classes="pill filterTab" Classes.active="{Binding IsOverviewSection}" Content="Visão geral" Tag="0" Click="OnSectionClick" Focusable="False" />
      <Button Classes="pill filterTab" Classes.active="{Binding IsAchievementsSection}" Content="Conquistas" Tag="1" Click="OnSectionClick" Focusable="False" />
      <Button Classes="pill filterTab" Classes.active="{Binding IsMediaSection}" Content="Mídia" Tag="2" Click="OnSectionClick" Focusable="False" />
      <Button Classes="pill filterTab" Classes.active="{Binding IsPerformanceSection}" Content="Desempenho" Tag="3" Click="OnSectionClick" Focusable="False" />
      <Button Classes="pill filterTab" Classes.active="{Binding IsFilesSection}" Content="Arquivos" Tag="4" Click="OnSectionClick" Focusable="False" />
      <Border Classes="buttonGlyph" VerticalAlignment="Center"><TextBlock Text="RB" /></Border>
    </StackPanel>

    <!-- ===== Conteúdo da seção ===== -->
    <ScrollViewer x:Name="ContentScroll" Grid.Row="2" Margin="28,0,28,0"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <Panel Margin="0,4,0,20">

        <!-- Visão geral -->
        <StackPanel Spacing="14" IsVisible="{Binding IsOverviewSection}">
          <TextBlock Text="Carregando informações..." Classes="subtle" IsVisible="{Binding IsLoading}" />
          <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="{DynamicResource FontSizeBody}"
                     Foreground="{DynamicResource TextPrimaryBrush}" LineHeight="22" />
          <ItemsControl ItemsSource="{Binding Tags}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DetailsTagItem">
                <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="8" Padding="10,4" Margin="0,0,8,8">
                  <TextBlock Text="{Binding Text}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="14" Padding="18" IsVisible="{Binding HasLongDescription}">
            <TextBlock Text="{Binding LongDescription}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="21" />
          </Border>
        </StackPanel>

        <!-- Aba Conquistas (CORRIGIDA AQUI) -->
        <StackPanel Spacing="16" IsVisible="{Binding IsAchievementsSection}">
          <!-- Status -->
          <TextBlock Text="{Binding AchievementsStatusText}" 
                     FontSize="14" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>

          <!-- Barra de Progresso -->
          <ProgressBar Value="{Binding AchievementProgress}" 
                       Maximum="100" 
                       Height="8" 
                       CornerRadius="4" 
                       Foreground="{DynamicResource AccentBrush}"
                       Background="{DynamicResource SurfaceRaisedBrush}"/>

          <!-- Seção "Próximas conquistas" (Corrigida) -->
<StackPanel IsVisible="{Binding HasNextAchievements}" Spacing="8">
    <TextBlock Text="🎯 Mais próximas de desbloquear" FontSize="14" FontWeight="SemiBold" 
               Foreground="{DynamicResource TextPrimaryBrush}"/>
    <ItemsControl ItemsSource="{Binding NextAchievements}">
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AchievementItemViewModel">
                <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,4">
                    <Grid ColumnDefinitions="Auto, *">
                        
                        <!-- Ícone da Conquista (Cinza, pois está bloqueada) -->
                        <Border Grid.Column="0" Width="32" Height="32" 
                                CornerRadius="4" Margin="0,0,12,0" 
                                Background="{DynamicResource BackgroundBrush}"
                                ClipToBounds="True">
                            <Image Source="{Binding IconLocalPath, Converter={x:Static conv:FileToBitmapConverter.Instance}}" 
                                   Stretch="UniformToFill"/>
                        </Border>
                        
                        <!-- Textos -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" 
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="11" 
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</StackPanel>

          <!-- Lista Completa -->
          <ItemsControl ItemsSource="{Binding Achievements}" ItemTemplate="{StaticResource AchievementRowTemplate}" />
        </StackPanel>

        <!-- Mídia -->
        <StackPanel Spacing="12" IsVisible="{Binding IsMediaSection}">
          <TextBlock Text="{Binding MediaStatusText}" Classes="subtle" TextWrapping="Wrap"
                     IsVisible="{Binding MediaStatusText, Converter={x:Static dataConv:StringConverters.IsNotNullOrEmpty}}" />
          <ItemsControl ItemsSource="{Binding Screenshots}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DetailsImageItem">
                <Border Width="340" Height="191" CornerRadius="12" ClipToBounds="True" Margin="0,0,12,12"
                        Background="{DynamicResource SurfaceRaisedBrush}">
                  <Image Source="{Binding Path, Converter={x:Static conv:FileToBitmapConverter.Instance}}" Stretch="UniformToFill" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Classes="subtle" TextWrapping="Wrap" IsVisible="{Binding HasTrailerOrStorePage}"
                     Text="Y abre a página do jogo na loja da Steam, onde o trailer toca (fecha o navegador pra voltar)." />
        </StackPanel>

        <!-- Desempenho -->
        <StackPanel Spacing="12" IsVisible="{Binding IsPerformanceSection}">
          <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="14" Padding="18">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Tempo medido pelo launcher" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding LauncherPlaytimeText}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasTrailerOrStorePage}">
                <TextBlock Text="Horas na Steam" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding PlaytimeText}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
              </Grid>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Última vez aberto pelo launcher" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding LastPlayedText}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
              </Grid>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="14" Padding="18">
            <TextBlock Classes="subtle" TextWrapping="Wrap"
                       Text="Receita do jogo, FPS médio, consumo e previsão de bateria por jogo chegam com as Receitas (v0.20) — esta seção já fica pronta pra recebê-los." />
          </Border>
        </StackPanel>

        <!-- Arquivos -->
        <StackPanel Spacing="12" IsVisible="{Binding IsFilesSection}">
          <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="14" Padding="18">
            <StackPanel Spacing="6">
              <TextBlock Text="Pasta do jogo" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="{Binding GameFolderText}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Margin="0,6,0,0" Foreground="{DynamicResource TextPrimaryBrush}"><Run Text="Espaço ocupado: " /><Run Text="{Binding SizeText}" FontWeight="Bold" /></TextBlock>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="14" Padding="18">
            <StackPanel Spacing="6">
              <TextBlock Text="Pasta de saves" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
              <TextBlock Text="{Binding SaveFolderText}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Text="{Binding SaveFolderHint}" TextWrapping="Wrap" Classes="subtle" FontSize="12" />
            </StackPanel>
          </Border>
          <TextBlock Classes="subtle" TextWrapping="Wrap"
                     Text="Pra mover o jogo de disco, use 💾 Armazenamento no menu principal (botão Start)." />
        </StackPanel>

      </Panel>
    </ScrollViewer>

    <!-- ===== Barra de ações (controle + toque) ===== -->
    <Border Grid.Row="3" Background="{DynamicResource BarBrush}" Padding="20,10">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="{Binding DataSourceNote}" Classes="subtle" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Classes="pill primary" Click="OnPlayClick" Focusable="False">
            <StackPanel Orientation="Horizontal" Spacing="8"><Border Classes="buttonGlyph"><TextBlock Text="A" /></Border><TextBlock Text="Jogar" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button Classes="pill" Click="OnFavoriteClick" Focusable="False">
            <StackPanel Orientation="Horizontal" Spacing="8"><Border Classes="buttonGlyph"><TextBlock Text="X" /></Border><TextBlock Text="{Binding FavoriteLabel}" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button Classes="pill" Click="OnSectionActionClick" Focusable="False" IsVisible="{Binding HasSectionAction}">
            <StackPanel Orientation="Horizontal" Spacing="8"><Border Classes="buttonGlyph"><TextBlock Text="Y" /></Border><TextBlock Text="{Binding SectionActionLabel}" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button Classes="pill" Click="OnOptionsClick" Focusable="False">
            <StackPanel Orientation="Horizontal" Spacing="8"><Border Classes="buttonGlyph"><TextBlock Text="☰" /></Border><TextBlock Text="Mais opções" VerticalAlignment="Center" /></StackPanel>
          </Button>
          <Button Classes="pill" Click="OnCloseClick" Focusable="False">
            <StackPanel Orientation="Horizontal" Spacing="8"><Border Classes="buttonGlyph"><TextBlock Text="B" /></Border><TextBlock Text="Voltar" VerticalAlignment="Center" /></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>