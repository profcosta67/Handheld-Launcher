<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HandheldLauncher.App.Views.RecordingOverlayWindow"
        Title="Handheld Launcher — gravação"
        Width="420" Height="260"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        CanResize="False">

  <Grid>
    <!-- Contagem antes de começar a gravar: 3, 2, 1 no meio da tela -->
    <Border x:Name="CountdownBox" IsVisible="False"
            Width="200" Height="200"
            CornerRadius="100"
            Background="#99000000"
            BorderBrush="#66FFFFFF"
            BorderThickness="2"
            HorizontalAlignment="Center" VerticalAlignment="Center">
      <TextBlock x:Name="TxtCountdown" Text="3"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="120" FontWeight="Bold" Foreground="White" />
    </Border>

    <!-- Aviso de que está gravando (fica enquanto a gravação durar) -->
    <Border x:Name="BadgeBox" IsVisible="False"
            CornerRadius="18"
            Background="#D9C0241C"
            BorderBrush="#66FFFFFF"
            BorderThickness="1"
            Padding="14,7"
            HorizontalAlignment="Center" VerticalAlignment="Top">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Ellipse x:Name="BadgeDot" Width="12" Height="12" Fill="White" VerticalAlignment="Center" />
        <TextBlock x:Name="TxtBadge" Text="GRAVANDO" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
