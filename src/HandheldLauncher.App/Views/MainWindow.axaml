<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:anim="https://github.com/whistyun/AnimatedImage.Avalonia"
        xmlns:vm="using:HandheldLauncher.App.ViewModels"
        xmlns:models="using:HandheldLauncher.Core.Models"
        xmlns:conv="using:HandheldLauncher.App.Converters"
        xmlns:dataConv="using:Avalonia.Data.Converters"
        xmlns:media="using:Avalonia.Media"
        x:Class="HandheldLauncher.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Handheld Launcher"
        Icon="avares://HandheldLauncher/Assets/app-icon.ico"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Focusable="True"
        >

  <Window.Resources>
    <conv:FileToBitmapConverter x:Key="FileToBitmapConverter" />
    <conv:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
  </Window.Resources>

  <Window.Styles>
    <!-- Botões de ação da barra inferior (⚙, ⏻, —) -->
    <Style Selector="Button.switchAction">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="42" />
      <Setter Property="MinWidth" Value="46" />
      <Setter Property="MinHeight" Value="42" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="#252A36" />
      <Setter Property="Foreground" Value="#F3F5FA" />
      <Setter Property="BorderBrush" Value="#424A5D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource FontSizeMenuHeader}" />
    </Style>
    <Style Selector="Button.switchAction:pointerover">
      <Setter Property="Background" Value="#343C50" />
      <Setter Property="BorderBrush" Value="#6579E8" />
    </Style>
    <Style Selector="Button.switchAction /template/ ContentPresenter">
      <Setter Property="Background" Value="#252A36" />
      <Setter Property="Foreground" Value="#F3F5FA" />
      <Setter Property="BorderBrush" Value="#424A5D" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
  </Window.Styles>

  <Panel>

    <!-- Full-window backdrop -->
    <Panel>
      <Image Source="{Binding SelectedTile.BannerImagePath, Converter={StaticResource FileToBitmapConverter}}"
             Stretch="UniformToFill"
             IsVisible="{Binding SelectedTile.BannerImagePath, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}">
        <Image.Effect>
          <media:BlurEffect Radius="60" />
        </Image.Effect>
      </Image>
      <Border Background="{StaticResource BackdropDimBrush}" />
    </Panel>

  <Grid RowDefinitions="Auto,*,Auto" Margin="0">

    <!-- Top bar -->
    <Border Grid.Row="0" Classes="topBar" Margin="24,20,24,0" Padding="20,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
          <Image Source="avares://HandheldLauncher/Assets/app-icon.ico" Width="22" Height="22" VerticalAlignment="Center" />
          <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Handheld Launcher" Classes="gameTitle" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="28">
          <Button Classes="iconGhost"
                  VerticalAlignment="Center"
                  Content="{Binding UpdateStatusText}"
                  FontSize="{DynamicResource FontSizeCaption}"
                  Foreground="{StaticResource AccentBrush}"
                  IsVisible="{Binding HasUpdateStatus}"
                  Click="OnUpdateBadgeClick" />
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                      ToolTip.Tip="{Binding TopBarDownloadToolTip}">
            <Grid VerticalAlignment="Center">
              <Button Classes="iconGhost"
                      Content="⇩"
                      FontSize="{DynamicResource FontSizeBody}"
                      Click="OnDownloadsShortcutClick" />
              <Ellipse Width="8" Height="8"
                       Fill="{StaticResource AccentBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,-2,-2,0"
                       IsHitTestVisible="False"
                       IsVisible="{Binding HasActiveDownloads}" />
            </Grid>

            <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center"
                        IsVisible="{Binding HasActiveDownloads}">
              <TextBlock Text="{Binding TopBarDownloadPercentText}"
                         Classes="subtle"
                         FontSize="{DynamicResource FontSizeCaption}"
                         HorizontalAlignment="Center" />
              <ProgressBar Minimum="0" Maximum="100"
                           Value="{Binding TopBarDownloadPercent}"
                           Width="44" Height="3" MinHeight="3"
                           Foreground="{StaticResource AccentBrush}" />
            </StackPanel>

            <Border BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Width="18" Height="18"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
              <TextBlock Text="Y" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Bold"
                         Foreground="{StaticResource AccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding BatteryStatusText}" Classes="subtle" FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding ClockText}" Classes="subtle" FontSize="{DynamicResource FontSizeCaption}" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <ContentControl x:Name="LibraryLayoutHost" Grid.Row="1" />

    <!-- Bottom bar -->
    <Border Grid.Row="2" Classes="bottomBar" Margin="24,0,24,20" Padding="18,10">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
        <TextBlock Grid.Column="0"
                   Text="{Binding AppVersionText}"
                   Classes="subtle"
                   FontSize="{DynamicResource FontSizeCaption}"
                   Opacity="0.7"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Classes="pill"
                Content="{Binding RunningGame.Title, StringFormat='Fechar: {0}'}"
                Click="OnCloseGameClick"
                IsVisible="{Binding RunningGame, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}"
                Margin="0,0,10,0" />
        <Button Grid.Column="2"
                Classes="switchAction"
                Content="—"
                Click="OnMinimizeClick"
                ToolTip.Tip="Minimizar — envia para a bandeja do Windows. Reabra pelo ícone da bandeja ou Ctrl+Alt+H."
                Margin="0,0,8,0" />
        <Button Grid.Column="3"
                Classes="switchAction"
                Content="⚙"
                Click="OnGearMenuClick"
                ToolTip.Tip="Configurações e ferramentas"
                Margin="0,0,8,0" />
        <Button Grid.Column="4"
                Classes="switchAction"
                Content="⏻"
                Click="OnPowerMenuClick"
                ToolTip.Tip="Energia" />
      </Grid>
    </Border>

  </Grid>

    <!-- Start-button context menu -->
    <Panel Classes="fadeIn" IsVisible="{Binding IsContextMenuOpen}">
      <Border Classes="contextMenuOverlay" PointerPressed="OnMenuOverlayPressed" />
      <Border Classes="contextMenuCard" Width="460" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <Border Classes="menuHeader">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
              <Image Source="{Binding ContextMenuTarget.IconImagePath, Converter={StaticResource FileToBitmapConverter}}"
                     IsVisible="{Binding ContextMenuTarget.IconImagePath, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}"
                     Width="36" Height="36" Stretch="Uniform" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ContextMenuTarget.Title}" Classes="menuHeaderTitle" FontSize="{DynamicResource FontSizeMenuHeader}" TextWrapping="Wrap" MaxWidth="340" />
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding ContextMenuItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ContextMenuItemViewModel">
                <Border Classes="menuItem" Classes.selected="{Binding IsSelected}" Classes.danger="{Binding IsDanger}" Padding="16,12"
                        Cursor="Hand"
                        PointerPressed="OnContextMenuItemPressed">
                  <TextBlock Text="{Binding Label}" Classes="gameTitle" FontSize="{DynamicResource FontSizeBody}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Panel>

    <!-- Global menu -->
    <Panel Classes="fadeIn" IsVisible="{Binding IsGlobalMenuOpen}">
      <Border Classes="contextMenuOverlay" PointerPressed="OnMenuOverlayPressed" />
      <Border Classes="contextMenuCard" Width="420" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <Border Classes="menuHeader">
            <TextBlock Text="{Binding GlobalMenuTitle}" Classes="menuHeaderTitle" FontSize="{DynamicResource FontSizeMenuHeader}" HorizontalAlignment="Center" />
          </Border>
          <ItemsControl ItemsSource="{Binding GlobalMenuItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ContextMenuItemViewModel">
                <Border Classes="menuItem" Classes.selected="{Binding IsSelected}" Classes.danger="{Binding IsDanger}" Padding="16,12"
                        Cursor="Hand"
                        PointerPressed="OnGlobalMenuItemPressed">
                  <TextBlock Text="{Binding Label}" Classes="gameTitle" FontSize="{DynamicResource FontSizeBody}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding GlobalMenuHint}" Classes="subtle" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding HasGlobalMenuHint}" />
        </StackPanel>
      </Border>
    </Panel>

    <!-- Painel de Downloads -->
    <Panel Classes="fadeIn" IsVisible="{Binding IsDownloadsOpen}">
      <Border Classes="contextMenuOverlay" PointerPressed="OnMenuOverlayPressed" />
      <Border Classes="contextMenuCard" Width="560" MaxHeight="620" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Downloads (Steam)" Classes="heroTitle" FontSize="{DynamicResource FontSizeTitle}" />
            <Button Grid.Column="1" Classes="pill" Content="✕" Padding="10,4" Click="OnCloseDownloadsClick" ToolTip.Tip="Fechar" />
          </Grid>

          <ScrollViewer Grid.Row="1" MaxHeight="380" Margin="0,16,0,0">
            <StackPanel Spacing="10">
              <TextBlock Text="Nada baixando no momento." Classes="subtle" FontSize="{DynamicResource FontSizeBody}" IsVisible="{Binding NoActiveDownloads}" />
              <ItemsControl ItemsSource="{Binding ActiveDownloads}" IsVisible="{Binding HasActiveDownloads}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:DownloadProgressInfo">
                    <StackPanel Spacing="4" Margin="0,0,0,12">
                      <TextBlock Text="{Binding Title}" Classes="gameTitle" FontSize="{DynamicResource FontSizeBody}" />
                      <ProgressBar Minimum="0" Maximum="100" Value="{Binding PercentComplete}" />
                      <TextBlock Text="{Binding DetailText}" Classes="subtle" FontSize="{DynamicResource FontSizeCaption}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <Button Grid.Row="2"
                  Classes="pill"
                  Content="Abrir downloads na Steam (pausar/retomar)"
                  HorizontalAlignment="Left"
                  Margin="0,12,0,0"
                  Click="OnOpenSteamDownloadsClick" />

          <TextBlock Grid.Row="3" Text="A abre os downloads na Steam · Y/B fecha · jogos da conta ficam na aba Não instalados" Classes="subtle" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" Margin="0,12,0,0" />
        </Grid>
      </Border>
    </Panel>

    <!-- Cover/banner picker -->
    <Panel Classes="fadeIn" IsVisible="{Binding IsCoverPickerOpen}">
      <Border Classes="contextMenuOverlay" PointerPressed="OnMenuOverlayPressed" />
      
      <Border Classes="contextMenuCard" Width="880" MaxHeight="620" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#1E1E2E">
        <Grid RowDefinitions="Auto,*,Auto">
          
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBlock Grid.Column="0" Text="{Binding CoverPickerTitle}" Classes="heroTitle" Foreground="White" FontSize="{DynamicResource FontSizeTitle}" TextWrapping="Wrap" VerticalAlignment="Center" />
            
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="Só animadas" Foreground="LightGray" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}" />
              <ToggleSwitch IsChecked="{Binding FilterAnimatedOnly}" OnContent="" OffContent="" HorizontalAlignment="Right" />
            </StackPanel>
          </Grid>

          <TextBlock Grid.Row="1" Text="Buscando opções no SteamGridDB..." Foreground="LightGray"
                     FontSize="{DynamicResource FontSizeBody}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding IsCoverPickerLoading}" />

          <TextBlock Grid.Row="1" Text="Nenhuma opção estática encontrada para esse jogo." Foreground="LightGray"
                     FontSize="{DynamicResource FontSizeBody}"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding CoverPickerIsEmpty}" />

          <TextBlock Grid.Row="1" Text="{Binding CoverPickerErrorMessage}" Foreground="LightGray"
                     FontSize="{DynamicResource FontSizeBody}"
                     TextWrapping="Wrap" TextAlignment="Center"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20"
                     IsVisible="{Binding CoverPickerHasError}" />

          <ScrollViewer x:Name="CoverPickerScrollViewer" Grid.Row="1" MaxHeight="460" IsVisible="{Binding CoverPickerHasResults}">
            <ItemsControl ItemsSource="{Binding CoverPickerCandidates}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="5" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ArtworkCandidateViewModel">
                  <Border Classes="coverCandidate" Classes.selected="{Binding IsSelected}"
                          Cursor="Hand"
                          PointerPressed="OnCoverCandidatePressed"
                          Width="150" Height="170" Margin="6"
                          CornerRadius="8" ClipToBounds="True"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="{Binding LocalThumbnailPath, Converter={StaticResource FileToBitmapConverter}}" Stretch="Uniform" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Panel>

    <!-- "Sobre" -->
    <Panel Classes="fadeIn" IsVisible="{Binding IsAboutOpen}">
      <Border Classes="contextMenuOverlay" PointerPressed="OnAboutOverlayPressed" />
      <Border Classes="contextMenuCard" Width="480" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14" HorizontalAlignment="Center">
          <Image Source="avares://HandheldLauncher/Assets/app-icon.ico" Width="56" Height="56" HorizontalAlignment="Center" />
          <TextBlock Text="Handheld Launcher" Classes="menuHeaderTitle" FontSize="{DynamicResource FontSizeTitle}" />
          <TextBlock Text="{Binding AboutVersionText}" Classes="subtle" FontSize="{DynamicResource FontSizeBody}" HorizontalAlignment="Center" />
          <TextBlock Text="Um launcher em tela cheia para PCs portáteis como o Legion Go e o ROG Ally. Reúne seus jogos da Steam, do Xbox e outros num só lugar, com capas do SteamGridDB, HUD de desempenho e atualização automática."
                     Classes="gameTitle"
                     FontSize="{DynamicResource FontSizeBody}"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     FontWeight="Normal" />
          <Border Classes="menuHeader" Padding="12,8">
            <StackPanel Spacing="2" HorizontalAlignment="Center">
              <TextBlock Text="Criado por profcosta67" Classes="gameTitle" FontSize="{DynamicResource FontSizeBody}" HorizontalAlignment="Center" FontWeight="SemiBold" />
              <TextBlock Text="Desenvolvido com Claude (Anthropic)" Classes="subtle" FontSize="{DynamicResource FontSizeCaption}" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
          <TextBlock Text="github.com/profcosta67/Handheld-Launcher" Classes="subtle" FontSize="{DynamicResource FontSizeBody}" HorizontalAlignment="Center" />
          <TextBlock Text="Projeto independente, sem vínculo com Valve, Epic, Microsoft, Lenovo ou ASUS. Marcas pertencem aos seus donos. Fornecido como está, sem garantias. Não coleta dados: tudo fica neste PC."
                     Classes="subtle"
                     FontSize="{DynamicResource FontSizeCaption}"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />
          <TextBlock Text="Feito com Avalonia · Capas: SteamGridDB · HUD: RTSS · Atualizações: Velopack"
                     Classes="subtle"
                     FontSize="{DynamicResource FontSizeCaption}"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />
        </StackPanel>
      </Border>
    </Panel>

    <!-- Overlay "Iniciando <jogo>..." -->
    <Panel Classes="fadeIn" IsVisible="{Binding IsLaunching}">
      <Border Classes="contextMenuOverlay" PointerPressed="OnMenuOverlayPressed" />
      <Border Classes="contextMenuCard" Width="420" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="18" HorizontalAlignment="Center">
          <Image Source="{Binding LaunchingGameIconPath, Converter={StaticResource FileToBitmapConverter}}"
                 IsVisible="{Binding LaunchingGameIconPath, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}"
                 Width="96" Height="96" Stretch="Uniform" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding LaunchingGameTitle, StringFormat='Iniciando {0}...'}"
                     Classes="heroTitle" FontSize="{DynamicResource FontSizeTitle}" TextWrapping="Wrap" TextAlignment="Center" />
          <ProgressBar IsIndeterminate="True" Width="240" />
        </StackPanel>
      </Border>
    </Panel>
  </Panel>
</Window>