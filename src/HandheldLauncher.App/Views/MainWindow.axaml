<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HandheldLauncher.App.ViewModels"
        xmlns:models="using:HandheldLauncher.Core.Models"
        xmlns:conv="using:HandheldLauncher.App.Converters"
        xmlns:dataConv="using:Avalonia.Data.Converters"
        xmlns:media="using:Avalonia.Media"
        xmlns:svc="using:HandheldLauncher.Services"
        xmlns:views="using:HandheldLauncher.App.Views"
        x:Class="HandheldLauncher.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Handheld Launcher"
        Icon="avares://HandheldLauncher/Assets/app-icon.ico"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Focusable="True">

  <Window.Resources>
    <conv:FileToBitmapConverter x:Key="FileToBitmapConverter" />
    <conv:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
  </Window.Resources>

  <Window.Styles>
  <Style Selector="Border.listItem">
    <Setter Property="Transitions">
        <Transitions>
            <BrushTransition Property="Background" Duration="0:0:0.2"/>
        </Transitions>
    </Setter>
</Style>
<Style Selector="Border.listItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
</Style>
<Style Selector="Border.listItem.connected">
    <Setter Property="Background" Value="#33124C2A"/> <!-- Um verde bem escuro translúcido -->
    <Setter Property="BorderBrush" Value="#347A50"/>
    <Setter Property="BorderThickness" Value="1"/>
</Style>
<!-- Item sob o "cursor" do controle/teclado na Central de Controle -->
<Style Selector="Border.listItem.focused">
    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
</Style>
    <!-- Estilos do Control Center (movidos para o lugar correto) -->
    <Style Selector="Button.controlTile">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.controlTile:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    </Style>
  </Window.Styles>

  <Panel>

    <!-- Full-window backdrop -->
    <Panel>
      <Image Source="{Binding SelectedTile.BannerImagePath, Converter={StaticResource FileToBitmapConverter}}"
             Stretch="UniformToFill"
             IsVisible="{Binding SelectedTile.BannerImagePath, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}">
        <Image.Effect>
          <media:BlurEffect Radius="60" />
        </Image.Effect>
      </Image>
      <Border Background="{StaticResource BackdropDimBrush}" />
    </Panel>

  <Grid RowDefinitions="Auto,*,Auto" Margin="0">

    <!-- Top bar -->
    <Border x:Name="TopBar" Grid.Row="0" Classes="topBar" Margin="24,20,24,0" Padding="20,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
          <Image Source="avares://HandheldLauncher/Assets/app-icon.ico" Width="22" Height="22" VerticalAlignment="Center" />
          <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Handheld Launcher" Classes="gameTitle" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" />
        </StackPanel>
        
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">

          <Button Classes="iconGhost"
                  Width="32" Height="32"
                  CornerRadius="16"
                  Content="i"
                  FontFamily="Georgia"
                  FontStyle="Italic"
                  FontWeight="Bold"
                  FontSize="16"
                  Padding="0"
                  VerticalAlignment="Center"
                  ToolTip.Tip="Atalhos (F1)"
                  Click="OnShortcutsHelpClick" />

          <Button Classes="iconGhost"
                  VerticalAlignment="Center"
                  Content="{Binding UpdateStatusText}"
                  FontSize="{DynamicResource FontSizeCaption}"
                  Foreground="{StaticResource AccentBrush}"
                  IsVisible="{Binding HasUpdateStatus}"
                  Click="OnUpdateBadgeClick" />

          <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="12" Padding="14,6" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">

              <!-- 🟢 NOVO BOTÃO ÚNICO DA CENTRAL DE CONTROLE -->
              <Button Classes="pill" Click="OnControlCenterClick" ToolTip.Tip="Central de Controle (Y)" Padding="10,5">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="📶" FontSize="12" VerticalAlignment="Center"/>
                      <TextBlock Text="Rede" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </StackPanel>
              </Button>

              <Rectangle Width="1" Height="14" Fill="{DynamicResource TextSecondaryBrush}" Opacity="0.3" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTip.Tip="{Binding TopBarTdpToolTip}">
                <TextBlock Text="⚡" Foreground="#FFB84D" FontSize="14" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding TopBarTdpText}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                  <TextBlock Text="TDP" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="2,1,0,0"/>
                </StackPanel>
              </StackPanel>

              <Rectangle Width="1" Height="14" Fill="{DynamicResource TextSecondaryBrush}" Opacity="0.3" VerticalAlignment="Center" />

              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" ToolTip.Tip="{Binding TopBarDownloadToolTip}">
                <Grid VerticalAlignment="Center">
                  <Button Classes="iconGhost" Content="⇩" FontSize="16" FontWeight="Bold" Click="OnDownloadsShortcutClick" Padding="0" Foreground="{DynamicResource TextPrimaryBrush}" />
                  <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-2,0" IsHitTestVisible="False" IsVisible="{Binding HasActiveDownloads}" />
                </Grid>
                <TextBlock Text="{Binding TopBarDownloadPercentText}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" IsVisible="{Binding HasActiveDownloads}" />
              </StackPanel>

              <Rectangle Width="1" Height="14" Fill="{DynamicResource TextSecondaryBrush}" Opacity="0.3" VerticalAlignment="Center" />

              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding BatteryStatusText}" FontFamily="Inter" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
              </StackPanel>

              <Rectangle Width="1" Height="14" Fill="{DynamicResource TextSecondaryBrush}" Opacity="0.3" VerticalAlignment="Center" />

              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="⏱" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ClockText}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
              </StackPanel>

            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <ContentControl x:Name="LibraryLayoutHost" Grid.Row="1" />

    <!-- Bottom bar -->
    <Border Grid.Row="2" Classes="bottomBar" Margin="24,0,24,20" Padding="18,10">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" VerticalAlignment="Center">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
          <Image Source="avares://HandheldLauncher/Assets/app-icon.ico" Width="24" Height="24" Stretch="Uniform" />
          <TextBlock Text="Handheld Launcher" Classes="gameTitle" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding AppVersionText}" Classes="subtle" FontSize="{DynamicResource FontSizeCaption}" Opacity="0.65" VerticalAlignment="Center" />
        </StackPanel>
        <Button Grid.Column="1" Classes="pill" Content="{Binding RunningGame.Title, StringFormat='Fechar: {0}'}" Click="OnCloseGameClick" IsVisible="{Binding RunningGame, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}" Margin="0,0,10,0" />
        <Button Grid.Column="2" Classes="switchAction" Content="—" Click="OnMinimizeClick" ToolTip.Tip="Minimizar" Margin="0,0,8,0" />
        <Button Grid.Column="3" Classes="switchAction" Content="⚙" Click="OnGearMenuClick" ToolTip.Tip="Configurações" Margin="0,0,8,0" />
        <Button Grid.Column="4" Classes="switchAction" Content="⏻" Click="OnPowerMenuClick" ToolTip.Tip="Energia" />
      </Grid>
    </Border>

  </Grid>

    <Panel x:Name="ControlCenterOverlay" IsVisible="False" Background="#80000000" ZIndex="100">
    <!-- O Cartão Central -->
    <Border x:Name="ControlCenterCard" 
            Background="{DynamicResource SurfaceRaisedBrush}"
            CornerRadius="24" 
            Width="600" 
            Padding="24"
            HorizontalAlignment="Center" 
            VerticalAlignment="Center"
            BoxShadow="0 10 30 0 #40000000"
            Opacity="0"
            RenderTransform="translateY(20px)">
        
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
            </Transitions>
        </Border.Transitions>

        <StackPanel Spacing="20">
            <!-- Título e Fechar -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="Central de Controle" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="ControlCenterStatus" Text="Wi-Fi: …" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Button x:Name="BtnCloseControlCenter" Grid.Column="1" Classes="iconGhost" Click="OnCloseControlCenter" Content="✕" FontSize="16" Width="32" Height="32"/>
            </Grid>

            <!-- Toggles Rápidos -->
            <UniformGrid Columns="4" Height="100">
                <Button x:Name="BtnAirplane" Classes="controlTile" Click="OnToggleAirplaneMode">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="✈️" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="Modo Avião" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnWifi" Classes="controlTile" Click="OnToggleWifi">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="📶" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="Wi-Fi" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnBluetooth" Classes="controlTile" Click="OnToggleBluetooth">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🔷" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="Bluetooth" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnSync" Classes="controlTile" Click="OnToggleSyncthing">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="🔄" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="Sync" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Seção de Downloads -->
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="16">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="⬇" FontSize="24" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Downloads" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding TopBarDownloadPercentText}" FontSize="12" Foreground="{StaticResource AccentBrush}" IsVisible="{Binding HasActiveDownloads}"/>
                        <TextBlock Text="Nenhum download ativo" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" IsVisible="{Binding !HasActiveDownloads}"/>
                    </StackPanel>
                    <Button x:Name="BtnShowDownloads" Grid.Column="2" Classes="pill" Content="Ver Fila" Click="OnShowDownloadsClick"/>
                </Grid>
            </Border>

            <!-- Listas -->
            <Grid ColumnDefinitions="*,*" Height="220">
                <!-- Wi-Fi List -->
                <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="12" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Redes Wi-Fi" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <ScrollViewer>
                            <ItemsControl x:Name="WifiList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="svc:WifiNetwork">
                                        <Border Classes="listItem" 
                                                Classes.connected="{Binding IsConnected}" 
                                                Padding="10,8" 
                                                Margin="0,0,0,4" 
                                                CornerRadius="6" 
                                                Background="Transparent"
                                                PointerPressed="OnWifiNetworkClick">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Ssid}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding SignalStrength, StringFormat='{}{0}%'}" Foreground="Gray" FontSize="11"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Bluetooth List -->
                <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="12" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Bluetooth Pareados" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                        <ScrollViewer>
                            <ItemsControl x:Name="BluetoothList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="svc:BtDevice">
                                        <Border Classes="listItem" 
                                                Classes.connected="{Binding IsConnected}" 
                                                Padding="10,8" 
                                                Margin="0,0,0,4" 
                                                CornerRadius="6" 
                                                Background="Transparent"
                                                PointerPressed="OnBluetoothDeviceClick">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="#75D99A"/>
                                                    <TextBlock Text="{Binding ActionText}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- Feedback da última ação (conectar/desconectar) e dica de navegação -->
            <TextBlock x:Name="ControlCenterFeedback" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            <TextBlock Text="A conecta/desconecta · X atualiza · Y/B fecha" FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"/>
        </StackPanel>
    </Border>
</Panel>

    <!-- Start-button context menu -->
    <Panel Classes="fadeIn" IsVisible="{Binding IsContextMenuOpen}">
      <Border Classes="contextMenuOverlay" PointerPressed="OnMenuOverlayPressed" />
      
      <!-- Cartão principal do menu, limitado em altura -->
      <Border Classes="contextMenuCard" Width="460" Padding="24" MaxHeight="600"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          
          <!-- Cabeçalho do Menu -->
          <Border Classes="menuHeader">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
              <Image Source="{Binding ContextMenuTarget.IconImagePath, Converter={StaticResource FileToBitmapConverter}}" IsVisible="{Binding ContextMenuTarget.IconImagePath, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}" Width="36" Height="36" Stretch="Uniform" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ContextMenuTarget.Title}" Classes="menuHeaderTitle" FontSize="{DynamicResource FontSizeMenuHeader}" TextWrapping="Wrap" MaxWidth="340" />
            </StackPanel>
          </Border>
          
          <!-- Lista de Itens com Scroll -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="400">
            <ItemsControl ItemsSource="{Binding ContextMenuItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ContextMenuItemViewModel">
                  <Border Classes="menuItem" Classes.selected="{Binding IsSelected}" Classes.danger="{Binding IsDanger}" Padding="16,12" Cursor="Hand" PointerPressed="OnContextMenuItemPressed">
                    <TextBlock Text="{Binding Label}" Classes="gameTitle" FontSize="{DynamicResource FontSizeBody}" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          
        </StackPanel>
      </Border>
    </Panel>

    <!-- Global menu -->
    <Panel Classes="fadeIn" IsVisible="{Binding IsGlobalMenuOpen}">
      <Border Classes="contextMenuOverlay" PointerPressed="OnMenuOverlayPressed" />
      <Border Classes="contextMenuCard" Width="420" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <Border Classes="menuHeader">
            <TextBlock Text="{Binding GlobalMenuTitle}" Classes="menuHeaderTitle" FontSize="{DynamicResource FontSizeMenuHeader}" HorizontalAlignment="Center" />
          </Border>
          <ItemsControl ItemsSource="{Binding GlobalMenuItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ContextMenuItemViewModel">
                <Border Classes="menuItem" Classes.selected="{Binding IsSelected}" Classes.danger="{Binding IsDanger}" Padding="16,12" Cursor="Hand" PointerPressed="OnGlobalMenuItemPressed">
                  <TextBlock Text="{Binding Label}" Classes="gameTitle" FontSize="{DynamicResource FontSizeBody}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding GlobalMenuHint}" Classes="subtle" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding HasGlobalMenuHint}" />
        </StackPanel>
      </Border>
    </Panel>

    <!-- Painel de Downloads -->
    <Panel Classes="fadeIn" IsVisible="{Binding IsDownloadsOpen}">
      <Border Classes="contextMenuOverlay" PointerPressed="OnMenuOverlayPressed" />
      <Border Classes="contextMenuCard" Width="560" MaxHeight="620" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Downloads (Steam)" Classes="heroTitle" FontSize="{DynamicResource FontSizeTitle}" />
            <Button Grid.Column="1" Classes="pill" Content="✕" Padding="10,4" Click="OnCloseDownloadsClick" ToolTip.Tip="Fechar" />
          </Grid>
          <ScrollViewer Grid.Row="1" MaxHeight="380" Margin="0,16,0,0">
            <StackPanel Spacing="10">
              <TextBlock Text="Nada baixando no momento." Classes="subtle" FontSize="{DynamicResource FontSizeBody}" IsVisible="{Binding NoActiveDownloads}" />
              <ItemsControl ItemsSource="{Binding ActiveDownloads}" IsVisible="{Binding HasActiveDownloads}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:DownloadProgressInfo">
                    <StackPanel Spacing="4" Margin="0,0,0,12">
                      <TextBlock Text="{Binding Title}" Classes="gameTitle" FontSize="{DynamicResource FontSizeBody}" />
                      <ProgressBar Minimum="0" Maximum="100" Value="{Binding PercentComplete}" />
                      <TextBlock Text="{Binding DetailText}" Classes="subtle" FontSize="{DynamicResource FontSizeCaption}" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
          <Button Grid.Row="2" Classes="pill" Content="Abrir downloads na Steam (pausar/retomar)" HorizontalAlignment="Left" Margin="0,12,0,0" Click="OnOpenSteamDownloadsClick" />
          <TextBlock Grid.Row="3" Text="A abre os downloads na Steam · Y/B fecha · jogos da conta ficam na aba Não instalados" Classes="subtle" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" Margin="0,12,0,0" />
        </Grid>
      </Border>
    </Panel>

    <!-- Cover/banner picker -->
    <Panel Classes="fadeIn" IsVisible="{Binding IsCoverPickerOpen}">
      <Border Classes="contextMenuOverlay" PointerPressed="OnMenuOverlayPressed" />
      <Border Classes="contextMenuCard" Width="880" MaxHeight="620" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#1E1E2E">
        <Grid RowDefinitions="Auto,*,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <TextBlock Grid.Column="0" Text="{Binding CoverPickerTitle}" Classes="heroTitle" Foreground="White" FontSize="{DynamicResource FontSizeTitle}" TextWrapping="Wrap" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock Text="Só animadas" Foreground="LightGray" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}" />
              <ToggleSwitch IsChecked="{Binding FilterAnimatedOnly}" OnContent="" OffContent="" HorizontalAlignment="Right" />
            </StackPanel>
          </Grid>
          <TextBlock Grid.Row="1" Text="Buscando opções no SteamGridDB..." Foreground="LightGray" FontSize="{DynamicResource FontSizeBody}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsCoverPickerLoading}" />
          <TextBlock Grid.Row="1" Text="Nenhuma capa larga ou banner encontrado para esse jogo." Foreground="LightGray" FontSize="{DynamicResource FontSizeBody}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding CoverPickerIsEmpty}" />
          <TextBlock Grid.Row="1" Text="{Binding CoverPickerErrorMessage}" Foreground="LightGray" FontSize="{DynamicResource FontSizeBody}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20" IsVisible="{Binding CoverPickerHasError}" />
          <ScrollViewer x:Name="CoverPickerScrollViewer" Grid.Row="1" MaxHeight="460" IsVisible="{Binding CoverPickerHasResults}">
            <ItemsControl ItemsSource="{Binding CoverPickerCandidates}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="5" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ArtworkCandidateViewModel">
                  <Border Classes="coverCandidate" Classes.selected="{Binding IsSelected}" Cursor="Hand" PointerPressed="OnCoverCandidatePressed" Width="150" Height="170" Margin="6" CornerRadius="8" ClipToBounds="True" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                      <Image Source="{Binding LocalThumbnailPath, Converter={StaticResource FileToBitmapConverter}}" Stretch="Uniform" />
                      <Border Background="#CC6B4EFF" CornerRadius="5" Padding="6,3"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                              IsVisible="{Binding IsHero}">
                        <TextBlock Text="BANNER" FontSize="9" FontWeight="Bold" Foreground="White" />
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Panel>

    <!-- "Sobre" -->
    <Panel Classes="fadeIn" IsVisible="{Binding IsAboutOpen}">
      <Border Classes="contextMenuOverlay" PointerPressed="OnAboutOverlayPressed" />
      <Border Classes="contextMenuCard" Width="480" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14" HorizontalAlignment="Center">
          <Image Source="avares://HandheldLauncher/Assets/app-icon.ico" Width="56" Height="56" HorizontalAlignment="Center" />
          <TextBlock Text="Handheld Launcher" Classes="menuHeaderTitle" FontSize="{DynamicResource FontSizeTitle}" />
          <TextBlock Text="{Binding AboutVersionText}" Classes="subtle" FontSize="{DynamicResource FontSizeBody}" HorizontalAlignment="Center" />
          <TextBlock Text="Um launcher em tela cheia para PCs portáteis como o Legion Go e o ROG Ally. Reúne seus jogos da Steam, do Xbox e outros num só lugar, com capas do SteamGridDB, HUD de desempenho e atualização automática." Classes="gameTitle" FontSize="{DynamicResource FontSizeBody}" TextWrapping="Wrap" TextAlignment="Center" FontWeight="Normal" />
          <Border Classes="menuHeader" Padding="12,8">
            <StackPanel Spacing="2" HorizontalAlignment="Center">
              <TextBlock Text="Criado por profcosta67" Classes="gameTitle" FontSize="{DynamicResource FontSizeBody}" HorizontalAlignment="Center" FontWeight="SemiBold" />
              <TextBlock Text="Desenvolvido com Claude (Anthropic)" Classes="subtle" FontSize="{DynamicResource FontSizeCaption}" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
          <TextBlock Text="github.com/profcosta67/Handheld-Launcher" Classes="subtle" FontSize="{DynamicResource FontSizeBody}" HorizontalAlignment="Center" />
          <TextBlock Text="Projeto independente, sem vínculo com Valve, Epic, Microsoft, Lenovo ou ASUS. Marcas pertencem aos seus donos. Fornecido como está, sem garantias. Não coleta dados: tudo fica neste PC." Classes="subtle" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" TextAlignment="Center" />
          <TextBlock Text="Feito com Avalonia · Capas: SteamGridDB · HUD: RTSS · Atualizações: Velopack" Classes="subtle" FontSize="{DynamicResource FontSizeCaption}" TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>
      </Border>
    </Panel>

    <!-- Overlay "Iniciando <jogo>..." -->
    <Panel Classes="fadeIn" IsVisible="{Binding IsLaunching}">
      <Border Classes="contextMenuOverlay" PointerPressed="OnMenuOverlayPressed" />
      <Border Classes="contextMenuCard" Width="420" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="18" HorizontalAlignment="Center">
          <Image Source="{Binding LaunchingGameIconPath, Converter={StaticResource FileToBitmapConverter}}" IsVisible="{Binding LaunchingGameIconPath, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}" Width="96" Height="96" Stretch="Uniform" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding LaunchingGameTitle, StringFormat='Iniciando {0}...'}" Classes="heroTitle" FontSize="{DynamicResource FontSizeTitle}" TextWrapping="Wrap" TextAlignment="Center" />
          <ProgressBar IsIndeterminate="True" Width="240" />
        </StackPanel>
      </Border>
    </Panel>

    <!-- Painel de Ajuda (F1) -->
    <Panel Classes="fadeIn" IsVisible="{Binding IsShortcutsHelpOpen}">
      <Border Classes="contextMenuOverlay" PointerPressed="OnShortcutsOverlayPressed" />
      
      <Border Width="860" Padding="32" CornerRadius="20"
              Background="#161B24"
              BorderBrush="#333A4A" BorderThickness="1"
              HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="20">
          
          <StackPanel Spacing="6">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Border Background="#7C5CFC" CornerRadius="8" Padding="8,4">
                <TextBlock Text="F1" FontFamily="Consolas" FontWeight="Bold" Foreground="White" FontSize="14" />
              </Border>
              <TextBlock Text="Atalhos" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Text="Os comandos essenciais para navegar no launcher." FontSize="12" Foreground="#8A93A8" TextWrapping="Wrap" />
          </StackPanel>

          <!-- Sem ScrollViewer. Tudo numa tela só. -->
          <StackPanel Spacing="16">

            <!-- CONTROLE -->
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="🎮" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Text="CONTROLE" FontSize="12" FontWeight="Bold" Foreground="#3FB950" VerticalAlignment="Center" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding GamepadShortcuts}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="3" /> <!-- 3 colunas -->
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#1A1F2B" CornerRadius="10" Padding="12,10" Margin="4">
                      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Background="#1E2B1F" CornerRadius="6" Padding="8,4" BorderBrush="#2D4A2F" BorderThickness="1" MinWidth="72">
                          <TextBlock Text="{Binding Key}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#3FB950" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="#E0E0E0" VerticalAlignment="Center" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <!-- TECLADO -->
            <StackPanel Spacing="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="⌨" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Text="TECLADO" FontSize="12" FontWeight="Bold" Foreground="#7C5CFC" VerticalAlignment="Center" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding KeyboardShortcuts}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Columns="3" /> <!-- 3 colunas -->
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="#1A1F2B" CornerRadius="10" Padding="12,10" Margin="4">
                      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Background="#252A36" CornerRadius="6" Padding="8,4" BorderBrush="#424A5D" BorderThickness="1" MinWidth="72">
                          <TextBlock Text="{Binding Key}" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#7C5CFC" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="#E0E0E0" VerticalAlignment="Center" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

          </StackPanel>

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <Button Classes="pill" Content="Fechar" Click="OnShortcutsCloseClick" />
          </StackPanel>
          
        </StackPanel>
      </Border>
    </Panel>

    <!-- v0.24.2: teclado na tela para os campos de texto da janela principal
         (busca da aba Nuvem). Fica no fundo e por baixo da Central de Controlo
         (ZIndex 100) — quem manda naquela zona é ela. -->
    <views:OnScreenKeyboardView x:Name="Keyboard" VerticalAlignment="Bottom" ZIndex="50" />



  </Panel>
</Window>