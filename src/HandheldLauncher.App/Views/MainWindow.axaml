<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HandheldLauncher.App.ViewModels"
        xmlns:models="using:HandheldLauncher.Core.Models"
        xmlns:conv="using:HandheldLauncher.App.Converters"
        xmlns:dataConv="using:Avalonia.Data.Converters"
        xmlns:media="using:Avalonia.Media"
        x:Class="HandheldLauncher.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="Handheld Launcher"
        Icon="avares://HandheldLauncher/Assets/app-icon.ico"
        Width="1280" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Focusable="True"
        KeyDown="OnWindowKeyDown">

  <!--
    Normal resizable window by default (easy to iterate on during dev).
    Modo kiosk (fullscreen/borderless) is applied from App.axaml.cs right
    after construction, driven by AppSettings.KioskMode — see that file
    and installer/Install-Launcher.ps1 for where that flag gets set.
  -->

  <Window.Resources>
    <conv:FileToBitmapConverter x:Key="FileToBitmapConverter" />
  </Window.Resources>

  <Panel>

    <!-- Full-window backdrop: the focused game's art, blurred and
         stretched to fill the whole window, so there's no flat dark void
         wherever the actual content doesn't reach (below the tile row,
         around the hero banner). A dimming layer on top keeps text and
         controls legible over whatever art lands there. Sits behind
         everything else since it's the first child of the Panel. -->
    <Panel>
      <Image Source="{Binding SelectedTile.BannerImagePath, Converter={StaticResource FileToBitmapConverter}}"
             Stretch="UniformToFill"
             IsVisible="{Binding SelectedTile.BannerImagePath, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}">
        <Image.Effect>
          <media:BlurEffect Radius="60" />
        </Image.Effect>
      </Image>
      <Border Background="{StaticResource BackdropDimBrush}" />
    </Panel>

  <Grid RowDefinitions="Auto,*,Auto" Margin="0">

    <!-- Top bar -->
    <Border Grid.Row="0" Classes="topBar" Margin="24,20,24,0" Padding="20,12">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10">
          <!-- Ícone do app (novo nesta leva, pedido do usuário: "adicionar
               nosso icone no canto superior esquerdo antes do nome") —
               mesmo arquivo já usado no ícone da janela/bandeja
               (Assets/app-icon.ico). -->
          <Image Source="avares://HandheldLauncher/Assets/app-icon.ico" Width="22" Height="22" VerticalAlignment="Center" />
          <Ellipse Width="10" Height="10" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
          <TextBlock Text="Handheld Launcher" Classes="gameTitle" VerticalAlignment="Center" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="16">
          <!-- Aviso de atualização do launcher (Velopack): "Verificando…",
               "⬆ v1.2.4 pronta — toque pra reiniciar" etc. Só aparece com
               algo a dizer (HasUpdateStatus); tocar aplica a atualização
               já baixada (no controle: item no topo do menu View/Back). -->
          <Button Classes="iconGhost"
                  VerticalAlignment="Center"
                  Content="{Binding UpdateStatusText}"
                  FontSize="12"
                  Foreground="{StaticResource AccentBrush}"
                  IsVisible="{Binding HasUpdateStatus}"
                  Click="OnUpdateBadgeClick" />
          <!-- Atalho de Downloads na barra de cima (novo numa leva
               posterior, pedido do usuário: "colocar um atalho lá em cima
               igual a Steam") — abre o mesmo painel que o item
               "Downloads" do menu geral (OnDownloadsShortcutClick só
               chama vm.ToggleDownloads(), não é um painel separado). O
               pontinho no canto só aparece com algo baixando agora de
               verdade (HasActiveDownloads), pra dar uma pista visual sem
               precisar abrir o painel pra checar. -->
          <!-- Leva seguinte: + "Y" do lado (o controle abre isso pelo Y —
               GamepadAction.Downloads, pedido do usuário: "não consigo
               acessar... pelo controle") e, com algo baixando, o % e uma
               mini barra de progresso (pedido: "algo que indica visual o
               percentual do download"). Atualiza sozinho mesmo com o
               painel fechado — ver MainWindow.StartDownloadsRefreshTimer. -->
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                      ToolTip.Tip="{Binding TopBarDownloadToolTip}">
            <Grid VerticalAlignment="Center">
              <Button Classes="iconGhost"
                      Content="⇩"
                      FontSize="16"
                      Click="OnDownloadsShortcutClick" />
              <Ellipse Width="8" Height="8"
                       Fill="{StaticResource AccentBrush}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Top"
                       Margin="0,-2,-2,0"
                       IsHitTestVisible="False"
                       IsVisible="{Binding HasActiveDownloads}" />
            </Grid>

            <StackPanel Orientation="Vertical" Spacing="2" VerticalAlignment="Center"
                        IsVisible="{Binding HasActiveDownloads}">
              <TextBlock Text="{Binding TopBarDownloadPercentText}"
                         Classes="subtle"
                         FontSize="11"
                         HorizontalAlignment="Center" />
              <ProgressBar Minimum="0" Maximum="100"
                           Value="{Binding TopBarDownloadPercent}"
                           Width="44" Height="3" MinHeight="3"
                           Foreground="{StaticResource AccentBrush}" />
            </StackPanel>

            <!-- Dica do botão do controle — discreta, só pra quem joga só
                 no controle descobrir que existe. -->
            <Border BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Width="18" Height="18"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False">
              <TextBlock Text="Y" FontSize="10" FontWeight="Bold"
                         Foreground="{StaticResource AccentBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </StackPanel>
          <!-- Wifi/clock ainda são placeholder (●●●) — só a bateria virou
               real nesta leva (ver MainViewModel.BatteryStatusText/
               MainWindow.StartBatteryMonitor), corrigindo o bug reportado
               de ficar cravada em 100%. Texto vazio (nada aparece) em PC
               sem bateria nenhuma. -->
          <TextBlock Text="●●●" Classes="subtle" VerticalAlignment="Center" />
          <TextBlock Text="{Binding BatteryStatusText}" Classes="subtle" VerticalAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main content: o banner hero retangular no topo (SEM blur, crua a
         arte do jogo focado) VOLTOU nesta leva — tinha sido removido numa
         leva anterior, mas o usuário pediu de volta ("vamos voltar aquele
         quadrado em cima sem blur"). A arte hero continua TAMBÉM
         alimentando o fundo desfocado da janela inteira (Panel lá em cima)
         — as duas coisas usam a mesma arte, uma com blur, outra sem,
         exatamente como antes da remoção. -->
    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" Margin="24,20,24,20">

      <!-- Hero: o jogo focado, banner largo deitado. 320 → 380 nesta
           leva, a pedido do usuário ("aumenta o eixo vertical do hero
           deixe um pouco maior"). -->
      <Border Grid.Row="0" Classes="heroBanner" Height="380" Margin="0,0,0,20">
        <!-- Border só aceita um filho, então os dois estados (jogo
             selecionado / biblioteca vazia) vivem dentro do mesmo Grid
             externo, alternados por IsVisible. -->
        <Grid>
          <Grid IsVisible="{Binding SelectedTile, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}">
            <Image Source="{Binding SelectedTile.BannerImagePath, Converter={StaticResource FileToBitmapConverter}}"
                   Stretch="UniformToFill" />

            <!-- Placeholder enquanto não tem hero/capa nenhuma ainda (pre-SteamGridDB) -->
            <TextBlock Text="{Binding SelectedTile.Title}"
                       Classes="heroTitle"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="20"
                       IsVisible="{Binding SelectedTile.BannerImagePath, Converter={x:Static dataConv:ObjectConverters.IsNull}}" />

            <!-- CURRENT LOGO: canto superior ESQUERDO do hero, sem nenhuma
                 barra/fundo escuro por trás (a barra de baixo com
                 título+minutos jogados foi removida nesta leva — pedido
                 explícito do usuário: "retirar essa linha escura do hero,
                 jogar a logo para o canto esquerdo superior e aumentar
                 ainda mais o tamanho da logo somente que aparece no
                 hero"). Maior que o logo das tiles da fileira (64 contra
                 22/32 — ver GameTileViewModel.CaptionLogoHeight). Sem logo
                 pra esse jogo ainda, não mostra nada aqui (o nome já
                 aparece normalmente na caption de cada tile, logo abaixo). -->
            <Image Source="{Binding SelectedTile.LogoImagePath, Converter={StaticResource FileToBitmapConverter}}"
                   Height="64" Stretch="Uniform"
                   HorizontalAlignment="Left" VerticalAlignment="Top"
                   Margin="24"
                   IsVisible="{Binding SelectedTile.ShowCurrentLogo}" />
          </Grid>

          <TextBlock Text="Nenhum jogo encontrado ainda.&#10;Adicione um jogo manualmente para começar."
                     Classes="subtle"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     VerticalAlignment="Center"
                     HorizontalAlignment="Center"
                     Margin="24"
                     IsVisible="{Binding SelectedTile, Converter={x:Static dataConv:ObjectConverters.IsNull}}" />
        </Grid>
      </Border>

      <!-- Abas de filtro — "um pouco acima dos ícones dos jogos e abaixo
           do hero", pedido do usuário: Favoritos, Todos, Oficiais, Não
           Steam, Não instalados (reorganizado numa leva posterior —
           "dividir as subabas, fav, ALL, oficiais, não Steam, não
           instalados"; era Steam/Xbox separados antes, "Oficiais" junta
           os dois). Trocar de aba só filtra a lista já carregada
           (MainViewModel.SetFilter/RebuildGamesFromLibrary), não
           re-escaneia a biblioteca — exceto "Não instalados", que busca
           na Steam Web API toda vez que é selecionada (RefreshOwnedGames).
           Grid de 5 colunas IGUAIS (não
           StackPanel) a pedido do usuário ("centralize... fica com todos
           espaçamentos iguais e ocupe do início ao fim da tela") — cada
           botão ocupa Stretch dentro da sua coluna, então a fileira
           inteira sempre vai de uma ponta à outra com espaçamento
           simétrico, não só o tamanho do conteúdo. Alcançável por
           mouse/touch (clique direto numa aba) E agora por LB/RB no
           controle (GamepadAction.PreviousFilter/NextFilter, ciclando
           nesta mesma ordem visual — ver MainViewModel.FilterOrder),
           depois do usuário reportar que não conseguia acessar pelo
           controle. -->
      <!-- Margem inferior igual à do hero acima (20, era 16 nos dois) —
           pedido do usuário pra alinhar/igualar o espaçamento
           hero→abas e abas→fileira de jogos. -->
      <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" Margin="0,0,0,20">
        <Button Grid.Column="0" Classes="pill filterTab" Classes.active="{Binding IsFilterFavoritesActive}" Content="Favoritos" Command="{Binding SetFilterFavoritesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,5,0" />
        <Button Grid.Column="1" Classes="pill filterTab" Classes.active="{Binding IsFilterAllActive}" Content="Todos" Command="{Binding SetFilterAllCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,5,0" />
        <Button Grid.Column="2" Classes="pill filterTab" Classes.active="{Binding IsFilterOfficialActive}" Content="Oficiais" Command="{Binding SetFilterOfficialCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,5,0" />
        <Button Grid.Column="3" Classes="pill filterTab" Classes.active="{Binding IsFilterNonSteamActive}" Content="Não Steam" Command="{Binding SetFilterNonSteamCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,5,0" />
        <Button Grid.Column="4" Classes="pill filterTab" Classes.active="{Binding IsFilterNotInstalledActive}" Content="Não instalados" Command="{Binding SetFilterNotInstalledCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="5,0,0,0" />
      </Grid>

      <!-- Horizontal row of every game (CAPSULE tiles, WIDE CAPSULE pro
           último jogo aberto). -->
      <ScrollViewer x:Name="GameRowScrollViewer" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <!-- Suavização pedida pelo usuário ("sistema de suavização... quando
             passar pro lado entre os jogos"): anima qualquer mudança de
             Offset, incluindo as que MainWindow.ScrollGameRowSelectionIntoView
             já fazia via código (Transitions do Avalonia reage a QUALQUER
             troca de valor da propriedade, não só troca via Setter/estilo) —
             então o scroll que antes pulava direto agora desliza. Não dá pra
             compilar aqui pra confirmar, mas é a API documentada do Avalonia
             pra isso (VectorTransition, já que Offset é um Vector). Duração
             0.22s → 0.28s nesta leva — usuário reportou "não notei a
             transição entre os ícones". -->
        <ScrollViewer.Transitions>
          <Transitions>
            <VectorTransition Property="Offset" Duration="0:0:0.28" Easing="CubicEaseOut" />
          </Transitions>
        </ScrollViewer.Transitions>
        <!-- REVERTIDO nesta leva: tinha colocado VerticalAlignment="Center"
             aqui pra tentar dividir o espaço vertical sobrando em cima e
             embaixo da fileira (em vez de acumular tudo embaixo, que era a
             queixa da leva anterior). No Legion Go 2 de verdade isso
             piorou: o usuário reportou "agora baixou demais e tá cortando
             a parte de baixo" — nessa resolução real a fileira
             (Height=290 por tile) aparentemente é mais alta que o espaço
             "*" sobrando, então centralizar empurrou a fileira pra baixo o
             suficiente pra cortar a base contra a barra de baixo, em vez
             de só deixar sobrar embaixo (que era cosmético, não cortava
             nada). Voltou pro padrão (sem VerticalAlignment, topo) —
             prefere sobrar espaço embaixo do que cortar a fileira.
             Ajuste fino de verdade aqui precisa da resolução/altura real
             da janela no Legion Go 2 pra calcular sem continuar
             tentando "no escuro". -->
        <ItemsControl x:Name="GamesItemsControl" ItemsSource="{Binding Games}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <!-- Spacing 14 → 18 nesta leva — junto com a WIDE CAPSULE
                   um pouco mais estreita (Theme.axaml, 620 → 580), resolve
                   a tile larga "pegando o ícone do lado" reportada pelo
                   usuário. -->
              <StackPanel Orientation="Horizontal" Spacing="18" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:GameTileViewModel">
              <!-- Width vem do TileWidth do ViewModel (precisa bater com o
                   Width do Border.gameTile/.lastPlayed abaixo, vindo do
                   Theme.axaml) — sem isso o StackPanel ia se dimensionar
                   pelo conteúdo mais largo (o texto do nome, pra títulos
                   compridos), quebrando o alinhamento fixo da fileira e a
                   conta de scroll em MainWindow.ScrollGameRowSelectionIntoView. -->
              <StackPanel Width="{Binding TileWidth}" Spacing="6">

                <!-- Caption ACIMA da capa (nunca por dentro dela): LOGO no
                     lugar do nome, em QUALQUER tile (CAPSULE ou WIDE
                     CAPSULE) que já tenha logo baixado — regra final e
                     explícita do usuário: "a LOGO não vai dentro das capas
                     ... ele vai apenas dentro da hero (banner) lá em cima e
                     ACIMA DAS CAPAS NO LUGAR DO NOME". Sem logo ainda, cai
                     pro nome (ShowNameCaption). Nunca os dois juntos.
                     Altura FIXA (36) pra toda tile reservar o mesmo espaço
                     aqui em cima — sem isso, a tile com um logo MAIOR (a
                     WIDE CAPSULE usa CaptionLogoHeight=32 contra 22 da
                     CAPSULE normal, pedido do usuário: "deixa ela um pouco
                     maior... na wide capsule") desalinharia verticalmente a
                     capa de baixo em relação às tiles vizinhas, já que o
                     StackPanel horizontal da fileira alinha os filhos pelo
                     topo — com a altura fixa, qualquer tamanho de logo/nome
                     fica centralizado dentro da MESMA caixa de 36px.
                     Alinhamento LEFT nesta leva (era Center) — pedido do
                     usuário: "alinhe os ícones de nome dos jogos a
                     esquerda iniciando no começo da arte do jogo". Como
                     essa Grid tem a MESMA largura da capa abaixo
                     (StackPanel Width=TileWidth), alinhar à esquerda aqui
                     já começa exatamente na borda esquerda da capa. -->
                <Grid Height="36">
                  <TextBlock Text="{Binding Title}"
                             Classes="tileCaption"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis"
                             TextAlignment="Left"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             IsVisible="{Binding ShowNameCaption}" />

                  <Image Source="{Binding LogoImagePath, Converter={StaticResource FileToBitmapConverter}}"
                         Height="{Binding CaptionLogoHeight}"
                         Stretch="Uniform"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Center"
                         IsVisible="{Binding ShowCurrentLogo}" />
                </Grid>

                <!-- Width/Height do Border vêm das styles gameTile/
                     gameTile.lastPlayed em Theme.axaml (não daqui), pra
                     bater exatamente com TileWidth acima. -->
                <Border Classes="gameTile"
                        Classes.focused="{Binding IsFocused}"
                        Classes.lastPlayed="{Binding IsLastPlayed}"
                        Width="{Binding TileWidth}"
                        Height="{Binding TileHeight}"
                        PointerPressed="OnTilePointerPressed"
                        DoubleTapped="OnTileDoubleTapped">
                  <Grid>
                    <Image Source="{Binding TileImagePath, Converter={StaticResource FileToBitmapConverter}}"
                           Stretch="UniformToFill" />

                    <!-- Jogo não instalado (aba "Não instalados"): véu cinza
                         por cima da capa pra diferenciar dos instalados —
                         pedido do usuário ("leve aspecto cinza"). -->
                    <Border Background="#99383838"
                            IsHitTestVisible="False"
                            IsVisible="{Binding IsOwnedNotInstalled}" />

                    <!-- Placeholder: só aparece quando essa tile específica
                         não tem NENHUMA arte ainda (nem capa) — a caption já
                         aparece em cima (Grid acima), isso aqui é só pra não
                         deixar a área da imagem vazia. -->
                    <TextBlock Text="{Binding Title}"
                               Classes="gameTitle"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="10"
                               IsVisible="{Binding ShowEmptyPlaceholder}" />

                    <!-- Estrelinha discreta pra quem foi favoritado
                         (menu de contexto → Favoritar) — só pra dar algum
                         jeito de ver na fileira inteira, sem precisar
                         trocar pra aba "Favoritos" pra checar. -->
                    <TextBlock Text="★"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="18"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="8"
                               IsVisible="{Binding IsFavorite}" />

                    <!-- Badge "Instalar" — canto oposto da estrelinha de
                         propósito (essas tiles, da aba "Não instalados",
                         não ficam favoritadas na prática, mas por
                         garantia nunca os dois no mesmo canto). Confirmar/
                         clicar na tile já instala sozinho (ver
                         MainViewModel.LaunchSelected) — isto é só o
                         indicador visual de que ela se comporta diferente
                         das outras. -->
                    <Border Background="#CC000000"
                            CornerRadius="4"
                            Padding="6,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="8"
                            IsVisible="{Binding IsOwnedNotInstalled}">
                      <TextBlock Text="⇩ Instalar" FontSize="11" Foreground="White" />
                    </Border>
                  </Grid>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Mensagem no lugar da fileira (aba "Não instalados" sem nada
           ainda pra mostrar — sem credencial, carregando, erro, ou lista
           genuinamente vazia). Grid.Row igual ao ScrollViewer acima: como
           ele fica vazio exatamente nesses casos, não tem sobreposição
           visual real. Ver MainViewModel.NotInstalledTabMessage. -->
      <TextBlock Grid.Row="2"
                 Text="{Binding NotInstalledTabMessage}"
                 Classes="subtle"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Top"
                 Margin="40,30,40,0"
                 MaxWidth="600"
                 IsVisible="{Binding HasNotInstalledTabMessage}" />
    </Grid>

    <!-- Bottom bar — deliberadamente minimalista a pedido do usuário:
         Buscar capas/Adicionar jogo/Atualizar/Sair saíram de aqui e foram
         pro menu geral (View/Back, ou o ícone de engrenagem aqui mesmo na
         barra de baixo — ver bullet abaixo), restando só o que faz
         sentido como ação rápida de mouse/touch na barra. Grid.Column="0"
         era um TextBlock com a dica de controles ("← → navega · A/Enter
         joga · ..."); removido a pedido do usuário (poluía o canto
         inferior esquerdo da tela). A coluna "*" fica sem conteúdo de
         propósito, só empurrando os botões pra direita como antes.
         Reorganizado nesta leva (pedido do usuário: "muito desorganizado,
         vamos por partes") — a engrenagem SAIU do canto superior direito
         (ver Top bar acima) e entrou aqui, e "Minimizar" trocou de texto
         pra ícone: canto inferior direito agora é sempre Minimizar(ícone)
         → Engrenagem → Power, nessa ordem. -->
    <Border Grid.Row="2" Classes="bottomBar" Margin="24,0,24,20" Padding="20,12">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
        <!-- Versão atual no rodapé (pedido do usuário: "nota de rodapé com
             a versão atual" — pra conferir se a atualização pegou). -->
        <TextBlock Grid.Column="0"
                   Text="{Binding AppVersionText}"
                   Classes="subtle"
                   FontSize="11"
                   Opacity="0.7"
                   VerticalAlignment="Center" />
        <Button Grid.Column="1"
                Classes="pill"
                Content="{Binding RunningGame.Title, StringFormat='Fechar: {0}'}"
                Click="OnCloseGameClick"
                IsVisible="{Binding RunningGame, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}"
                Margin="0,0,10,0" />
        <!-- "─" como ícone de minimizar (mesma lógica visual de ⚙/⏻ —
             glyph simples, sem depender de uma fonte de ícones extra). -->
        <Button Grid.Column="2"
                Classes="pill"
                Content="─"
                Padding="14,6"
                Click="OnMinimizeClick"
                ToolTip.Tip="Minimizar — minimiza pra bandeja do Windows sem fechar o processo (não dispara o watchdog de reabertura). Reabre clicando no ícone da bandeja, pelo menu dele, ou com Ctrl+Alt+H de qualquer lugar."
                Margin="0,0,10,0" />
        <!-- Engrenagem — movida do topo pra aqui nesta leva. Abre o mesmo
             menu geral do botão View/Back (OnGearMenuClick só chama
             vm.ToggleGlobalMenu(), nada de menu separado) — assim
             mouse/touch e controle sempre acessam exatamente as mesmas
             opções (Atualizar Biblioteca/Atualizar Capas Automático/
             Adicionar jogo/Downloads/Overlay FPS). -->
        <Button Grid.Column="3"
                Classes="pill"
                Content="⚙"
                Padding="10,6"
                Click="OnGearMenuClick"
                ToolTip.Tip="Menu"
                Margin="0,0,10,0" />
        <Button Grid.Column="4"
                Classes="pill"
                Content="⏻"
                Padding="14,6"
                Click="OnPowerMenuClick"
                ToolTip.Tip="Energia" />
      </Grid>
    </Border>

  </Grid>

    <!-- Start-button context menu: dim backdrop + centered card. Sits as
         the LAST child of the outer Panel so it paints over absolutely
         everything else, bottom bar included. -->
    <Panel IsVisible="{Binding IsContextMenuOpen}">
      <Border Classes="contextMenuOverlay" />
      <Border Classes="contextMenuCard" Width="420" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <!-- v0.7.0: nome do jogo centralizado numa moldura de destaque,
               com o ícone do jogo (SteamGridDB) do lado quando existir. -->
          <Border Classes="menuHeader">
            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
              <Image Source="{Binding ContextMenuTarget.IconImagePath, Converter={StaticResource FileToBitmapConverter}}"
                     IsVisible="{Binding ContextMenuTarget.IconImagePath, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}"
                     Width="36" Height="36" Stretch="Uniform" VerticalAlignment="Center" />
              <TextBlock Text="{Binding ContextMenuTarget.Title}" Classes="menuHeaderTitle" TextWrapping="Wrap" MaxWidth="300" />
            </StackPanel>
          </Border>
          <ItemsControl ItemsSource="{Binding ContextMenuItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ContextMenuItemViewModel">
                <Border Classes="menuItem" Classes.selected="{Binding IsSelected}" Padding="14,10">
                  <TextBlock Text="{Binding Label}" Classes="gameTitle" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </Panel>

    <!-- Global menu (View/Back button) — same visual pattern as the
         per-tile menu above, but for the bottom bar's actions, so they're
         reachable without a mouse. No "target" title since it's not about
         a specific game. -->
    <Panel IsVisible="{Binding IsGlobalMenuOpen}">
      <Border Classes="contextMenuOverlay" />
      <Border Classes="contextMenuCard" Width="380" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <Border Classes="menuHeader">
            <TextBlock Text="{Binding GlobalMenuTitle}" Classes="menuHeaderTitle" HorizontalAlignment="Center" />
          </Border>
          <ItemsControl ItemsSource="{Binding GlobalMenuItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ContextMenuItemViewModel">
                <Border Classes="menuItem" Classes.selected="{Binding IsSelected}" Padding="14,10">
                  <TextBlock Text="{Binding Label}" Classes="gameTitle" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="{Binding GlobalMenuHint}" Classes="subtle" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" IsVisible="{Binding HasGlobalMenuHint}" />
        </StackPanel>
      </Border>
    </Panel>

    <!-- Power menu (botão "Power"/⏻ da barra de baixo, OU "Power" dentro
         do menu geral — ver MainViewModel.BuildGlobalMenu) — mesmo padrão
         visual dos outros dois menus acima, 4 ações fixas agora incluindo
         "Sair" (ver MainViewModel.BuildPowerMenu). -->
    <Panel IsVisible="{Binding IsPowerMenuOpen}">
      <Border Classes="contextMenuOverlay" />
      <Border Classes="contextMenuCard" Width="340" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="Energia" Classes="heroTitle" />
          <ItemsControl ItemsSource="{Binding PowerMenuItems}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ContextMenuItemViewModel">
                <Border Classes="menuItem" Classes.selected="{Binding IsSelected}" Padding="14,10">
                  <TextBlock Text="{Binding Label}" Classes="gameTitle" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="↑↓ navega · A/Enter confirma · B/Esc cancela" Classes="subtle" />
        </StackPanel>
      </Border>
    </Panel>

    <!-- Painel de Downloads (item "Downloads" do menu global) — pedido do
         usuário como "gerenciador de download". Duas seções: "baixando
         agora" (Steam, lido do .acf — ver ScanActiveDownloads) e "na sua
         conta, não instalado" (Steam Web API). Ver MainViewModel.
         IsDownloadsOpen pras decisões de escopo da v1 (só Steam; lista
         "Instalar" é mouse/touch-only, por isso o botão ✕ aqui em vez de
         depender só do controle pra fechar). -->
    <Panel IsVisible="{Binding IsDownloadsOpen}">
      <Border Classes="contextMenuOverlay" />
      <Border Classes="contextMenuCard" Width="560" MaxHeight="620" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,*,Auto,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Downloads (Steam)" Classes="heroTitle" />
            <Button Grid.Column="1" Classes="pill" Content="✕" Padding="10,4" Click="OnCloseDownloadsClick" ToolTip.Tip="Fechar" />
          </Grid>

          <ScrollViewer Grid.Row="1" MaxHeight="380" Margin="0,16,0,0">
            <StackPanel Spacing="10">
              <TextBlock Text="Nada baixando no momento." Classes="subtle" IsVisible="{Binding NoActiveDownloads}" />
              <ItemsControl ItemsSource="{Binding ActiveDownloads}" IsVisible="{Binding HasActiveDownloads}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:DownloadProgressInfo">
                    <StackPanel Spacing="4" Margin="0,0,0,12">
                      <TextBlock Text="{Binding Title}" Classes="gameTitle" />
                      <ProgressBar Minimum="0" Maximum="100" Value="{Binding PercentComplete}" />
                      <TextBlock Text="{Binding DetailText}" Classes="subtle" />
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <!-- A Steam não deixa outro programa pausar/retomar download —
               este botão leva pra tela de downloads dela, onde dá. -->
          <Button Grid.Row="2"
                  Classes="pill"
                  Content="Abrir downloads na Steam (pausar/retomar)"
                  HorizontalAlignment="Left"
                  Margin="0,12,0,0"
                  Click="OnOpenSteamDownloadsClick" />

          <TextBlock Grid.Row="3" Text="A abre os downloads na Steam · Y/B fecha · jogos da conta ficam na aba Não instalados" Classes="subtle" TextWrapping="Wrap" Margin="0,12,0,0" />
        </Grid>
      </Border>
    </Panel>

    <!-- Cover/banner picker — opened from the per-tile menu's "Escolher
         capa"/"Escolher banner". Grid of SteamGridDB candidates (static
         images only, see README's "Seletor de capas" section for the
         animated-GIF follow-up); ← → ↑ ↓ all move the highlight by one
         (flat list, no row-aware jump yet), A/Enter applies the highlighted
         one, B/Esc/Start/View cancels without changing anything. -->
    <Panel IsVisible="{Binding IsCoverPickerOpen}">
      <Border Classes="contextMenuOverlay" />
      <Border Classes="contextMenuCard" Width="880" MaxHeight="620" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid RowDefinitions="Auto,*,Auto">
          <TextBlock Grid.Row="0" Text="{Binding CoverPickerTitle}" Classes="heroTitle" TextWrapping="Wrap" Margin="0,0,0,16" />

          <TextBlock Grid.Row="1"
                     Text="Buscando opções no SteamGridDB..."
                     Classes="subtle"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding IsCoverPickerLoading}" />

          <TextBlock Grid.Row="1"
                     Text="Nenhuma opção estática encontrada para esse jogo."
                     Classes="subtle"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     IsVisible="{Binding CoverPickerIsEmpty}" />

          <TextBlock Grid.Row="1"
                     Text="{Binding CoverPickerErrorMessage}"
                     Classes="subtle"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="20"
                     IsVisible="{Binding CoverPickerHasError}" />

          <ScrollViewer x:Name="CoverPickerScrollViewer" Grid.Row="1" MaxHeight="460" IsVisible="{Binding CoverPickerHasResults}">
            <!-- UniformGrid with a FIXED column count (not WrapPanel) so
                 ↑↓ can jump by exactly "CoverPickerColumns" in the
                 ViewModel and land in the right cell every time — a
                 WrapPanel's column count depends on pixel widths at
                 render time, which the ViewModel can't reliably mirror,
                 and that mismatch is exactly why ↑↓ used to behave like
                 ←→ (MainViewModel had no row concept at all yet). -->
            <ItemsControl ItemsSource="{Binding CoverPickerCandidates}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="5" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ArtworkCandidateViewModel">
                  <Border Classes="coverCandidate" Classes.selected="{Binding IsSelected}"
                          Width="150" Height="170" Margin="6"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="{Binding LocalThumbnailPath, Converter={StaticResource FileToBitmapConverter}}"
                           Stretch="Uniform" />
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>


        </Grid>
      </Border>
    </Panel>

    <!-- "Sobre" (Configurações → Sobre, v0.7.0) — bem simples, pedido do
         usuário. Fecha com B/A/View/Esc ou clique. -->
    <Panel IsVisible="{Binding IsAboutOpen}">
      <Border Classes="contextMenuOverlay" PointerPressed="OnAboutOverlayPressed" />
      <Border Classes="contextMenuCard" Width="480" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="14" HorizontalAlignment="Center">
          <Image Source="avares://HandheldLauncher/Assets/app-icon.ico" Width="56" Height="56" HorizontalAlignment="Center" />
          <TextBlock Text="Handheld Launcher" Classes="menuHeaderTitle" FontSize="26" />
          <TextBlock Text="{Binding AboutVersionText}" Classes="subtle" HorizontalAlignment="Center" />
          <TextBlock Text="Um launcher em tela cheia para PCs portáteis como o Legion Go e o ROG Ally. Reúne seus jogos da Steam, do Xbox e outros num só lugar, com capas do SteamGridDB, HUD de desempenho e atualização automática."
                     Classes="gameTitle"
                     TextWrapping="Wrap"
                     TextAlignment="Center"
                     FontWeight="Normal" />
          <Border Classes="menuHeader" Padding="12,8">
            <StackPanel Spacing="2" HorizontalAlignment="Center">
              <TextBlock Text="Criado por profcosta67" Classes="gameTitle" HorizontalAlignment="Center" FontWeight="SemiBold" />
              <TextBlock Text="Desenvolvido com Claude (Anthropic)" Classes="subtle" HorizontalAlignment="Center" />
            </StackPanel>
          </Border>
          <TextBlock Text="github.com/profcosta67/Handheld-Launcher" Classes="subtle" HorizontalAlignment="Center" />
          <TextBlock Text="Feito com Avalonia · Capas: SteamGridDB · HUD: RTSS · Atualizações: Velopack"
                     Classes="subtle"
                     FontSize="11"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />
        </StackPanel>
      </Border>
    </Panel>

    <!-- Overlay "Iniciando <jogo>..." — feedback visual pedido pelo
         usuário ("feedback visual pra já kkk") pra cobrir o intervalo
         entre apertar confirmar e o jogo de fato aparecer na tela, que
         sem isso parecia que não tinha acontecido nada por alguns
         segundos. Some sozinho depois de um tempo fixo (ver
         MainViewModel.LaunchFeedbackMilliseconds) — não tem como saber
         com certeza quando o processo externo terminou de carregar.
         Último filho do Panel, então pinta por cima de tudo (inclusive os
         outros menus, embora não devam estar abertos ao mesmo tempo). -->
    <Panel IsVisible="{Binding IsLaunching}">
      <Border Classes="contextMenuOverlay" />
      <Border Classes="contextMenuCard" Width="420" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="18" HorizontalAlignment="Center">
          <!-- Ícone do jogo (SteamGridDB, seção Icons) — some quando o
               jogo ainda não tem ícone baixado. -->
          <Image Source="{Binding LaunchingGameIconPath, Converter={StaticResource FileToBitmapConverter}}"
                 IsVisible="{Binding LaunchingGameIconPath, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}"
                 Width="96" Height="96"
                 Stretch="Uniform"
                 HorizontalAlignment="Center" />
          <TextBlock Text="{Binding LaunchingGameTitle, StringFormat='Iniciando {0}...'}"
                     Classes="heroTitle"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />
          <ProgressBar IsIndeterminate="True" Width="240" />
        </StackPanel>
      </Border>
    </Panel>
  </Panel>
</Window>
