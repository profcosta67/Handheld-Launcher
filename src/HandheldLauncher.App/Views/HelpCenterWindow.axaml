<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="HandheldLauncher.App.Views.HelpCenterWindow"
        Title="Central de Ajuda"
        Width="760" Height="800"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}">

  <Window.Styles>
    <Style Selector="Button.check">
      <Setter Property="Background" Value="#202536" />
      <!-- v0.16.3: o cartão é sempre escuro; sem fixar a cor do texto, no tema
           Claro o texto vinha escuro sobre fundo escuro (print de 05/11). -->
      <Setter Property="Foreground" Value="#E6E9F2" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
      <Setter Property="Padding" Value="14" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FocusAdorner"><Template><Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="13" Margin="1"/></Template></Setter>
    </Style>
    <Style Selector="Button.check TextBlock">
      <Setter Property="Foreground" Value="#E6E9F2" />
    </Style>
    <Style Selector="Button.check TextBlock.subtle">
      <Setter Property="Foreground" Value="#AEB6C8" />
    </Style>
    <Style Selector="Button.check:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#2A3047" />
    </Style>
    <Style Selector="Button.pill"><Setter Property="FocusAdorner"><Template><Border BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="15" Margin="1"/></Template></Setter></Style>
  </Window.Styles>

  <Grid RowDefinitions="Auto,*,Auto" Margin="24">

    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,14">
      <TextBlock Text="🛟 Central de Ajuda" FontSize="{DynamicResource TextHeadingLarge}" FontWeight="Bold" />
      <TextBlock Text="Verificação rápida do launcher e do aparelho, e um manual com soluções. Nada aqui muda suas configurações."
                 Classes="subtle" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
        <Button x:Name="BtnTabChecks" Classes="pill" Content="🩺 Verificações" Click="OnTabChecksClick" />
        <Button x:Name="BtnTabManual" Classes="pill" Content="📖 Manual" Click="OnTabManualClick" />
      </StackPanel>
      <TextBlock x:Name="TxtSummary" Text="Verificando..." FontSize="{DynamicResource TextBody}" FontWeight="SemiBold" Margin="0,8,0,0" />
    </StackPanel>

    <Panel Grid.Row="1">
      <ScrollViewer x:Name="ChecksScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ResultsPanel" Spacing="10" Margin="0,0,10,8" />
      </ScrollViewer>

      <ScrollViewer x:Name="ManualScroll" IsVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ManualPanel" Spacing="8" Margin="0,0,10,8" />
      </ScrollViewer>

      <ScrollViewer x:Name="ArticleScroll" IsVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="ArticlePanel" Spacing="10" Margin="0,0,10,8" />
      </ScrollViewer>

      <ScrollViewer x:Name="ReportScroll" IsVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12" Margin="0,0,10,8">
          <Button Classes="pill" Content="← Voltar" HorizontalAlignment="Left" Click="OnReportBackClick" />
          <TextBlock Text="🐞 Reportar erro" FontSize="{DynamicResource TextTitle}" FontWeight="Bold" />
          <TextBlock x:Name="TxtReportStatus" Text="Preparando o pacote..." FontSize="{DynamicResource TextBodyLarge}" TextWrapping="Wrap" />
          <Border Background="#202536" CornerRadius="{DynamicResource RadiusMedium}" Padding="14" TextElement.Foreground="#E6E9F2">
            <StackPanel Spacing="6">
              <TextBlock Text="O que vai no pacote" FontWeight="Bold" />
              <TextBlock Classes="subtle" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"
                         Text="O relatório das verificações, o debug.log e as configurações. Antes de salvar, o launcher remove as chaves de API, o SteamID, o seu nome de usuário e o nome do PC. Nada é enviado sozinho — você escolhe pra onde mandar." />
            </StackPanel>
          </Border>
          <StackPanel x:Name="ReportActions" Spacing="10" IsVisible="False">
            <TextBlock Classes="subtle" FontSize="{DynamicResource TextSmall}" TextWrapping="Wrap"
                       Text="Mande o arquivo pelo grupo/WhatsApp, ou abra o relato no GitHub (precisa de conta) e arraste o arquivo pra lá." />
            <Button x:Name="BtnShowReport" Classes="pill" Content="📂 Mostrar o arquivo" HorizontalAlignment="Left" Click="OnShowReportClick" />
            <Button x:Name="BtnOpenIssue" Classes="pill primary" Content="🌐 Abrir relato no GitHub" HorizontalAlignment="Left" Click="OnOpenIssueClick" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </Panel>

    <StackPanel Grid.Row="2" Spacing="10" Margin="0,16,0,0">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" x:Name="TxtControls" Text="🎮 ↑↓: navegar | A: abrir | LB/RB: trocar aba | B: fechar"
                   VerticalAlignment="Center" Foreground="#8794AE" FontSize="{DynamicResource TextCaption}" TextWrapping="Wrap" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
          <Button x:Name="BtnRerun" Classes="pill" Content="🔄 Verificar de novo" Click="OnRerunClick" />
          <Button x:Name="BtnReport" Classes="pill" Content="🐞 Reportar erro" Click="OnReportClick" />
          <Button Classes="pill" Content="📂 Abrir pasta do log" Click="OnOpenLogFolderClick" />
          <Button Classes="pill primary" Content="✕ Fechar" Click="OnCloseClick" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Grid>
</Window>
