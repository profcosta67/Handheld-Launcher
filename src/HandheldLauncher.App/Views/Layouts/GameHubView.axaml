<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HandheldLauncher.App.ViewModels"
             xmlns:conv="using:HandheldLauncher.App.Converters"
             xmlns:dataConv="using:Avalonia.Data.Converters"
             x:Class="HandheldLauncher.App.Views.Layouts.GameHubView"
             x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <conv:FileToBitmapConverter x:Key="FileToBitmapConverter" />
        <conv:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
    </UserControl.Resources>

    <!-- v0.25.2: Classes="hubBar" — o layout Cartoon re-estiliza esta barra como
         balão de fala com moldura de tinta (ver Styles/CartoonTheme.axaml). -->
    <Border Classes="hubBar"
            Background="{DynamicResource BarBrush}" 
            CornerRadius="{DynamicResource BarCornerRadius}" 
            Margin="0,10,0,0" 
            Padding="24,16"
            BorderBrush="{DynamicResource SurfaceRaisedBrush}" 
            BorderThickness="1"
            IsVisible="{Binding SelectedTile, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}">
        
        <Grid ColumnDefinitions="320, 1, *, 160" VerticalAlignment="Center">
            
            <!-- 1. Identidade do Jogo -->
            <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,20,0">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="{DynamicResource RadiusSmall}" Background="#33232B3B" ClipToBounds="True">
                        <Image Source="{Binding SelectedTile.IconImagePath, Converter={StaticResource FileToBitmapConverter}}" Stretch="Uniform" Margin="4" />
                    </Border>
                    <TextBlock Text="{Binding SelectedTile.Title}" 
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="{DynamicResource TextHeading}" 
                               FontWeight="Bold" 
                               TextTrimming="CharacterEllipsis" 
                               MaxWidth="250"
                               VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                    <Border Background="{Binding SelectedTile.PlatformBadgeColorHex, Converter={StaticResource HexColorToBrushConverter}}" CornerRadius="4" Padding="6,2" IsVisible="{Binding SelectedTile.HasPlatformBadge}">
                        <TextBlock Text="{Binding SelectedTile.PlatformBadgeText}" Foreground="White" FontSize="{DynamicResource TextMicro}" FontWeight="Bold"/>
                    </Border>
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="4" Padding="6,2">
                        <TextBlock Text="{Binding SelectedTile.InstallStatusLabel}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource TextMicro}" FontWeight="Bold"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding SelectedTile.IsFavorite}" VerticalAlignment="Center">
                        <PathIcon Width="14" Height="14" Data="{StaticResource IconStar}" Foreground="{DynamicResource FavoriteBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Favorito" Foreground="{DynamicResource FavoriteBrush}" FontSize="{DynamicResource TextSmall}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Divisor -->
            <Rectangle Grid.Column="1" Width="1" Fill="{DynamicResource TextSecondaryBrush}" Opacity="0.15" Margin="0,0,20,0" />

            <!-- 2. Estatísticas e Descrição -->
            <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">

                <!-- ⭐ Nota da Steam -->
                <StackPanel Orientation="Horizontal" Spacing="8"
                            IsVisible="{Binding SelectedTile.HasReviewData}">
                    <TextBlock Text="{Binding SelectedTile.StarsString}"
                               FontSize="{DynamicResource TextBodyLarge}"
                               Foreground="#FFC83D"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedTile.ReviewLabel}"
                               FontSize="{DynamicResource TextCaption}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Linha de estatísticas -->
                <StackPanel Orientation="Horizontal" Spacing="16">
                    
                    <!-- ⏱️ Tempo de Jogo -->
                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding SelectedTile.ShowPlaytime}">
                        <PathIcon Width="14" Height="14" Data="{StaticResource IconClock}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedTile.PlaytimeLabel}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="{DynamicResource TextSmall}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 🕒 Última Sessão -->
                    <StackPanel Orientation="Horizontal" Spacing="4"
                                IsVisible="{Binding SelectedTile.HasLastPlayed}">
                        <PathIcon Width="14" Height="14" Data="{StaticResource IconCalendar}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedTile.LastPlayedLabel}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="{DynamicResource TextSmall}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 🏷️ Gênero -->
                    <StackPanel Orientation="Horizontal" Spacing="4"
                                IsVisible="{Binding SelectedTile.HasGenre}">
                        <PathIcon Width="14" Height="14" Data="{StaticResource IconTag}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedTile.Genre}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="{DynamicResource TextSmall}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Adicione isso na linha de estatísticas (junto com tempo, última sessão e gênero) -->
                <StackPanel Orientation="Horizontal" Spacing="4"
                            IsVisible="{Binding SelectedTile.HasAchievements}">
                    <PathIcon Width="12" Height="12" Data="{StaticResource IconTrophy}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedTile.AchievementBadgeLabel}" FontSize="{DynamicResource TextCaption}"
                            Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
                    
                </StackPanel>

                <!-- Descrição -->
                <TextBlock Text="{Binding SelectedTile.Description, Converter={x:Static conv:HtmlDecodeConverter.Instance}}" 
                           Foreground="{DynamicResource TextSecondaryBrush}" 
                           FontSize="{DynamicResource TextSmall}" 
                           TextWrapping="Wrap" 
                           MaxLines="2" 
                           TextTrimming="CharacterEllipsis" 
                           IsVisible="{Binding SelectedTile.HasDescription}" 
                           Margin="0,4,0,0"/>
            </StackPanel>

            <!-- 3. Botão Jogar -->
            <Button Grid.Column="3" 
                    Classes="switchAction hubPlay" 
                    Content="JOGAR (A)" 
                    HorizontalAlignment="Right" 
                    VerticalAlignment="Center"
                    Width="140" Height="46" 
                    FontWeight="Bold" 
                    FontSize="{DynamicResource TextBodyLarge}" />
        </Grid>
    </Border>
</UserControl>