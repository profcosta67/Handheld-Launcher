<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:anim="https://github.com/whistyun/AnimatedImage.Avalonia"
             xmlns:vm="using:HandheldLauncher.App.ViewModels"
             xmlns:conv="using:HandheldLauncher.App.Converters"
             xmlns:dataConv="using:Avalonia.Data.Converters"
             xmlns:media="using:Avalonia.Media"
             x:Class="HandheldLauncher.App.Views.Layouts.BigScreenLibraryLayout"
             x:DataType="vm:MainViewModel">

  <UserControl.Resources>
    <conv:FileToBitmapConverter x:Key="FileToBitmapConverter" />
    <conv:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.bigScreenTab">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="13" />
      <Setter Property="Padding" Value="7,8" />
      <Setter Property="MinHeight" Value="56" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.bigScreenTab /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Opacity" Value="0.94" />
    </Style>
    <Style Selector="Button.bigScreenTab:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="#252C3B" />
    </Style>
    <Style Selector="Button.bigScreenTab.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
    </Style>
  </UserControl.Styles>

  <Panel>

    <Image x:Name="HeroBackImage" Stretch="UniformToFill" IsHitTestVisible="False">
      <Image.Effect>
        <media:BlurEffect Radius="46" />
      </Image.Effect>
    </Image>
    <Image x:Name="HeroImage"
           Source="{Binding SelectedTile.BannerImagePath, Converter={StaticResource FileToBitmapConverter}}"
           Stretch="UniformToFill"
           Opacity="0.48"
           IsHitTestVisible="False">
      <Image.Effect>
        <media:BlurEffect Radius="24" />
      </Image.Effect>
    </Image>

    <Border Background="#88070A12" IsHitTestVisible="False" />

    <Grid ColumnDefinitions="104,*" RowDefinitions="*" Margin="24,20,32,20">

      <StackPanel Grid.Column="0" Grid.Row="0"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Stretch"
                  Spacing="8"
                  Margin="0,0,14,0">
        <Button Classes="bigScreenTab" Classes.active="{Binding IsFilterFavoritesActive}" Command="{Binding SetFilterFavoritesCommand}" ToolTip.Tip="Favoritos" MinHeight="56" Padding="5">
          <StackPanel HorizontalAlignment="Center" Spacing="2"><TextBlock Text="★" FontSize="22"/><TextBlock Text="Favoritos" FontSize="10"/></StackPanel>
        </Button>
        <Button Classes="bigScreenTab" Classes.active="{Binding IsFilterAllActive}" Command="{Binding SetFilterAllCommand}" ToolTip.Tip="Todos os jogos" MinHeight="62" Padding="4">
          <StackPanel HorizontalAlignment="Center" Spacing="2"><TextBlock Text="▦" FontSize="22"/><TextBlock Text="Todos" FontSize="10"/></StackPanel>
        </Button>
        <Button Classes="bigScreenTab" Classes.active="{Binding IsFilterComputerActive}" Command="{Binding SetFilterComputerCommand}" ToolTip.Tip="Computador" MinHeight="62" Padding="4">
          <StackPanel HorizontalAlignment="Center" Spacing="2"><TextBlock Text="⌨" FontSize="22"/><TextBlock Text="Computador" FontSize="9"/></StackPanel>
        </Button>
        <Button Classes="bigScreenTab" Classes.active="{Binding IsFilterEmulatorsActive}" Command="{Binding SetFilterEmulatorsCommand}" ToolTip.Tip="Emuladores" MinHeight="62" Padding="4">
          <StackPanel HorizontalAlignment="Center" Spacing="2"><TextBlock Text="◈" FontSize="22"/><TextBlock Text="Emuladores" FontSize="9"/></StackPanel>
        </Button>
        <Button Classes="bigScreenTab" Classes.active="{Binding IsFilterApplicationsActive}" Command="{Binding SetFilterApplicationsCommand}" ToolTip.Tip="Programas" MinHeight="62" Padding="4">
          <StackPanel HorizontalAlignment="Center" Spacing="2"><TextBlock Text="▣" FontSize="22"/><TextBlock Text="Programas" FontSize="9"/></StackPanel>
        </Button>
        <Button Classes="bigScreenTab" Classes.active="{Binding IsFilterNotInstalledActive}" Command="{Binding SetFilterNotInstalledCommand}" ToolTip.Tip="Não instalados" MinHeight="62" Padding="4">
          <StackPanel HorizontalAlignment="Center" Spacing="2"><TextBlock Text="↓" FontSize="22"/><TextBlock Text="Não instalados" FontSize="9"/></StackPanel>
        </Button>
        <Button Classes="bigScreenTab" Content="＋  Adicionar" MinHeight="42" Padding="6,8"
                FontSize="10" ToolTip.Tip="Adicionar jogo ou programa"
                IsVisible="{Binding IsFilterApplicationsActive}" Click="OnAddProgramClick" />

      </StackPanel>

      <Grid Grid.Column="1" Grid.Row="0" RowDefinitions="Auto,Auto,*,Auto,Auto" VerticalAlignment="Stretch">

        <Grid Grid.Row="0" Height="82" ColumnDefinitions="*,Auto,*" IsVisible="{Binding SelectedTile, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}">
          <Image Grid.Column="1"
                 Source="{Binding SelectedTile.LogoImagePath, Converter={StaticResource FileToBitmapConverter}}"
                 Width="260"
                 Height="64"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsVisible="{Binding SelectedTile.ShowCurrentLogo}" />

          <TextBlock Grid.Column="1"
                     Text="{Binding SelectedTile.Title}"
                     Foreground="#FFF5F7FF"
                     FontSize="27"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding SelectedTile.ShowNameCaption}" />

          <Border Grid.Column="2"
                  Background="#AA10131B"
                  BorderBrush="#445F6F8D"
                  BorderThickness="1"
                  CornerRadius="14"
                  Padding="16,9"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
              <Button Classes="pill" Content="Wi-Fi" FontSize="10" Padding="8,5" Click="OnOpenWifiSettingsClick" ToolTip.Tip="Abrir configurações de Wi-Fi" />
              <Button Classes="pill" Content="Bluetooth" FontSize="10" Padding="8,5" Click="OnOpenBluetoothSettingsClick" ToolTip.Tip="Abrir configurações de Bluetooth" />
              <Border Width="1" Height="22" Background="#556C7898" />
              <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" ToolTip.Tip="{Binding TopBarTdpToolTip}">
                <TextBlock Text="⚡" Foreground="#FFFFB84D" FontSize="13" VerticalAlignment="Center" />
                <TextBlock Text="{Binding TopBarTdpText}" Foreground="#FFF5F7FF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock Text="TDP" Foreground="#FF9BA8C4" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <Border Width="1" Height="22" Background="#556C7898" />
              <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <TextBlock Text="◷" Foreground="#FF9BA8C4" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ClockText}" Foreground="#FFF5F7FF" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
              <Border Width="1" Height="22" Background="#556C7898" />
              <TextBlock Text="{Binding BatteryStatusText}"
                         Foreground="#FFB8C1D4"
                         FontSize="11"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>
        </Grid>

        <Border Grid.Row="3"
                Background="#E6111520"
                BorderBrush="#887B8499"
                BorderThickness="1"
                CornerRadius="20"
                Padding="28,20"
                MinHeight="148"
                HorizontalAlignment="Stretch"
                MaxWidth="1180"
                IsVisible="{Binding SelectedTile, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}">
          <Grid ColumnDefinitions="82,*">
            <Border Grid.Column="0"
                    Width="60" Height="60"
                    CornerRadius="12"
                    Background="#33232B3B"
                    ClipToBounds="True"
                    VerticalAlignment="Center">
              <Image Source="{Binding SelectedTile.IconImagePath, Converter={StaticResource FileToBitmapConverter}}"
                     Stretch="Uniform"
                     Margin="5" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="{Binding SelectedTile.Title}"
                         Foreground="#FFF5F7FF"
                         FontSize="25"
                         FontWeight="Bold"
                         TextTrimming="CharacterEllipsis"
                         MaxWidth="960" />
              <StackPanel Orientation="Horizontal" Spacing="20">
                <TextBlock Text="{Binding SelectedTile.SourceLabel}"
                           Foreground="#FF9BA8C4"
                           FontSize="11"
                           FontWeight="Bold" />
                <Border Width="1" Height="15" Background="#556C7898" />
                <TextBlock Text="{Binding SelectedTile.InstallStatusLabel}"
                           Foreground="#FF9ED6B0"
                           FontSize="11"
                           FontWeight="Bold" />
                <Border Width="1" Height="15" Background="#556C7898" />
                <TextBlock Text="{Binding SelectedTile.PlaytimeLabel}"
                           Foreground="#FFB8C1D4"
                           FontSize="11"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedTile.FavoriteLabel}"
                           Foreground="#FFFFC45C"
                           FontSize="11"
                           FontWeight="Bold" />
              </StackPanel>
              <TextBlock Text="{Binding SelectedTile.Description}"
                         Foreground="#FFD1D8E8"
                         FontSize="12"
                         TextWrapping="Wrap"
                         MaxHeight="38"
                         TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding SelectedTile.HasDescription}" />
            </StackPanel>
          </Grid>
        </Border>

        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding SubFilters}"
                      IsVisible="{Binding HasSubFilters}"
                      HorizontalAlignment="Center"
                      Margin="0,4,0,8">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SubFilterViewModel">
              <Button Classes="pill subFilter"
                      MinWidth="82"
                      Classes.cursor="{Binding IsCursor}"
                      Content="{Binding Label}"
                      Click="OnSubFilterClick"
                      Background="{Binding BackgroundHex, Converter={StaticResource HexColorToBrushConverter}}"
                      Foreground="{Binding ForegroundHex, Converter={StaticResource HexColorToBrushConverter}}"
                      BorderBrush="{Binding AccentHex, Converter={StaticResource HexColorToBrushConverter}}"
                      BorderThickness="2"
                      Padding="12,7" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ScrollViewer x:Name="GameRowScrollViewer"
                      Grid.Row="2"
                      MinHeight="220"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      HorizontalContentAlignment="Left"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled">
          <ScrollViewer.Transitions>
            <Transitions>
              <VectorTransition Property="Offset" Duration="0:0:0.22" Easing="CubicEaseOut" />
            </Transitions>
          </ScrollViewer.Transitions>

          <!-- Biblioteca Capsule Wide: fileira contínua, sem efeito de roleta/carrossel. -->
          <ItemsControl x:Name="GamesItemsControl"
                        ItemsSource="{Binding Games}"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"
                            Spacing="20"
                            Margin="28,18,28,18"
                            VerticalAlignment="Center" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GameTileViewModel">
                <Border Width="320"
                        Height="180"
                        CornerRadius="17"
                        Background="#D9151925"
                        BorderBrush="#667B8499"
                        BorderThickness="1"
                        ClipToBounds="True"
                        PointerPressed="OnTilePointerPressed"
                        DoubleTapped="OnTileDoubleTapped">
                  <Grid>
                    <Image Source="{Binding WideCapsuleImagePath, Converter={StaticResource FileToBitmapConverter}}"
                           Stretch="UniformToFill"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Stretch" />
                    <Border Background="#55000000"
                            IsVisible="{Binding ShowEmptyWideCapsulePlaceholder}">
                      <TextBlock Text="{Binding Title}"
                                 Foreground="#FFF5F7FF"
                                 FontSize="19"
                                 FontWeight="SemiBold"
                                 TextWrapping="Wrap"
                                 TextAlignment="Center"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Margin="18" />
                    </Border>
                    <Border Background="#B8000000"
                            Height="48"
                            VerticalAlignment="Bottom"
                            Padding="14,7">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Title}"
                                   Foreground="#FFF5F7FF"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="1"
                                Background="{Binding PlatformBadgeColorHex, Converter={StaticResource HexColorToBrushConverter}}"
                                CornerRadius="5"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                IsVisible="{Binding HasPlatformBadge}">
                          <TextBlock Text="{Binding PlatformBadgeText}"
                                     FontSize="10"
                                     FontWeight="Bold"
                                     Foreground="White" />
                        </Border>
                      </Grid>
                    </Border>
                    <TextBlock Text="★"
                               Foreground="#FFFFC45C"
                               FontSize="18"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="12"
                               IsVisible="{Binding IsFavorite}" />
                    <Border BorderBrush="#FFF5F7FF"
                            CornerRadius="14"
                            BorderThickness="3"
                            IsHitTestVisible="False"
                            IsVisible="{Binding IsFocused}" />
                    <Border BorderBrush="{DynamicResource AccentBrush}"
                            CornerRadius="11"
                            BorderThickness="2"
                            Margin="5"
                            IsHitTestVisible="False"
                            IsVisible="{Binding IsFocused}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </Grid>

      <TextBlock Grid.Row="0" Grid.Column="1"
                 Text="SUA BIBLIOTECA&#10;Adicione jogos para começar sua experiência."
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"
                 Margin="24"
                 IsVisible="{Binding SelectedTile, Converter={x:Static dataConv:ObjectConverters.IsNull}}" />

      <Border Grid.Row="4"
              Grid.Column="1"
              HorizontalAlignment="Center"
              Margin="0,8,0,0"
              Padding="14,7"
              Background="#CC101521"
              BorderBrush="#557B8499"
              BorderThickness="1"
              CornerRadius="14">
        <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="D-PAD" Foreground="#FFFFFFFF" FontSize="10" FontWeight="Bold" />
            <TextBlock Text="Navegar" Foreground="#FFB8C1D4" FontSize="10" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="A" Foreground="#FFFFFFFF" FontSize="10" FontWeight="Bold" />
            <TextBlock Text="Abrir" Foreground="#FFB8C1D4" FontSize="10" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="X" Foreground="#FFFFFFFF" FontSize="10" FontWeight="Bold" />
            <TextBlock Text="Detalhes" Foreground="#FFB8C1D4" FontSize="10" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="Y" Foreground="#FFFFFFFF" FontSize="10" FontWeight="Bold" />
            <TextBlock Text="Downloads" Foreground="#FFB8C1D4" FontSize="10" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Text="START" Foreground="#FFFFFFFF" FontSize="10" FontWeight="Bold" />
            <TextBlock Text="Menu" Foreground="#FFB8C1D4" FontSize="10" />
          </StackPanel>
        </StackPanel>
      </Border>

    </Grid>
  </Panel>
</UserControl>