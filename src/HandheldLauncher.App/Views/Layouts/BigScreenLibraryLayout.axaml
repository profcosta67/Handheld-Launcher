<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:anim="https://github.com/whistyun/AnimatedImage.Avalonia"
             xmlns:vm="using:HandheldLauncher.App.ViewModels"
             xmlns:conv="using:HandheldLauncher.App.Converters"
             xmlns:dataConv="using:Avalonia.Data.Converters"
             xmlns:media="using:Avalonia.Media"
             x:Class="HandheldLauncher.App.Views.Layouts.BigScreenLibraryLayout"
             x:DataType="vm:MainViewModel">

  <UserControl.Resources>
    <conv:FileToBitmapConverter x:Key="FileToBitmapConverter" />
    <conv:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
      <!-- 🟢 Novo estilo de abas modernas -->
    <Style Selector="Button.modernTab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#99FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.2" />
          <BrushTransition Property="Foreground" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.modernTab:pointerover">
      <Setter Property="Background" Value="#20FFFFFF" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>
    <Style Selector="Button.modernTab.active">
      <Setter Property="Background" Value="#30FFFFFF" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="BorderBrush" Value="#40FFFFFF" />
    </Style>
    <!-- Para manter o accent de cores específicas nos botões ativos -->
    <Style Selector="Button.modernTab.active:nth-child(1)">
      <Setter Property="BorderBrush" Value="#FF78A9FF" /> <!-- Favoritos: Azul -->
    </Style>
    <Style Selector="Button.bigScreenTab">
      <Setter Property="Width" Value="112" />
      <Setter Property="Height" Value="72" />
      <Setter Property="MinWidth" Value="112" />
      <Setter Property="MinHeight" Value="72" />
      <Setter Property="Padding" Value="10,7" />
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="CornerRadius" Value="15" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.bigScreenTab /template/ ContentPresenter">
      <Setter Property="BorderThickness" Value="1.5" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Opacity" Value="0.98" />
    </Style>
    <Style Selector="Button.bigScreenTab:pointerover">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.bigScreenTab.active">
      <Setter Property="BorderThickness" Value="2" />
    </Style>
  </UserControl.Styles>

  <Panel>

    <Image x:Name="HeroBackImage" Stretch="UniformToFill" IsHitTestVisible="False">
      <Image.Effect>
        <media:BlurEffect Radius="46" />
      </Image.Effect>
    </Image>
    <Image x:Name="HeroImage"
           anim:ImageBehavior.AnimatedSource="{Binding SelectedTile.BannerImagePath}"
           Stretch="UniformToFill"
           Opacity="0.48"
           IsHitTestVisible="False">
      <Image.Effect>
        <media:BlurEffect Radius="24" />
      </Image.Effect>
    </Image>

    <Border Background="#88070A12" IsHitTestVisible="False" />

    <Grid ColumnDefinitions="*" RowDefinitions="Auto,*" Margin="24,14,32,20">

            <StackPanel Grid.Column="0" Grid.Row="0"
                  Orientation="Horizontal"
                  VerticalAlignment="Top"
                  HorizontalAlignment="Center"
                  Spacing="8"
                  Margin="0,0,0,18">
        
        <!-- Fundo de vidro para a barra inteira -->
        <Border Background="#20FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="18" Padding="6" BoxShadow="0 4 12 0 #40000000">
            <StackPanel Orientation="Horizontal" Spacing="4">
                
                <!-- Favoritos -->
                <Button Classes="modernTab" Classes.active="{Binding IsFilterFavoritesActive}" Command="{Binding SetFilterFavoritesCommand}" ToolTip.Tip="Favoritos">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="★" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Favoritos" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Todos -->
                <Button Classes="modernTab" Classes.active="{Binding IsFilterAllActive}" Command="{Binding SetFilterAllCommand}" ToolTip.Tip="Todos os jogos">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="▦" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Todos" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Computador -->
                <Button Classes="modernTab" Classes.active="{Binding IsFilterComputerActive}" Command="{Binding SetFilterComputerCommand}" ToolTip.Tip="Computador">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="⌨" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Computador" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Emuladores -->
                <Button Classes="modernTab" Classes.active="{Binding IsFilterEmulatorsActive}" Command="{Binding SetFilterEmulatorsCommand}" ToolTip.Tip="Emuladores">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="◈" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Emuladores" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Programas -->
                <Button Classes="modernTab" Classes.active="{Binding IsFilterApplicationsActive}" Command="{Binding SetFilterApplicationsCommand}" ToolTip.Tip="Programas">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="▣" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Programas" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Não Instalados -->
                <Button Classes="modernTab" Classes.active="{Binding IsFilterNotInstalledActive}" Command="{Binding SetFilterNotInstalledCommand}" ToolTip.Tip="Não instalados">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="↓" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Não instalados" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- v0.18: Nuvem (Xbox Cloud Gaming) -->
                <Button Classes="modernTab" Classes.active="{Binding IsFilterCloudActive}" Command="{Binding SetFilterCloudCommand}" ToolTip.Tip="Nuvem (Xbox Cloud Gaming)">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="☁" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Nuvem" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Adicionar -->
                <Button Classes="modernTab accent" Background="#403E9B70" BorderBrush="#FF75D6A2" Foreground="#FF75D6A2" ToolTip.Tip="Adicionar jogo"
                        IsVisible="{Binding IsFilterApplicationsActive}" Click="OnAddProgramClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="＋" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Adicionar" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

            </StackPanel>
        </Border>
      </StackPanel>
      
      <Border Grid.Row="0" Background="#AA10131B" BorderBrush="#445F6F8D" BorderThickness="1"
              CornerRadius="14" Padding="16,9" VerticalAlignment="Top" HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Classes="pill" Content="Wi-Fi" FontSize="10" Padding="8,5" Click="OnOpenWifiSettingsClick" ToolTip.Tip="Abrir configurações de Wi-Fi" />
          <Button Classes="pill" Content="Bluetooth" FontSize="10" Padding="8,5" Click="OnOpenBluetoothSettingsClick" ToolTip.Tip="Abrir configurações de Bluetooth" />
          <Border Width="1" Height="22" Background="#556C7898" />
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" ToolTip.Tip="{Binding TopBarTdpToolTip}">
            <TextBlock Text="⚡" Foreground="#FFFFB84D" FontSize="13" VerticalAlignment="Center" />
            <TextBlock Text="{Binding TopBarTdpText}" Foreground="#FFF5F7FF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock Text="TDP" Foreground="#FF9BA8C4" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <Border Width="1" Height="22" Background="#556C7898" />
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
            <TextBlock Text="◷" Foreground="#FF9BA8C4" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="{Binding ClockText}" Foreground="#FFF5F7FF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
          </StackPanel>
          <Border Width="1" Height="22" Background="#556C7898" />
          <TextBlock Text="{Binding BatteryStatusText}" Foreground="#FFB8C1D4" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <Grid Grid.Column="0" Grid.Row="1" RowDefinitions="Auto,Auto,*,Auto" VerticalAlignment="Stretch">

        <Grid Grid.Row="0" Height="132" ColumnDefinitions="*,Auto,*" IsVisible="{Binding SelectedTile, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}">
          <Image Grid.Column="1"
                 Source="{Binding SelectedTile.LogoImagePath, Converter={StaticResource FileToBitmapConverter}}"
                 Width="320"
                 Height="76"
                 Margin="0,42,0,0"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Bottom"
                 IsVisible="{Binding SelectedTile.ShowCurrentLogo}" />

          <TextBlock Grid.Column="1"
                     Text="{Binding SelectedTile.Title}"
                     Foreground="#FFF5F7FF"
                     FontSize="30"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Bottom"
                     Margin="0,0,0,10"
                     TextTrimming="CharacterEllipsis"
                     IsVisible="{Binding SelectedTile.ShowNameCaption}" />


        </Grid>

        <Border Grid.Row="3"
                Background="#E6111520"
                BorderBrush="#887B8499"
                BorderThickness="1"
                CornerRadius="20"
                Padding="28,20"
                MinHeight="148"
                HorizontalAlignment="Stretch"
                MaxWidth="1180"
                IsVisible="{Binding SelectedTile, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}">
          <Grid ColumnDefinitions="82,*">
            <Border Grid.Column="0"
                    Width="60" Height="60"
                    CornerRadius="12"
                    Background="#33232B3B"
                    ClipToBounds="True"
                    VerticalAlignment="Center">
              <Image Source="{Binding SelectedTile.IconImagePath, Converter={StaticResource FileToBitmapConverter}}"
                     Stretch="Uniform"
                     Margin="5" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="7" VerticalAlignment="Center">
              <TextBlock Text="{Binding SelectedTile.Title}"
                         Foreground="#FFF5F7FF"
                         FontSize="25"
                         FontWeight="Bold"
                         TextTrimming="CharacterEllipsis"
                         MaxWidth="960" />
              <StackPanel Orientation="Horizontal" Spacing="20">
                <TextBlock Text="{Binding SelectedTile.SourceLabel}"
                           Foreground="#FF9BA8C4"
                           FontSize="11"
                           FontWeight="Bold" />
                <Border Width="1" Height="15" Background="#556C7898" />
                <TextBlock Text="{Binding SelectedTile.InstallStatusLabel}"
                           Foreground="#FF9ED6B0"
                           FontSize="11"
                           FontWeight="Bold" />
                <Border Width="1" Height="15" Background="#556C7898" />
                <TextBlock Text="{Binding SelectedTile.PlaytimeLabel}"
                           Foreground="#FFB8C1D4"
                           FontSize="11"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedTile.FavoriteLabel}"
                           Foreground="#FFFFC45C"
                           FontSize="11"
                           FontWeight="Bold" />
              </StackPanel>
              <TextBlock Text="{Binding SelectedTile.Description}"
                         Foreground="#FFD1D8E8"
                         FontSize="12"
                         TextWrapping="Wrap"
                         MaxHeight="38"
                         TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding SelectedTile.HasDescription}" />
            </StackPanel>
          </Grid>
        </Border>

        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding SubFilters}"
                      IsVisible="{Binding HasSubFilters}"
                      HorizontalAlignment="Center"
                      Margin="0,36,0,12">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SubFilterViewModel">
              <Button Classes="pill subFilter"
                      MinWidth="82"
                      Classes.cursor="{Binding IsCursor}"
                      Content="{Binding Label}"
                      Click="OnSubFilterClick"
                      Background="{Binding BackgroundHex, Converter={StaticResource HexColorToBrushConverter}}"
                      Foreground="{Binding ForegroundHex, Converter={StaticResource HexColorToBrushConverter}}"
                      BorderBrush="{Binding AccentHex, Converter={StaticResource HexColorToBrushConverter}}"
                      BorderThickness="2"
                      Padding="12,7" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ScrollViewer x:Name="GameRowScrollViewer"
                      Grid.Row="2"
                      MinHeight="220"
                      VerticalAlignment="Stretch"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      HorizontalContentAlignment="Left"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled">
          <ScrollViewer.Transitions>
            <Transitions>
              <VectorTransition Property="Offset" Duration="0:0:0.22" Easing="CubicEaseOut" />
            </Transitions>
          </ScrollViewer.Transitions>

          <ItemsControl x:Name="GamesItemsControl"
                        ItemsSource="{Binding Games}"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"
                            Spacing="20"
                            Margin="28,18,28,18"
                            VerticalAlignment="Center" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GameTileViewModel">
                <Border Width="320"
                        Height="180"
                        CornerRadius="17"
                        Background="#D9151925"
                        BorderBrush="#667B8499"
                        BorderThickness="1"
                        ClipToBounds="True"
                        PointerPressed="OnTilePointerPressed"
                        DoubleTapped="OnTileDoubleTapped">
                  <Grid>
                    <Image anim:ImageBehavior.AnimatedSource="{Binding WideCapsuleImagePath}"
                          Stretch="UniformToFill"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" />
                    <Border Background="#55000000"
                            IsVisible="{Binding ShowEmptyWideCapsulePlaceholder}">
                      <TextBlock Text="{Binding Title}"
                                 Foreground="#FFF5F7FF"
                                 FontSize="19"
                                 FontWeight="SemiBold"
                                 TextWrapping="Wrap"
                                 TextAlignment="Center"
                                 VerticalAlignment="Center"
                                 HorizontalAlignment="Center"
                                 Margin="18" />
                    </Border>
                    <Border Background="#B8000000"
                            Height="48"
                            VerticalAlignment="Bottom"
                            Padding="14,7">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Title}"
                                   Foreground="#FFF5F7FF"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Border Grid.Column="1"
                                Background="{Binding PlatformBadgeColorHex, Converter={StaticResource HexColorToBrushConverter}}"
                                CornerRadius="5"
                                Padding="6,2"
                                VerticalAlignment="Center"
                                IsVisible="{Binding HasPlatformBadge}">
                          <TextBlock Text="{Binding PlatformBadgeText}"
                                     FontSize="10"
                                     FontWeight="Bold"
                                     Foreground="White" />
                        </Border>
                      </Grid>
                    </Border>
                    <TextBlock Text="★"
                               Foreground="#FFFFC45C"
                               FontSize="18"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="12"
                               IsVisible="{Binding IsFavorite}" />
                    <Border BorderBrush="#FFF5F7FF"
                            CornerRadius="14"
                            BorderThickness="3"
                            IsHitTestVisible="False"
                            IsVisible="{Binding IsFocused}" />
                    <Border BorderBrush="{DynamicResource AccentBrush}"
                            CornerRadius="11"
                            BorderThickness="2"
                            Margin="5"
                            IsHitTestVisible="False"
                            IsVisible="{Binding IsFocused}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

      </Grid>

      <TextBlock Grid.Row="1" Grid.Column="0"
                 Text="SUA BIBLIOTECA&#10;Adicione jogos para começar sua experiência."
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"
                 Margin="24"
                 IsVisible="{Binding SelectedTile, Converter={x:Static dataConv:ObjectConverters.IsNull}}" />



    </Grid>
  </Panel>
</UserControl>