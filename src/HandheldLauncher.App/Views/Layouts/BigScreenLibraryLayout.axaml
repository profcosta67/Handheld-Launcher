<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:anim="https://github.com/whistyun/AnimatedImage.Avalonia"
             xmlns:vm="using:HandheldLauncher.App.ViewModels"
             xmlns:conv="using:HandheldLauncher.App.Converters"
             xmlns:dataConv="using:Avalonia.Data.Converters"
             xmlns:media="using:Avalonia.Media"
             xmlns:layouts="using:HandheldLauncher.App.Views.Layouts"
             x:Class="HandheldLauncher.App.Views.Layouts.BigScreenLibraryLayout"
             x:DataType="vm:MainViewModel">

  <UserControl.Resources>
    <conv:FileToBitmapConverter x:Key="FileToBitmapConverter" />
    <conv:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.modernTab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#99FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Padding" Value="16,8" />
      <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.modernTab:pointerover">
      <Setter Property="Background" Value="#20FFFFFF" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
    </Style>
    <Style Selector="Button.modernTab.active">
      <Setter Property="Background" Value="#30FFFFFF" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="BorderBrush" Value="#40FFFFFF" />
    </Style>
    <Style Selector="Button.addGhostCard">
      <Setter Property="Width" Value="320" />
      <Setter Property="Height" Value="180" />
      <Setter Property="CornerRadius" Value="17" />
      <Setter Property="Background" Value="#40151925" />
      <Setter Property="BorderBrush" Value="#667B8499" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Margin" Value="20,18,20,18" />
      <Setter Property="Focusable" Value="True" />
    </Style>
    <Style Selector="Button.addGhostCard:focus, Button.addGhostCard.addFocused">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="#60151925" />
    </Style>
  </UserControl.Styles>

  <Panel>
    <Image x:Name="HeroBackImage" Stretch="UniformToFill" IsHitTestVisible="False">
      <Image.Effect><media:BlurEffect Radius="6" /></Image.Effect>
    </Image>
    <Image x:Name="HeroImage" Source="{Binding SelectedTile.BannerImagePath}" Stretch="UniformToFill" Opacity="0.48" IsHitTestVisible="False">
      <Image.Effect><media:BlurEffect Radius="4" /></Image.Effect>
    </Image>
    <Border Background="#88070A12" IsHitTestVisible="False" />

    <Grid ColumnDefinitions="*" RowDefinitions="Auto,*,Auto" Margin="24,14,32,20">

      <StackPanel Grid.Column="0" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center" Spacing="8" Margin="0,0,0,18">
        <Border Background="#20FFFFFF" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="18" Padding="6" BoxShadow="0 4 12 0 #40000000">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Classes="modernTab" Classes.active="{Binding IsFilterFavoritesActive}" Command="{Binding SetFilterFavoritesCommand}"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Width="16" Height="16" Data="{StaticResource IconStar}"/><TextBlock Text="Favoritos" FontSize="13" FontWeight="SemiBold"/></StackPanel></Button>
                <Button Classes="modernTab" Classes.active="{Binding IsFilterAllActive}" Command="{Binding SetFilterAllCommand}"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Width="16" Height="16" Data="{StaticResource IconGrid}"/><TextBlock Text="Todos" FontSize="13" FontWeight="SemiBold"/></StackPanel></Button>
                <Button Classes="modernTab" Classes.active="{Binding IsFilterComputerActive}" Command="{Binding SetFilterComputerCommand}"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Width="16" Height="16" Data="{StaticResource IconMonitor}"/><TextBlock Text="Computador" FontSize="13" FontWeight="SemiBold"/></StackPanel></Button>
                <Button Classes="modernTab" Classes.active="{Binding IsFilterEmulatorsActive}" Command="{Binding SetFilterEmulatorsCommand}"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Width="16" Height="16" Data="{StaticResource IconGamepad}"/><TextBlock Text="Emuladores" FontSize="13" FontWeight="SemiBold"/></StackPanel></Button>
                <Button Classes="modernTab" Classes.active="{Binding IsFilterApplicationsActive}" Command="{Binding SetFilterApplicationsCommand}"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Width="16" Height="16" Data="{StaticResource IconAppWindow}"/><TextBlock Text="Programas" FontSize="13" FontWeight="SemiBold"/></StackPanel></Button>
                <Button Classes="modernTab" Classes.active="{Binding IsFilterNotInstalledActive}" Command="{Binding SetFilterNotInstalledCommand}"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Width="16" Height="16" Data="{StaticResource IconDownload}"/><TextBlock Text="Não instalados" FontSize="13" FontWeight="SemiBold"/></StackPanel></Button>
                <Button Classes="modernTab" Classes.active="{Binding IsFilterCloudActive}" Command="{Binding SetFilterCloudCommand}"><StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Width="16" Height="16" Data="{StaticResource IconCloud}"/><TextBlock Text="Nuvem" FontSize="13" FontWeight="SemiBold"/></StackPanel></Button>
            </StackPanel>
        </Border>
      </StackPanel>
      
      <Border Grid.Row="0" Background="#AA10131B" BorderBrush="#445F6F8D" BorderThickness="1" CornerRadius="14" Padding="16,9" VerticalAlignment="Top" HorizontalAlignment="Right">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Classes="pill" Content="Wi-Fi" FontSize="10" Padding="8,5" Click="OnOpenWifiSettingsClick" />
          <Button Classes="pill" Content="Bluetooth" FontSize="10" Padding="8,5" Click="OnOpenBluetoothSettingsClick" />
          <Border Width="1" Height="22" Background="#556C7898" />
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"><TextBlock Text="⚡" Foreground="#FFFFB84D" FontSize="13" VerticalAlignment="Center" /><TextBlock Text="{Binding TopBarTdpText}" Foreground="#FFF5F7FF" FontSize="14" FontWeight="Bold" VerticalAlignment="Center" /><TextBlock Text="TDP" Foreground="#FF9BA8C4" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
          <Border Width="1" Height="22" Background="#556C7898" />
          <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"><TextBlock Text="◷" Foreground="#FF9BA8C4" FontSize="16" VerticalAlignment="Center" /><TextBlock Text="{Binding ClockText}" Foreground="#FFF5F7FF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
          <Border Width="1" Height="22" Background="#556C7898" />
          <TextBlock Text="{Binding BatteryStatusText}" Foreground="#FFB8C1D4" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Border>

      <layouts:CloudGridView x:Name="CloudGrid" Grid.Column="0" Grid.Row="1" Margin="0,12,0,0" IsVisible="{Binding IsFilterCloudActive}" />

      <Grid Grid.Column="0" Grid.Row="1" RowDefinitions="Auto,Auto,*" VerticalAlignment="Top" IsVisible="{Binding !IsFilterCloudActive}">
        <!-- 🟢 MUDANÇA: altura 132→160 e vertical alinhado ao centro (logo/nome não gruda mais na grade) -->
        <Grid Grid.Row="0" Height="160" ColumnDefinitions="*,Auto,*" IsVisible="{Binding SelectedTile, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}">
          <Image Grid.Column="1" Source="{Binding SelectedTile.LogoImagePath, Converter={StaticResource FileToBitmapConverter}}" Width="320" Height="76" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding SelectedTile.ShowCurrentLogo}" />
          <TextBlock Grid.Column="1" Text="{Binding SelectedTile.Title}" Foreground="#FFF5F7FF" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsVisible="{Binding SelectedTile.ShowNameCaption}" />
        </Grid>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding SubFilters}" IsVisible="{Binding HasSubFilters}" HorizontalAlignment="Center" Margin="0,16,0,8">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SubFilterViewModel">
              <Button Classes="pill subFilter" MinWidth="82" Classes.cursor="{Binding IsCursor}" Content="{Binding Label}" Click="OnSubFilterClick" Background="{Binding BackgroundHex, Converter={StaticResource HexColorToBrushConverter}}" Foreground="{Binding ForegroundHex, Converter={StaticResource HexColorToBrushConverter}}" BorderBrush="{Binding AccentHex, Converter={StaticResource HexColorToBrushConverter}}" BorderThickness="2" Padding="12,7" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <ScrollViewer x:Name="GameRowScrollViewer" Grid.Row="2" MinHeight="220" VerticalAlignment="Top" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
          <ScrollViewer.Transitions><Transitions><VectorTransition Property="Offset" Duration="0:0:0.22" Easing="CubicEaseOut" /></Transitions></ScrollViewer.Transitions>

          <WrapPanel x:Name="GameOuterPanel" Orientation="Horizontal" VerticalAlignment="Top">
            <ItemsControl x:Name="GamesItemsControl" ItemsSource="{Binding Games}" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="20" Margin="28,4,0,4" VerticalAlignment="Center" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:GameTileViewModel">
                  <Border Width="320" Height="180" CornerRadius="17" Background="#D9151925" BorderBrush="#667B8499" BorderThickness="1" ClipToBounds="True" PointerPressed="OnTilePointerPressed" DoubleTapped="OnTileDoubleTapped">
                    <Grid>
                      <Image Source="{Binding WideCapsuleImagePath}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                      <Border Background="#55000000" IsVisible="{Binding ShowEmptyWideCapsulePlaceholder}"><TextBlock Text="{Binding Title}" Foreground="#FFF5F7FF" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="18" /></Border>
                      <Border Background="#B8000000" Height="48" VerticalAlignment="Bottom" Padding="14,7">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="#FFF5F7FF" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <Border Grid.Column="1" Background="{Binding PlatformBadgeColorHex, Converter={StaticResource HexColorToBrushConverter}}" CornerRadius="5" Padding="6,2" VerticalAlignment="Center" IsVisible="{Binding HasPlatformBadge}"><TextBlock Text="{Binding PlatformBadgeText}" FontSize="10" FontWeight="Bold" Foreground="White" /></Border>
                        </Grid>
                      </Border>
                      <PathIcon Width="18" Height="18" Data="{StaticResource IconStar}" Foreground="#FFFFC45C" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" IsVisible="{Binding IsFavorite}" />
                      <Border BorderBrush="#FFF5F7FF" CornerRadius="14" BorderThickness="3" IsHitTestVisible="False" IsVisible="{Binding IsFocused}" />
                      <Border BorderBrush="{DynamicResource AccentBrush}" CornerRadius="11" BorderThickness="2" Margin="5" IsHitTestVisible="False" IsVisible="{Binding IsFocused}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button x:Name="AddProgramButton" Classes="addGhostCard" Click="OnAddProgramClick" IsVisible="{Binding IsFilterApplicationsActive}">
              <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <PathIcon Width="42" Height="42" Data="{StaticResource IconPlus}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Adicionar Jogo" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>
          </WrapPanel>
        </ScrollViewer>
      </Grid>

      <TextBlock Grid.Row="1" Grid.Column="0" Text="SUA BIBLIOTECA&#10;Adicione jogos para começar sua experiência." Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" IsVisible="{Binding SelectedTile, Converter={x:Static dataConv:ObjectConverters.IsNull}}" />

      <layouts:GameHubView Grid.Column="0" Grid.Row="2" Margin="0,10,0,0" VerticalAlignment="Bottom" />
    </Grid>
  </Panel>
</UserControl>