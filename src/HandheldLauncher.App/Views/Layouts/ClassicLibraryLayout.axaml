<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:anim="https://github.com/whistyun/AnimatedImage.Avalonia"
             xmlns:vm="using:HandheldLauncher.App.ViewModels"
             xmlns:conv="using:HandheldLauncher.App.Converters"
             xmlns:dataConv="using:Avalonia.Data.Converters"
             xmlns:media="using:Avalonia.Media"
             xmlns:layouts="using:HandheldLauncher.App.Views.Layouts"
             x:Class="HandheldLauncher.App.Views.Layouts.ClassicLibraryLayout"
             x:DataType="vm:MainViewModel">

  <UserControl.Resources>
    <conv:FileToBitmapConverter x:Key="FileToBitmapConverter" />
    <conv:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Button.addGhostCard">
      <Setter Property="Width" Value="180" />
      <Setter Property="Height" Value="250" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}" />
      <Setter Property="Background" Value="#40151515" />
      <Setter Property="BorderBrush" Value="#66FFFFFF" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="Margin" Value="28,0,0,0" />
      <Setter Property="Focusable" Value="True" />
    </Style>
    <Style Selector="Button.addGhostCard:focus, Button.addGhostCard.addFocused">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Background" Value="#60151925" />
    </Style>
    <Style Selector="Border.gameTile">
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusXLarge}" />
    </Style>
    <Style Selector="Border.gameTile.focused">
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="RenderTransform" Value="scale(1.05)" />
    </Style>
    <Style Selector="Button.filterTab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource RadiusLarge}" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="Button.filterTab:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentTranslucentBrush}" />
    </Style>
    <Style Selector="Button.filterTab.active">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="Button.filterTab.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24,20,24,20">
    <Border Grid.Row="0" Classes="heroBanner" Height="270" Margin="0,0,0,18" IsVisible="{Binding !IsFilterCloudActive}">
      <Grid>
        <Grid IsVisible="{Binding SelectedTile, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}">
          <Image Source="{Binding SelectedTile.BannerImagePath, Converter={StaticResource FileToBitmapConverter}}" Stretch="UniformToFill" Opacity="0.3" IsHitTestVisible="False"><Image.Effect><media:BlurEffect Radius="5" /></Image.Effect></Image>
          <!-- v0.26: a borda esquerda da arte nítida se dissolve no fundo desfocado. -->
          <Image x:Name="HeroBackImage" Stretch="Uniform" HorizontalAlignment="Right" IsHitTestVisible="False"><Image.OpacityMask><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%"><GradientStop Color="#00FFFFFF" Offset="0.0" /><GradientStop Color="#99FFFFFF" Offset="0.18" /><GradientStop Color="#FFFFFFFF" Offset="0.38" /><GradientStop Color="#FFFFFFFF" Offset="1.0" /></LinearGradientBrush></Image.OpacityMask></Image>
          <Image x:Name="HeroImage" anim:ImageBehavior.AnimatedSource="{Binding SelectedTile.BannerImagePath}" Stretch="Uniform" HorizontalAlignment="Right"><Image.OpacityMask><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%"><GradientStop Color="#00FFFFFF" Offset="0.0" /><GradientStop Color="#99FFFFFF" Offset="0.18" /><GradientStop Color="#FFFFFFFF" Offset="0.38" /><GradientStop Color="#FFFFFFFF" Offset="1.0" /></LinearGradientBrush></Image.OpacityMask></Image>
          <Border IsHitTestVisible="False">
            <Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%"><GradientStop Color="#E6101014" Offset="0.0" /><GradientStop Color="#B3101014" Offset="0.35" /><GradientStop Color="Transparent" Offset="0.72" /><GradientStop Color="Transparent" Offset="1.0" /></LinearGradientBrush></Border.Background>
          </Border>
          <Grid ColumnDefinitions="*,Auto" Margin="44,20,42,20">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" Spacing="12">
              <Image Source="{Binding SelectedTile.LogoImagePath, Converter={StaticResource FileToBitmapConverter}}" Width="320" Height="76" Stretch="Uniform" HorizontalAlignment="Left" IsVisible="{Binding SelectedTile.ShowCurrentLogo}" />
              <TextBlock Text="{Binding SelectedTile.Title}" Classes="heroTitle" FontSize="34" TextWrapping="Wrap" TextAlignment="Left" VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="900" IsVisible="{Binding SelectedTile.ShowNameCaption}" />
            </StackPanel>

          </Grid>
        </Grid>
        <TextBlock Text="Nenhum jogo encontrado ainda.&#10;Adicione um jogo manualmente para começar." Classes="subtle" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" IsVisible="{Binding SelectedTile, Converter={x:Static dataConv:ObjectConverters.IsNull}}" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="1" Spacing="16" Margin="0,0,0,10">
      <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Classes="pill filterTab" Classes.active="{Binding IsFilterFavoritesActive}" Command="{Binding SetFilterFavoritesCommand}" HorizontalAlignment="Center" Margin="3,0" FontSize="{DynamicResource TextBody}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <PathIcon Width="16" Height="16" Data="{StaticResource IconStar}"/>
            <TextBlock Text="Favoritos" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Classes="pill filterTab" Classes.active="{Binding IsFilterAllActive}" Command="{Binding SetFilterAllCommand}" HorizontalAlignment="Center" Margin="3,0" FontSize="{DynamicResource TextBody}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <PathIcon Width="16" Height="16" Data="{StaticResource IconGrid}"/>
            <TextBlock Text="Todos" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Classes="pill filterTab" Classes.active="{Binding IsFilterComputerActive}" Command="{Binding SetFilterComputerCommand}" HorizontalAlignment="Center" Margin="3,0" FontSize="{DynamicResource TextBody}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <PathIcon Width="16" Height="16" Data="{StaticResource IconMonitor}"/>
            <TextBlock Text="Computador" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Classes="pill filterTab" Classes.active="{Binding IsFilterEmulatorsActive}" Command="{Binding SetFilterEmulatorsCommand}" HorizontalAlignment="Center" Margin="3,0" FontSize="{DynamicResource TextBody}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <PathIcon Width="16" Height="16" Data="{StaticResource IconGamepad}"/>
            <TextBlock Text="Emuladores" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Classes="pill filterTab" Classes.active="{Binding IsFilterApplicationsActive}" Command="{Binding SetFilterApplicationsCommand}" HorizontalAlignment="Center" Margin="3,0" FontSize="{DynamicResource TextBody}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <PathIcon Width="16" Height="16" Data="{StaticResource IconAppWindow}"/>
            <TextBlock Text="Programas" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Classes="pill filterTab" Classes.active="{Binding IsFilterNotInstalledActive}" Command="{Binding SetFilterNotInstalledCommand}" HorizontalAlignment="Center" Margin="3,0" FontSize="{DynamicResource TextBody}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <PathIcon Width="16" Height="16" Data="{StaticResource IconDownload}"/>
            <TextBlock Text="Não instalados" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Classes="pill filterTab" Classes.active="{Binding IsFilterCloudActive}" Command="{Binding SetFilterCloudCommand}" HorizontalAlignment="Center" Margin="3,0" FontSize="{DynamicResource TextBody}">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <PathIcon Width="16" Height="16" Data="{StaticResource IconCloud}"/>
            <TextBlock Text="Nuvem" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </WrapPanel>

      <ItemsControl ItemsSource="{Binding SubFilters}" IsVisible="{Binding HasSubFilters}" HorizontalAlignment="Center">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:SubFilterViewModel">
            <Button Classes="pill subFilter" Classes.cursor="{Binding IsCursor}" Content="{Binding Label}" Click="OnSubFilterClick" Background="{Binding BackgroundHex, Converter={StaticResource HexColorToBrushConverter}}" Foreground="{Binding ForegroundHex, Converter={StaticResource HexColorToBrushConverter}}" BorderBrush="{Binding AccentHex, Converter={StaticResource HexColorToBrushConverter}}" BorderThickness="2" Margin="4,0" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>

    <layouts:CloudGridView x:Name="CloudGrid" Grid.Row="2" IsVisible="{Binding IsFilterCloudActive}" />

    <ScrollViewer x:Name="GameRowScrollViewer" Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" PointerWheelChanged="OnGameRowPointerWheelChanged" IsVisible="{Binding !IsFilterCloudActive}">
      <ScrollViewer.Transitions><Transitions><VectorTransition Property="Offset" Duration="0:0:0.28" Easing="CubicEaseOut" /></Transitions></ScrollViewer.Transitions>

      <!-- v0.21: StackPanel → WrapPanel para suportar layout vertical (empilha botão + jogo embaixo) -->
      <WrapPanel x:Name="GameOuterPanel" Orientation="Horizontal" Margin="0,0,28,0" VerticalAlignment="Top">
        <ItemsControl x:Name="GamesItemsControl" ItemsSource="{Binding Games}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="28" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:GameTileViewModel">
              <StackPanel Width="{Binding TileWidth}" Spacing="6">
                <Grid Height="46">
                  <TextBlock Text="{Binding Title}" Classes="tileCaption" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" TextAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding ShowNameCaption}" />
                  <Image Source="{Binding LogoImagePath, Converter={StaticResource FileToBitmapConverter}}" Width="190" Height="{Binding CaptionLogoHeight}" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding ShowCurrentLogo}" />
                </Grid>

                <Border Classes="gameTile" Classes.focused="{Binding IsFocused}" Classes.lastPlayed="{Binding IsLastPlayed}" Width="{Binding TileWidth}" Height="{Binding TileHeight}" PointerPressed="OnTilePointerPressed" DoubleTapped="OnTileDoubleTapped">
                  <Grid>
                    <!-- v0.26: a Viewbox garante que a capa preencha o quadro inteiro (sem faixas nas laterais), seja qual for a proporção da arte. --><Viewbox Stretch="UniformToFill" ClipToBounds="True"><Image anim:ImageBehavior.AnimatedSource="{Binding TileImagePath}" Stretch="None" /></Viewbox>
                    <Border Background="{DynamicResource NotInstalledVeilBrush}" IsHitTestVisible="False" IsVisible="{Binding IsOwnedNotInstalled}" />
                    <TextBlock Text="{Binding Title}" Classes="gameTitle" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10" IsVisible="{Binding ShowEmptyPlaceholder}" />
                    <Border Background="{Binding PlatformBadgeColorHex, Converter={StaticResource HexColorToBrushConverter}}" CornerRadius="4" Padding="5,2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" IsVisible="{Binding HasPlatformBadge}"><TextBlock Text="{Binding PlatformBadgeText}" FontSize="{DynamicResource TextMicro}" FontWeight="Bold" Foreground="White" /></Border>
                    <PathIcon Width="18" Height="18" Data="{StaticResource IconStar}" Foreground="{DynamicResource FavoriteBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8" IsVisible="{Binding IsFavorite}" />
                    <Border Background="#CC000000" CornerRadius="4" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8" IsVisible="{Binding IsOwnedNotInstalled}"><StackPanel Orientation="Horizontal" Spacing="4"><PathIcon Width="11" Height="11" Data="{StaticResource IconDownload}" Foreground="White"/><TextBlock Text="Instalar" FontSize="{DynamicResource TextCaption}" Foreground="White" VerticalAlignment="Center"/></StackPanel></Border>
                  </Grid>
                </Border>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button x:Name="AddProgramButton" Classes="addGhostCard" Click="OnAddProgramClick" IsVisible="{Binding IsFilterApplicationsActive}" VerticalAlignment="Top">
          <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <PathIcon Width="36" Height="36" Data="{StaticResource IconPlus}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
            <TextBlock Text="Adicionar Jogo" FontSize="{DynamicResource TextBodyLarge}" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
          </StackPanel>
        </Button>
      </WrapPanel>
    </ScrollViewer>

    <TextBlock Grid.Row="2" Text="{Binding NotInstalledTabMessage}" Classes="subtle" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="40,30,40,0" MaxWidth="600" IsVisible="{Binding HasNotInstalledTabMessage}" />
    <layouts:GameHubView Grid.Row="3" />
  </Grid>
</UserControl>