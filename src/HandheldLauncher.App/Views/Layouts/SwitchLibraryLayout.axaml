<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HandheldLauncher.App.ViewModels"
             xmlns:conv="using:HandheldLauncher.App.Converters"
             xmlns:dataConv="using:Avalonia.Data.Converters"
             xmlns:media="using:Avalonia.Media"
             x:Class="HandheldLauncher.App.Views.Layouts.SwitchLibraryLayout"
             x:DataType="vm:MainViewModel">

  <!--
    Tema de LAYOUT "Switch" — v0.9.20 (primeira versão) e REFEITO na
    v0.9.21 com o retorno do usuário:

      "retirar essa parte do hero, o banner no caso ficaria como tela de
       fundo com uma transparência e filtro branco pra remeter aquele fundo
       branco do Switch"
      "os ícones ficaram lá embaixo, centralizar ele no meio do home"
      "deixar ele tamanho do capsule original para não danificar as artes"
      "os ícones com um aspecto de arco sendo o selecionado no centro com
       zoom pra frente da tela, e ir passando e fazendo uma espécie de
       roleta horizontal"
      "em baixo pode deixar os menus de filtro igual você deixou"

    O que mudou em relação à v0.9.20: o palco/hero com caixa própria SAIU.
    A arte do jogo em foco agora é o FUNDO da tela inteira, coberta por um
    véu branco — daí o "fundo branco do Switch", mas tingido pela arte do
    jogo em vez de branco puro. A fileira de capas foi pro MEIO vertical,
    voltou à proporção capsule (era quadrada) e ganhou o arco/roleta.

    NÃO copia nada da interface real do aparelho: sem logo, fonte ou ícone
    de sistema. O que vem da referência é a disposição.

    Os quatro x:Name que a MainWindow precisa (ILibraryLayout) continuam
    aqui — HeroImage/HeroBackImage agora são as imagens DE FUNDO, o que
    mantém a transição suave entre jogos funcionando sem código novo.
  -->

  <UserControl.Resources>
    <conv:FileToBitmapConverter x:Key="FileToBitmapConverter" />
    <conv:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
  </UserControl.Resources>

  <Panel>

    <!-- ===== FUNDO: arte do jogo em foco + véu branco ===== -->
    <!-- As duas imagens são o mesmo par de sempre (a de trás segura a arte
         anterior enquanto a nova entra com fade — MainWindow.OnHeroImageChanged
         acha as duas por ILibraryLayout). UniformToFill aqui de propósito,
         ao contrário do resto: fundo tem que COBRIR a tela, e é a única
         exceção à regra de "sem zoom" que o usuário pediu — cabe a imagem
         inteira num fundo deixaria faixas vazias na tela toda. -->
    <!-- BUG v0.9.21 corrigido aqui: o desfoque estava num Border VAZIO
         logo abaixo destas imagens, e efeito no Avalonia se aplica ao
         conteúdo do próprio elemento — um Border sem conteúdo borra nada.
         Resultado: o fundo não desfocava, e como o véu branco ainda por
         cima era quase opaco (#E8 = 91%), o usuário via "fundo branco
         sólido". O desfoque agora vai NAS PRÓPRIAS imagens, que é como o
         fundo de tela cheia da MainWindow sempre fez. -->
    <Image x:Name="HeroBackImage" Stretch="UniformToFill" IsHitTestVisible="False">
      <Image.Effect>
        <media:BlurEffect Radius="45" />
      </Image.Effect>
    </Image>
    <Image x:Name="HeroImage"
           Source="{Binding SelectedTile.BannerImagePath, Converter={StaticResource FileToBitmapConverter}}"
           Stretch="UniformToFill"
           IsHitTestVisible="False">
      <Image.Effect>
        <media:BlurEffect Radius="45" />
      </Image.Effect>
    </Image>

    <!-- O "filtro branco": agora LEVE (55%, era 91%), como ele pediu — "o
         fundo a imagem do jogo de fundo com blur ou desfoque com leve
         filtro branco em cima da imagem". A arte aparece de verdade,
         lavada em direção ao branco em vez de coberta por ele. -->
    <Border Background="#8CFFFFFF" IsHitTestVisible="False" />

    <Grid RowDefinitions="*,Auto" Margin="24,12,24,12">

      <!-- ===== ROLETA: capas centralizadas no meio da tela ===== -->
      <ScrollViewer x:Name="GameRowScrollViewer"
                    Grid.Row="0"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalAlignment="Center">
        <ScrollViewer.Transitions>
          <Transitions>
            <VectorTransition Property="Offset" Duration="0:0:0.28" Easing="CubicEaseOut" />
          </Transitions>
        </ScrollViewer.Transitions>

        <ItemsControl x:Name="GamesItemsControl" ItemsSource="{Binding Games}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <!-- Alinhado pelo TOPO (não pelo centro): o deslocamento do
                   arco é pra BAIXO, então as capas longe do foco precisam
                   de um topo comum pra descerem a partir dele. -->
              <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Top" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>

          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:GameTileViewModel">
              <!-- Zoom/arco/opacidade vêm todos de CarouselDistance (ver
                   GameTileViewModel). RenderTransform não mexe no layout,
                   então a capa em foco cresce POR CIMA das vizinhas sem a
                   fileira pular a cada navegação — e o ZIndex garante que
                   ela desenhe na frente delas.

                   RenderTransformOrigin em 50%,50% pro zoom sair do centro
                   da própria capa, e a transição faz o crescer/encolher
                   acontecer suave ao navegar, que é o que dá a sensação de
                   roleta. -->
              <Border Classes="gameTile"
                      Classes.focused="{Binding IsFocused}"
                      Width="{Binding CarouselTileWidth}"
                      Height="{Binding CarouselTileHeight}"
                      Opacity="{Binding CarouselOpacity}"
                      ZIndex="{Binding CarouselZIndex}"
                      RenderTransformOrigin="50%,50%"
                      PointerPressed="OnTilePointerPressed"
                      DoubleTapped="OnTileDoubleTapped">
                <!-- A transição de suavização vai em CADA transform, e não
                     num TransformOperationsTransition no RenderTransform do
                     Border: esse tipo de transição interpola a sintaxe de
                     TEXTO de transformação ("scale(1.1) translateY(4px)"),
                     não um TransformGroup montado com objetos como este.
                     Transform herda de Animatable no Avalonia, então cada
                     um aceita as próprias Transitions — que é o caminho
                     que funciona com bindings. -->
                <Border.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform ScaleX="{Binding CarouselScale}" ScaleY="{Binding CarouselScale}">
                      <ScaleTransform.Transitions>
                        <Transitions>
                          <DoubleTransition Property="ScaleX" Duration="0:0:0.22" Easing="CubicEaseOut" />
                          <DoubleTransition Property="ScaleY" Duration="0:0:0.22" Easing="CubicEaseOut" />
                        </Transitions>
                      </ScaleTransform.Transitions>
                    </ScaleTransform>
                    <TranslateTransform Y="{Binding CarouselOffsetY}">
                      <TranslateTransform.Transitions>
                        <Transitions>
                          <DoubleTransition Property="Y" Duration="0:0:0.22" Easing="CubicEaseOut" />
                        </Transitions>
                      </TranslateTransform.Transitions>
                    </TranslateTransform>
                  </TransformGroup>
                </Border.RenderTransform>
                <Border.Transitions>
                  <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
                  </Transitions>
                </Border.Transitions>

                <Grid>
                  <!-- Uniform (não UniformToFill): pedido do usuário pra as
                       artes não serem cortadas. Com a capa na proporção
                       capsule original, sobra pouco ou nada de fundo. -->
                  <Image Source="{Binding CarouselTileImagePath, Converter={StaticResource FileToBitmapConverter}}"
                         Stretch="Uniform" />

                  <Border Background="#99383838"
                          IsHitTestVisible="False"
                          IsVisible="{Binding IsOwnedNotInstalled}" />

                  <TextBlock Text="{Binding Title}"
                             Classes="gameTitle"
                             TextWrapping="Wrap"
                             TextAlignment="Center"
                             VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             Margin="8"
                             IsVisible="{Binding ShowEmptyCarouselPlaceholder}" />

                  <TextBlock Text="★"
                             Foreground="{DynamicResource AccentBrush}"
                             FontSize="16"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Margin="6"
                             IsVisible="{Binding IsFavorite}" />

                  <Border Background="{Binding PlatformBadgeColorHex, Converter={StaticResource HexColorToBrushConverter}}"
                          CornerRadius="4"
                          Padding="4,1"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Margin="6"
                          IsVisible="{Binding HasPlatformBadge}">
                    <TextBlock Text="{Binding PlatformBadgeText}" FontSize="9" FontWeight="Bold" Foreground="White" />
                  </Border>

                  <!-- v0.9.22, retorno do usuário: "ficou difícil entender
                       qual capa tá selecionada, tem que ter um jeito de
                       identificar, talvez um quadro em volta". O zoom
                       sozinho não bastou — sobre fundo claro e com as
                       vizinhas perto, a diferença de tamanho não lê.

                       Dois anéis em vez de um: o branco por fora garante
                       contraste contra a capa (que pode ser de qualquer
                       cor) e o da cor de destaque por dentro marca que é
                       seleção, não borda decorativa. Um anel só sumiria em
                       capas da mesma cor dele. Fica DENTRO da capa (overlay
                       com BorderThickness) pra não empurrar nada no
                       layout, que desalinharia a fileira inteira. -->
                  <Border BorderBrush="White"
                          BorderThickness="4"
                          IsHitTestVisible="False"
                          IsVisible="{Binding IsFocused}" />
                  <Border BorderBrush="{DynamicResource AccentBrush}"
                          BorderThickness="2"
                          Margin="4"
                          IsHitTestVisible="False"
                          IsVisible="{Binding IsFocused}" />
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <!-- Nome do jogo em foco, sobre o fundo claro. Texto escuro fixo
           porque o véu branco acima garante fundo claro em qualquer paleta
           — usar a cor de texto do tema deixaria branco-no-branco nos
           temas escuros. -->
      <!-- Nome em pílula branca, e não texto solto: com o véu agora LEVE
           (v0.9.22), o fundo passa a ter a cor da arte do jogo — um banner
           escuro deixaria texto escuro ilegível, e texto claro sumiria num
           banner claro. A pílula garante contraste com qualquer arte. -->
      <Border Grid.Row="0"
              Background="#D9FFFFFF"
              CornerRadius="{DynamicResource BarCornerRadius}"
              Padding="20,8"
              HorizontalAlignment="Center"
              VerticalAlignment="Bottom"
              Margin="24,0,24,8"
              MaxWidth="900"
              IsVisible="{Binding SelectedTile, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}">
        <TextBlock Text="{Binding SelectedTile.Title}"
                   Foreground="#1A1A1A"
                   FontSize="24"
                   FontWeight="SemiBold"
                   TextWrapping="NoWrap"
                   TextTrimming="CharacterEllipsis" />
      </Border>

      <TextBlock Grid.Row="0"
                 Text="Nenhum jogo encontrado ainda.&#10;Adicione um jogo manualmente para começar."
                 Foreground="#4A4A4A"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"
                 Margin="24"
                 IsVisible="{Binding SelectedTile, Converter={x:Static dataConv:ObjectConverters.IsNull}}" />

      <!-- ===== MENU EMBAIXO: abas + subfiltros (mantidos como estavam) ===== -->
      <StackPanel Grid.Row="1" Spacing="6" Margin="0,12,0,0">
        <Grid ColumnDefinitions="*,*,*,*,*,*">
          <Button Grid.Column="0" Classes="pill filterTab" Classes.active="{Binding IsFilterFavoritesActive}" Content="Favoritos" Command="{Binding SetFilterFavoritesCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,4,0" Padding="6,5" FontSize="11" />
          <Button Grid.Column="1" Classes="pill filterTab" Classes.active="{Binding IsFilterAllActive}" Content="Todos" Command="{Binding SetFilterAllCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0" Padding="6,5" FontSize="11" />
          <Button Grid.Column="2" Classes="pill filterTab" Classes.active="{Binding IsFilterComputerActive}" Content="Computador" Command="{Binding SetFilterComputerCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0" Padding="6,5" FontSize="11" />
          <Button Grid.Column="3" Classes="pill filterTab" Classes.active="{Binding IsFilterEmulatorsActive}" Content="Emuladores" Command="{Binding SetFilterEmulatorsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0" Padding="6,5" FontSize="11" />
          <Button Grid.Column="4" Classes="pill filterTab" Classes.active="{Binding IsFilterApplicationsActive}" Content="Programas" Command="{Binding SetFilterApplicationsCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0" Padding="6,5" FontSize="11" />
          <Button Grid.Column="5" Classes="pill filterTab" Classes.active="{Binding IsFilterNotInstalledActive}" Content="Não instalados" Command="{Binding SetFilterNotInstalledCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0,0,0" Padding="6,5" FontSize="11" />
        </Grid>

        <ItemsControl ItemsSource="{Binding SubFilters}" IsVisible="{Binding HasSubFilters}" HorizontalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SubFilterViewModel">
              <Button Classes="pill subFilter"
                      Classes.cursor="{Binding IsCursor}"
                      Content="{Binding Label}"
                      Click="OnSubFilterClick"
                      Background="{Binding BackgroundHex, Converter={StaticResource HexColorToBrushConverter}}"
                      Foreground="{Binding ForegroundHex, Converter={StaticResource HexColorToBrushConverter}}"
                      BorderBrush="{Binding AccentHex, Converter={StaticResource HexColorToBrushConverter}}"
                      BorderThickness="2"
                      Margin="4,0" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

    </Grid>
  </Panel>
</UserControl>
