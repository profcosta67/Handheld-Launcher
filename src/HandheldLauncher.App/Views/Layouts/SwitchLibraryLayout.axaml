<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HandheldLauncher.App.ViewModels"
             xmlns:conv="using:HandheldLauncher.App.Converters"
             xmlns:dataConv="using:Avalonia.Data.Converters"
             xmlns:media="using:Avalonia.Media"
             x:Class="HandheldLauncher.App.Views.Layouts.SwitchLibraryLayout"
             x:DataType="vm:MainViewModel">

  <!--
    Tema de LAYOUT "Switch". Referência combinada: a tela HOME do console —
    fileira horizontal, capas soltas, fundo claro, menu embaixo. NÃO copia
    nada da interface real do aparelho (sem logo, fonte ou ícone de
    sistema); o que vem da referência é a DISPOSIÇÃO.

    v0.9.23, terceira rodada de ajuste com o usuário:
      "retira esse limite inferior das artes, deixa ela solta em todos"
      "aumenta os espaços laterais entre as artes, pra ficar menos ícones"
      "aumenta ainda mais o zoom da arte principalmente"
      "o nome do jogo selecionado coloca em cima da arte selecionada e
       vamos usar mesmo sistema do nosso, o nome vai ser o logo"
      "o branco de fundo ainda está muito forte, coloca mais transparência"
      "aumenta um pouco a altura dos filtros, fundo branco borda vermelho e
       letra preto, coloca duas linhas intercaladas"

    Os quatro x:Name que a MainWindow precisa (ILibraryLayout) continuam
    aqui — HeroImage/HeroBackImage são as imagens DE FUNDO, o que mantém a
    transição suave entre jogos funcionando sem código novo.
  -->

  <UserControl.Resources>
    <conv:FileToBitmapConverter x:Key="FileToBitmapConverter" />
    <conv:HexColorToBrushConverter x:Key="HexColorToBrushConverter" />
  </UserControl.Resources>

  <UserControl.Styles>
    <!-- Abas do tema Switch: branco com borda vermelha e texto preto, e a
         ativa invertida (vermelho com texto branco). Pedido do usuário —
         só a COMBINAÇÃO DE CORES remetendo ao console, nenhum recurso
         gráfico dele. Estilo local e não o filterTab compartilhado porque
         o layout Clássico continua com as abas na cor do tema.
         A ativa precisa INVERTER: se todas ficassem brancas com borda
         vermelha, não daria pra ver qual está selecionada. -->
    <Style Selector="Button.switchTab">
      <Setter Property="Background" Value="#252A36" />
      <Setter Property="Foreground" Value="#E9ECF4" />
      <Setter Property="BorderBrush" Value="#424A5D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="8,7" />
      <Setter Property="MinHeight" Value="58" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.switchTab /template/ ContentPresenter">
      <Setter Property="Background" Value="#252A36" />
      <Setter Property="Foreground" Value="#E9ECF4" />
      <Setter Property="BorderBrush" Value="#424A5D" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.switchTab.active /template/ ContentPresenter">
      <Setter Property="Background" Value="#6579E8" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
  </UserControl.Styles>

  <Panel>

    <!-- ===== FUNDO: arte do jogo em foco, desfocada + véu branco ===== -->
    <!-- O desfoque vai NAS IMAGENS (não num Border vazio, que foi o bug da
         v0.9.21: efeito no Avalonia se aplica ao conteúdo do próprio
         elemento, então um Border sem conteúdo não borra nada do que está
         atrás). UniformToFill aqui de propósito: fundo tem que cobrir a
         tela — é a exceção à regra de "sem zoom". -->
    <Image x:Name="HeroBackImage" Stretch="UniformToFill" IsHitTestVisible="False">
      <Image.Effect>
        <media:BlurEffect Radius="45" />
      </Image.Effect>
    </Image>
    <Image x:Name="HeroImage"
           Source="{Binding SelectedTile.BannerImagePath, Converter={StaticResource FileToBitmapConverter}}"
           Stretch="UniformToFill"
           IsHitTestVisible="False">
      <Image.Effect>
        <media:BlurEffect Radius="45" />
      </Image.Effect>
    </Image>

    <!-- Véu branco: 35% na v0.9.23 (era 55%, e 91% na v0.9.21) — "o branco
         de fundo ainda está muito forte, coloca mais transparência". Agora
         a arte do jogo domina e o branco só lava. -->
    <Border Background="#A6101219" IsHitTestVisible="False" />

    <Grid RowDefinitions="*,Auto" Margin="28,16,28,16">

      <!-- Logo/nome + roleta juntos num bloco centralizado: é o que coloca
           o nome exatamente EM CIMA da arte selecionada, que fica sempre no
           meio da tela. -->
      <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="16">

        <!-- Mesmo sistema do layout Clássico, a pedido: quando o jogo já
             tem logo baixado, ela aparece NO LUGAR do nome; só cai pro
             texto quando ainda não há logo (ver
             GameTileViewModel.ShowCurrentLogo/ShowNameCaption). Altura
             fixa pra o bloco não "pular" ao trocar de um jogo com logo pra
             um sem. -->
        <Grid Height="76" IsVisible="{Binding SelectedTile, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}">
          <Image Source="{Binding SelectedTile.LogoImagePath, Converter={StaticResource FileToBitmapConverter}}"
                 Stretch="Uniform"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsVisible="{Binding SelectedTile.ShowCurrentLogo}" />

          <!-- Sem logo: nome em pílula branca. A pílula existe porque o
               fundo agora tem a cor da arte do jogo — texto solto some num
               banner claro ou num escuro, dependendo do jogo. -->
          <Border Background="#D91A1F2B"
                  BorderBrush="#6579E8"
                  BorderThickness="1"
                  CornerRadius="14"
                  Padding="20,8"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  MaxWidth="900"
                  IsVisible="{Binding SelectedTile.ShowNameCaption}">
            <TextBlock Text="{Binding SelectedTile.Title}"
                       Foreground="#FFFFFF"
                       FontSize="26"
                       FontWeight="SemiBold"
                       TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" />
          </Border>
        </Grid>

        <!-- ===== ROLETA ===== -->
        <ScrollViewer x:Name="GameRowScrollViewer"
                      Height="430"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      HorizontalContentAlignment="Center"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled">
          <ScrollViewer.Transitions>
            <Transitions>
              <VectorTransition Property="Offset" Duration="0:0:0.28" Easing="CubicEaseOut" />
            </Transitions>
          </ScrollViewer.Transitions>

          <ItemsControl x:Name="GamesItemsControl"
                        ItemsSource="{Binding Games}"
                        HorizontalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <!-- Spacing 56 (era 16): "aumenta os espaços laterais entre
                     as artes, pra ficar menos ícones na tela". Com o zoom
                     maior da capa em foco, o espaço também evita que ela
                     cubra as vizinhas ao crescer. -->
                <StackPanel Orientation="Horizontal" Spacing="120" Margin="900,0,900,0" VerticalAlignment="Center" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:GameTileViewModel">
                <!-- Cada posição da roleta tem uma área fixa (220x290,
                     respeitando o ajuste global de tamanho). Isso evita
                     que capas com proporções diferentes alterem o passo
                     horizontal do carrossel e desloquem as vizinhas.
                     A arte continua em Uniform: aparece inteira, sem
                     deformação ou corte; o espaço excedente fica livre. -->
                <Grid Width="{Binding CarouselTileWidth}"
                      Height="{Binding CarouselTileHeight}"
                      ClipToBounds="False"
                      RenderTransformOrigin="50%,50%"
                      Opacity="{Binding CarouselOpacity}"
                      ZIndex="{Binding CarouselZIndex}"
                      PointerPressed="OnTilePointerPressed"
                      DoubleTapped="OnTileDoubleTapped">
                  <Grid.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform ScaleX="{Binding CarouselScale}" ScaleY="{Binding CarouselScale}">
                        <ScaleTransform.Transitions>
                          <Transitions>
                            <DoubleTransition Property="ScaleX" Duration="0:0:0.22" Easing="CubicEaseOut" />
                            <DoubleTransition Property="ScaleY" Duration="0:0:0.22" Easing="CubicEaseOut" />
                          </Transitions>
                        </ScaleTransform.Transitions>
                      </ScaleTransform>
                      <TranslateTransform Y="{Binding CarouselOffsetY}">
                        <TranslateTransform.Transitions>
                          <Transitions>
                            <DoubleTransition Property="Y" Duration="0:0:0.22" Easing="CubicEaseOut" />
                          </Transitions>
                        </TranslateTransform.Transitions>
                      </TranslateTransform>
                    </TransformGroup>
                  </Grid.RenderTransform>
                  <Grid.Transitions>
                    <Transitions>
                      <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
                    </Transitions>
                  </Grid.Transitions>

                  <Image Source="{Binding CarouselTileImagePath, Converter={StaticResource FileToBitmapConverter}}"
                         Width="{Binding CarouselTileWidth}"
                         Height="{Binding CarouselTileHeight}"
                         Stretch="Uniform"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />

                  <!-- Sem arte: aí sim precisa de uma caixa, senão não teria
                       nada pra clicar nem pra ver. -->
                  <Border Background="#33000000"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          IsVisible="{Binding ShowEmptyCarouselPlaceholder}">
                    <TextBlock Text="{Binding Title}"
                               Classes="gameTitle"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="8" />
                  </Border>

                  <Border Background="#99383838"
                          IsHitTestVisible="False"
                          IsVisible="{Binding IsOwnedNotInstalled}" />

                  <TextBlock Text="★"
                             Foreground="#E4000F"
                             FontSize="18"
                             HorizontalAlignment="Right"
                             VerticalAlignment="Bottom"
                             Margin="6"
                             IsVisible="{Binding IsFavorite}" />

                  <Border Background="{Binding PlatformBadgeColorHex, Converter={StaticResource HexColorToBrushConverter}}"
                          CornerRadius="4"
                          Padding="4,1"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Margin="6"
                          IsVisible="{Binding HasPlatformBadge}">
                    <TextBlock Text="{Binding PlatformBadgeText}" FontSize="9" FontWeight="Bold" Foreground="White" />
                  </Border>

                  <!-- Anéis de seleção: dois, porque um só sumiria numa capa
                       da mesma cor dele — e capa pode ser de qualquer cor.
                       Sem fundo, só contorno, pra não cobrir a arte. -->
                  <Border BorderBrush="#FFFFFF"
                          CornerRadius="5"
                          BorderThickness="4"
                          IsHitTestVisible="False"
                          IsVisible="{Binding IsFocused}" />
                  <Border BorderBrush="#6579E8"
                          CornerRadius="5"
                          BorderThickness="3"
                          Margin="5"
                          IsHitTestVisible="False"
                          IsVisible="{Binding IsFocused}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Identificação persistente do item em foco: não depende de a capa
             ter logo, nem da cor/contraste da arte. -->
        <Border Background="#E61A1F2B"
                BorderBrush="#52607D"
                BorderThickness="1"
                CornerRadius="12"
                Padding="18,9"
                HorizontalAlignment="Center"
                MaxWidth="760"
                IsVisible="{Binding SelectedTile, Converter={x:Static dataConv:ObjectConverters.IsNotNull}}">
          <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
            <Border Background="#6579E8" CornerRadius="5" Padding="7,3" VerticalAlignment="Center">
              <TextBlock Text="SELECIONADO" Foreground="White" FontSize="9" FontWeight="Bold" />
            </Border>
            <TextBlock Text="{Binding SelectedTile.Title}"
                       Foreground="White"
                       FontSize="16"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="560" />
          </StackPanel>
        </Border>
      </StackPanel>

      <TextBlock Grid.Row="0"
                 Text="Nenhum jogo encontrado ainda.&#10;Adicione um jogo manualmente para começar."
                 Foreground="#2A2A2A"
                 TextWrapping="Wrap"
                 TextAlignment="Center"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"
                 Margin="24"
                 IsVisible="{Binding SelectedTile, Converter={x:Static dataConv:ObjectConverters.IsNull}}" />

      <!-- Barra de filtros compacta: uma única linha para liberar área útil
           para a biblioteca. Mantém os seis filtros e seus comandos originais. -->
      <StackPanel Grid.Row="1" Spacing="8" Margin="0,16,0,0">
        <Grid ColumnDefinitions="*,*,*,*,*,*">
          <Button Grid.Column="0" Classes="switchTab" Classes.active="{Binding IsFilterFavoritesActive}" Command="{Binding SetFilterFavoritesCommand}" Margin="4">
            <StackPanel HorizontalAlignment="Center" Spacing="3">
              <TextBlock Text="★" FontSize="19" HorizontalAlignment="Center" />
              <TextBlock Text="Favoritos" />
            </StackPanel>
          </Button>
          <Button Grid.Column="1" Classes="switchTab" Classes.active="{Binding IsFilterAllActive}" Command="{Binding SetFilterAllCommand}" Margin="4">
            <StackPanel HorizontalAlignment="Center" Spacing="3">
              <TextBlock Text="▦" FontSize="19" HorizontalAlignment="Center" />
              <TextBlock Text="Todos" />
            </StackPanel>
          </Button>
          <Button Grid.Column="2" Classes="switchTab" Classes.active="{Binding IsFilterComputerActive}" Command="{Binding SetFilterComputerCommand}" Margin="4">
            <StackPanel HorizontalAlignment="Center" Spacing="3">
              <TextBlock Text="⌨" FontSize="19" HorizontalAlignment="Center" />
              <TextBlock Text="Computador" />
            </StackPanel>
          </Button>
          <Button Grid.Column="3" Classes="switchTab" Classes.active="{Binding IsFilterEmulatorsActive}" Command="{Binding SetFilterEmulatorsCommand}" Margin="4">
            <StackPanel HorizontalAlignment="Center" Spacing="3">
              <TextBlock Text="🎮" FontSize="19" HorizontalAlignment="Center" />
              <TextBlock Text="Emuladores" />
            </StackPanel>
          </Button>
          <Button Grid.Column="4" Classes="switchTab" Classes.active="{Binding IsFilterApplicationsActive}" Command="{Binding SetFilterApplicationsCommand}" Margin="4">
            <StackPanel HorizontalAlignment="Center" Spacing="3">
              <TextBlock Text="▣" FontSize="19" HorizontalAlignment="Center" />
              <TextBlock Text="Programas" />
            </StackPanel>
          </Button>
          <Button Grid.Column="5" Classes="switchTab" Classes.active="{Binding IsFilterNotInstalledActive}" Command="{Binding SetFilterNotInstalledCommand}" Margin="4">
            <StackPanel HorizontalAlignment="Center" Spacing="3">
              <TextBlock Text="↓" FontSize="19" HorizontalAlignment="Center" />
              <TextBlock Text="Não instalados" />
            </StackPanel>
          </Button>
        </Grid>

        <Button Content="＋  Adicionar programa"
                HorizontalAlignment="Center"
                MinWidth="220"
                Margin="4,2,4,0"
                IsVisible="{Binding IsFilterApplicationsActive}"
                Click="OnAddProgramClick" />

        <!-- Subfiltros seguem com a cor de cada plataforma (pedido anterior
             dele, mantido) — abaixo das duas linhas de abas. -->
        <ItemsControl ItemsSource="{Binding SubFilters}" IsVisible="{Binding HasSubFilters}" HorizontalAlignment="Center">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SubFilterViewModel">
              <Button Classes="pill subFilter"
                      Classes.cursor="{Binding IsCursor}"
                      Content="{Binding Label}"
                      Click="OnSubFilterClick"
                      Background="{Binding BackgroundHex, Converter={StaticResource HexColorToBrushConverter}}"
                      Foreground="{Binding ForegroundHex, Converter={StaticResource HexColorToBrushConverter}}"
                      BorderBrush="{Binding AccentHex, Converter={StaticResource HexColorToBrushConverter}}"
                      BorderThickness="2"
                      Margin="4,0" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

    </Grid>
  </Panel>
</UserControl>
