<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HandheldLauncher.App.Views.Qs.QsPanel"
             Width="440">

  <!-- QS 2.0 (F1). Substitui o conteúdo do OverlayWindow. Decisões do dono
       (09/11/2026): TDP = slider + 4 presets (Eco/Normal/Boost/Custom);
       Volume sim, Brilho não, Hz não; Resolução = 3 presets do aparelho;
       mantêm-se Ventoinha, Cor, Lossless (on/off + 2x/3x/4x), Print e Gravar. -->
  <Border Background="#F21A1A1F" CornerRadius="14" Padding="14">
    <StackPanel Spacing="10">

      <!-- cabeçalho -->
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="⚙ Quick Settings" FontSize="17" FontWeight="Bold" Foreground="White" />
          <TextBlock x:Name="TxtScreenInfo" Text="—" FontSize="11" Foreground="#9BA8C4" />
        </StackPanel>
        <Button Grid.Column="1" x:Name="BtnClose" Content="✕" Classes="pill"
                VerticalAlignment="Top" Click="OnCloseClick" />
      </Grid>

      <!-- aviso de elevação (TDP indisponível sem admin — ver log de 09/11) -->
      <Border x:Name="ElevationWarning" IsVisible="False" Background="#33FF6B6B"
              BorderBrush="#66FF6B6B" BorderThickness="1" CornerRadius="8" Padding="8">
        <TextBlock x:Name="TxtElevationWarning" FontSize="11" Foreground="#FFD8D8"
                   TextWrapping="Wrap" Text="Modo padrão: o TDP não aplica. Reinicia como administrador." />
      </Border>

      <!-- VOLUME -->
      <Border Classes="settingsCard" Padding="10" CornerRadius="10" Background="#14FFFFFF">
        <StackPanel Spacing="4">
          <TextBlock Text="🔊 Volume" FontSize="12" FontWeight="SemiBold" Foreground="White" />
          <Grid ColumnDefinitions="*,Auto">
            <Slider Grid.Column="0" x:Name="VolumeSlider" Minimum="0" Maximum="100"
                    TickFrequency="5" IsSnapToTickEnabled="True" />
            <TextBlock Grid.Column="1" x:Name="TxtVolume" Text="70%" FontSize="11"
                       Foreground="#9BA8C4" VerticalAlignment="Center" MinWidth="40" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- DESEMPENHO (TDP) -->
      <Border Classes="settingsCard" Padding="10" CornerRadius="10" Background="#14FFFFFF">
        <StackPanel Spacing="6">
          <TextBlock Text="⚡ Desempenho (TDP)" FontSize="12" FontWeight="SemiBold" Foreground="White" />
          <Grid ColumnDefinitions="*,Auto">
            <Slider Grid.Column="0" x:Name="TdpSlider" Minimum="5" Maximum="35"
                    TickFrequency="1" IsSnapToTickEnabled="True" />
            <TextBlock Grid.Column="1" x:Name="TxtTdp" Text="20 W" FontSize="12" FontWeight="Bold"
                       Foreground="White" VerticalAlignment="Center" MinWidth="52" />
          </Grid>
          <StackPanel x:Name="TdpPresetsHost" Orientation="Horizontal" Spacing="6" />
        </StackPanel>
      </Border>

      <!-- RESOLUÇÃO (3 presets do aparelho) -->
      <Border Classes="settingsCard" Padding="10" CornerRadius="10" Background="#14FFFFFF">
        <StackPanel Spacing="6">
          <TextBlock Text="🖥 Resolução" FontSize="12" FontWeight="SemiBold" Foreground="White" />
          <StackPanel x:Name="ResolutionHost" Orientation="Horizontal" Spacing="6" />
        </StackPanel>
      </Border>

      <!-- REFRIGERAÇÃO -->
      <Border Classes="settingsCard" Padding="10" CornerRadius="10" Background="#14FFFFFF">
        <StackPanel Spacing="6">
          <TextBlock Text="❄ Refrigeração" FontSize="12" FontWeight="SemiBold" Foreground="White" />
          <StackPanel x:Name="FanHost" Orientation="Horizontal" Spacing="6" />
          <TextBlock x:Name="TxtFanStatus" Text="" FontSize="10" Foreground="#9BA8C4" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- COR -->
      <Border Classes="settingsCard" Padding="10" CornerRadius="10" Background="#14FFFFFF">
        <StackPanel Spacing="6">
          <TextBlock Text="🎨 Modo de cor" FontSize="12" FontWeight="SemiBold" Foreground="White" />
          <StackPanel x:Name="ColorHost" Orientation="Horizontal" Spacing="6" />
        </StackPanel>
      </Border>

      <!-- LOSSLESS + CAPTURA -->
      <Border Classes="settingsCard" Padding="10" CornerRadius="10" Background="#14FFFFFF">
        <StackPanel Spacing="6">
          <TextBlock Text="🔍 Lossless Scaling" FontSize="12" FontWeight="SemiBold" Foreground="White" />
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button x:Name="BtnLosslessToggle" Content="Ligar" Classes="pill" Click="OnLosslessToggleClick" />
            <Button x:Name="BtnLossless2x" Content="2x" Classes="pill" Click="OnLosslessMultiplierClick" Tag="2" />
            <Button x:Name="BtnLossless3x" Content="3x" Classes="pill" Click="OnLosslessMultiplierClick" Tag="3" />
            <Button x:Name="BtnLossless4x" Content="4x" Classes="pill" Click="OnLosslessMultiplierClick" Tag="4" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button x:Name="BtnPrint" Content="📷 Print" Classes="pill" Click="OnPrintClick" />
            <Button x:Name="BtnRecord" Content="⏺ Gravar" Classes="pill" Click="OnRecordClick" />
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </Border>
</UserControl>
