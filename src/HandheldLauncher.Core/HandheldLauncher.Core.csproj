<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HandheldLauncher.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expõe só pro projeto de testes (v0.16) os membros internos usados
         pra testar lógica pura sem duplicar código nem mudar a API pública. -->
    <InternalsVisibleTo Include="HandheldLauncher.Core.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Chaves de API no settings.json criptografadas com o DPAPI do Windows
         (só o mesmo usuário do Windows consegue ler) — ver AppSettingsStore. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />

    <!-- SkiaSharp substitui o System.Drawing.Common. É multiplataforma e é a
         mesma engine gráfica que o Avalonia usa por baixo dos panos, então
         não adiciona peso extra ao produto final. -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

</Project>