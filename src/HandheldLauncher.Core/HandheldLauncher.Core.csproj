<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HandheldLauncher.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Chaves de API no settings.json criptografadas com o DPAPI do Windows
         (só o mesmo usuário do Windows consegue ler) — ver AppSettingsStore. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />

    <!-- v0.9.6: pedido do usuário ("ajustar a logo dos jogos, uns ficam
         pequenas, outros em tamanho bom") — usada só pra cortar a margem
         transparente do PNG do LOGO (SteamGridDB) depois do download (ver
         ArtworkService.TrimTransparentPadding). System.Drawing.Common é
         Windows-only desde o .NET 6, mas este projeto já é Windows-only de
         ponta a ponta (publish self-contained win-x64, System.Management,
         RTSS) — mesma categoria de dependência que já existe aqui. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

</Project>
