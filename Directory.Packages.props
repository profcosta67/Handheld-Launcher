<Project>
  <!-- Versões de todos os pacotes num lugar só (plano da v0.16: "fixar a
       versão do Avalonia e dos demais pacotes"). Os .csproj só dizem QUAIS
       pacotes usam; a versão vem daqui. Atualizar um pacote = mudar uma linha. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="AnimatedImage.Avalonia" Version="2.1.4" />
    <PackageVersion Include="AnimatedImage.Native" Version="2.1.2" />
    <PackageVersion Include="Avalonia" Version="11.2.8" />
    <PackageVersion Include="Avalonia.Desktop" Version="11.2.8" />
    <PackageVersion Include="Avalonia.Diagnostics" Version="11.2.8" />
    <PackageVersion Include="Avalonia.Fonts.Inter" Version="11.2.8" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="11.2.8" />
    <!-- v0.24: WebView nativo para a tela do Syncthing. Ficou MIT/FOSS a partir
         da 11.4.0 e a 11.4.1 exige apenas Avalonia >= 11.1.0 — ou seja, não
         obriga a subir o Avalonia e NÃO traz o CEF (~300 MB): no Windows usa o
         WebView2 que já vem com o Edge, no Linux o WPE/WebKitGTK do sistema. -->
    <PackageVersion Include="Avalonia.Controls.WebView" Version="11.4.1" />
    <PackageVersion Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- v0.18: só pro Guardião de suspensão (SystemEvents.PowerModeChanged)
         detectar quando o Windows acorda da suspensão. Pacote oficial da
         Microsoft, sem dependências nativas além das já usadas (user32). -->
    <PackageVersion Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageVersion Include="Nefarius.Drivers.HidHide" Version="3.4.0" />
    <PackageVersion Include="Nefarius.Utilities.DeviceManagement" Version="6.1.0" />
    <PackageVersion Include="SkiaSharp" Version="2.88.8" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.8" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="2.88.8" />
    <PackageVersion Include="System.Diagnostics.PerformanceCounter" Version="8.0.0" />
    <PackageVersion Include="System.Management" Version="10.0.2" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- v0.24.3-beta.6: o RyzenSmuService usa MutexSecurity/MutexAccessRule, mas
         o System.Threading.AccessControl só chegava de forma transitiva pelo
         LibreHardwareMonitorLib. Como essa referência passou a ser só-Windows
         (o pacote não tem runtime para linux-x64), o build net8.0 falhava com
         CS1069/CS0103. Fica declarado aqui explicitamente. -->
    <PackageVersion Include="System.Threading.AccessControl" Version="10.0.3" />
    <PackageVersion Include="Velopack" Version="1.2.161" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>